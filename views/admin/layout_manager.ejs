      { type: 'ad_slot', icon: 'fa-rectangle-ad', label: 'Article Ad Slot', desc: 'Bottom or inline ad banner', color: '#ca8a04' }
    ]
  };

  var CATEGORY_STYLES = [
    { key: 'featured_top', label: 'Lead + Side + 4 Row', icon: 'fa-table-cells-large' },
    { key: 'grid_3_col', label: '3-Col Broadsheet', icon: 'fa-table-columns' },
    { key: 'newspaper_4col', label: '4-Col Broadsheet', icon: 'fa-grip' },
    { key: 'big_first', label: 'Lead + Right Stack', icon: 'fa-list-check' },
    { key: 'grid_2_col', label: '2-Col Horizontal', icon: 'fa-pause' },
    { key: 'list_view', label: 'Chronological Wire', icon: 'fa-bars' }
  ];

  var HERO_STYLES = [
    { key: 'grid_3', label: '3-Col Front Page (Lead + Picks + Live Wire)' },
    { key: 'split_2', label: 'Dual Split Leads (2 Columns)' },
    { key: 'single_hero_banner', label: 'Single Widescreen Lead' }
  ];

  function pushHistory() {
    historyStack.push(JSON.stringify(blocks));
    if (historyStack.length > 20) historyStack.shift();
    var uBtn = document.getElementById('undoBtn');
    if (uBtn) uBtn.disabled = historyStack.length === 0;
  }

  function undoBlockChange() {
    if (historyStack.length === 0) return;
    var prev = JSON.parse(historyStack.pop());
    blocks = prev;
    blocksByPage[currentPage] = blocks;
    var uBtn = document.getElementById('undoBtn');
    if (uBtn) uBtn.disabled = historyStack.length === 0;
    renderAll();
    scheduleSave();
    showToast('<i class="fas fa-rotate-left"></i> Undid last change');
  }

  function renderLibrary() {
    var grid = document.getElementById('blockLibraryGrid');
    if (!grid) return;
    var list = BLOCK_CATALOG[currentPage] || BLOCK_CATALOG.home;
    grid.innerHTML = list.map(function(item) {
      return '<button type="button" class="lib-block-btn" onclick="addNewBlock(\'' + item.type + '\')">' +
        '<span class="lib-block-icon" style="background:' + item.color + '"><i class="fas ' + item.icon + '"></i></span>' +
        '<div><strong>+ ' + item.label + '</strong><span>' + item.desc + '</span></div>' +
      '</button>';
    }).join('');
  }

  function renderDeskCoverage() {
    var bar = document.getElementById('deskCoverageBar');
    var pillsEl = document.getElementById('deskCoveragePills');
    if (!bar || !pillsEl) return;
    if (currentPage !== 'home') {
      bar.style.display = 'none';
      return;
    }
    bar.style.display = 'flex';
    var html = '';
    var hasLiveWire = blocks.some(function(b) { return b.enabled && (b.type === 'hero' || b.type === 'today_wire'); });
    html += '<span class="cov-pill ' + (hasLiveWire ? 'is-covered' : 'is-missing') + '" ' +
      (!hasLiveWire ? 'onclick="addNewBlock(\'today_wire\')" title="Click to add Today Live Wire"' : '') + '>' +
      '<i class="fas ' + (hasLiveWire ? 'fa-check' : 'fa-plus') + '"></i> Today\'s Live Wire</span>';

    availableCategories.forEach(function(cat) {
      var covered = blocks.some(function(b) {
        return b.enabled && ((b.type === 'category' && Number(b.category_id) === Number(cat.id)) || b.type === 'multi_desk');
      });
      if (covered) {
        html += '<span class="cov-pill is-covered"><i class="fas fa-check"></i> ' + cat.name_en + '</span>';
      } else {
        html += '<span class="cov-pill is-missing" onclick="addDeskBlock(' + cat.id + ')" title="Click to add ' + cat.name_en + ' desk">' +
          '<i class="fas fa-plus"></i> Add ' + cat.name_en + '</span>';
      }
    });
    pillsEl.innerHTML = html;
  }

  function addDeskBlock(catId) {
    var cat = availableCategories.find(function(c) { return Number(c.id) === Number(catId); });
    if (!cat) return;
    pushHistory();
    blocks.push({
      id: 'b-cat-' + cat.slug + '-' + Date.now(),
      type: 'category',
      category_id: cat.id,
      title_km: cat.name_km,
      title_en: cat.name_en,
      style: 'grid_3_col',
      enabled: true,
      limit: 6
    });
    renderAll();
    scheduleSave();
    showToast('<i class="fas fa-plus"></i> Added ' + cat.name_en + ' Desk to Front Page');
  }

  function getCatalogMeta(type) {
    var all = [].concat(BLOCK_CATALOG.home, BLOCK_CATALOG.category, BLOCK_CATALOG.article);
    return all.find(function(x) { return x.type === type; }) || { label: type.toUpperCase(), desc: '', color: '#0f172a', icon: 'fa-cube' };
  }

  function renderBlocks() {
    var container = document.getElementById('blocksListContainer');
    var counter = document.getElementById('activeBlockCounter');
    if (!container) return;
    container.innerHTML = '';

    var activeCount = (blocks || []).filter(function(b) { return b.enabled; }).length;
    if (counter) counter.textContent = activeCount + ' of ' + (blocks ? blocks.length : 0) + ' sections visible';

    if (!blocks || blocks.length === 0) {
      container.innerHTML = '<div style="padding:32px;text-align:center;background:#fff;border:1px solid #cbd5e1;color:#64748b;">No sections configured yet. Click any block above or apply a 1-Click Preset!</div>';
      return;
    }

    blocks.forEach(function(block, idx) {
      var meta = getCatalogMeta(block.type);
      var card = document.createElement('div');
      card.className = 'block-card' + (!block.enabled ? ' is-hidden-block' : '') + (allCollapsed ? ' is-collapsed' : '');
      card.id = 'studioBlockCard_' + idx;
      card.draggable = true;
      card.setAttribute('data-index', idx);
      card.style.borderLeftColor = meta.color;

      card.addEventListener('dragstart', handleDragStart);
      card.addEventListener('dragover', handleDragOver);
      card.addEventListener('drop', handleDrop);
      card.addEventListener('dragend', handleDragEnd);

      var catName = '';
      if (block.type === 'category' && block.category_id) {
        var cObj = availableCategories.find(function(c) { return Number(c.id) === Number(block.category_id); });
        if (cObj) catName = ' • ' + cObj.name_en;
      }

      var html = '<div class="block-card-head">' +
        '<div class="block-card-title-group">' +
          '<span style="cursor:grab;color:#94a3b8;" title="Drag to reorder"><i class="fas fa-grip-vertical"></i></span>' +
          '<span class="block-step-num">' + String(idx + 1).padStart(2, '0') + '</span>' +
          '<span class="block-type-badge" style="background:' + meta.color + '18;color:' + meta.color + '"><i class="fas ' + meta.icon + '"></i> ' + meta.label + catName + '</span>' +
          '<strong style="font-size:0.95rem;color:#0f172a;">' + (block.title_en || block.title_km || meta.label) + '</strong>' +
          '<span style="font-size:0.78rem;color:#64748b;">(' + (block.title_km || '') + ')</span>' +
        '</div>' +
        '<div class="block-card-controls">' +
          '<button type="button" class="blk-btn" onclick="moveBlock(' + idx + ', -1)" ' + (idx === 0 ? 'disabled' : '') + ' title="Move Up"><i class="fas fa-arrow-up"></i></button>' +
          '<button type="button" class="blk-btn" onclick="moveBlock(' + idx + ', 1)" ' + (idx === blocks.length - 1 ? 'disabled' : '') + ' title="Move Down"><i class="fas fa-arrow-down"></i></button>' +
          '<button type="button" class="blk-btn" onclick="duplicateBlock(' + idx + ')" title="Duplicate Block"><i class="fas fa-copy"></i></button>' +
          '<button type="button" class="blk-btn ' + (block.enabled ? 'is-vis-on' : 'is-vis-off') + '" onclick="toggleBlock(' + idx + ')">' +
            (block.enabled ? '<i class="fas fa-eye"></i> Live' : '<i class="fas fa-eye-slash"></i> Hidden') +
          '</button>' +
          '<button type="button" class="blk-btn is-del" onclick="deleteBlock(' + idx + ')" title="Remove Section"><i class="fas fa-trash"></i></button>' +
        '</div>' +
      '</div>';

      html += '<div class="block-card-body"><div class="block-fields-grid">' +
        '<div><label>Section Heading (Khmer)</label><input type="text" value="' + (block.title_km || '').replace(/"/g, '&quot;') + '" oninput="updateBlock(' + idx + ', \'title_km\', this.value)"></div>' +
        '<div><label>Section Heading (English)</label><input type="text" value="' + (block.title_en || '').replace(/"/g, '&quot;') + '" oninput="updateBlock(' + idx + ', \'title_en\', this.value)"></div>';

      if (block.type === 'category') {
        var catOpts = availableCategories.map(function(c) {
          return '<option value="' + c.id + '" ' + (Number(block.category_id) === Number(c.id) ? 'selected' : '') + '>' + c.name_en + ' / ' + c.name_km + '</option>';
        }).join('');
        html += '<div><label>Editorial Desk Category</label><select onchange="updateBlock(' + idx + ', \'category_id\', parseInt(this.value,10)); renderAll();">' + catOpts + '</select></div>';
        html += '<div><label>Number of Dispatches</label><input type="number" min="2" max="18" value="' + (block.limit || 6) + '" onchange="updateBlock(' + idx + ', \'limit\', parseInt(this.value,10))"></div>';
      } else if (['today_wire', 'headlines', 'ticker', 'tags', 'opinion_desk', 'photo_journal', 'article_related'].indexOf(block.type) !== -1) {
        html += '<div><label>Items Count</label><input type="number" min="2" max="30" value="' + (block.limit || 6) + '" onchange="updateBlock(' + idx + ', \'limit\', parseInt(this.value,10))"></div>';
      } else if (block.type === 'ad_slot') {
        html += '<div><label>Ad Position Slot</label><select onchange="updateBlock(' + idx + ', \'position_slot\', this.value)">' +
          '<option value="homepage_mid_banner" ' + (block.position_slot === 'homepage_mid_banner' ? 'selected' : '') + '>Homepage Mid Banner</option>' +
          '<option value="homepage_bottom_banner" ' + (block.position_slot === 'homepage_bottom_banner' ? 'selected' : '') + '>Homepage Bottom Banner</option>' +
          '<option value="header_top" ' + (block.position_slot === 'header_top' ? 'selected' : '') + '>Header Top Banner</option>' +
        '</select></div>';
      }
      html += '</div>';

      // Visual Style Picker Buttons for Category & Hero
      if (block.type === 'category') {
        html += '<div style="font-size:0.74rem;font-weight:800;color:#475569;margin-top:4px;">Newspaper Column Arrangement:</div><div class="style-picker-row">';
        CATEGORY_STYLES.forEach(function(st) {
          var isAct = (block.style || 'grid_3_col') === st.key;
          html += '<button type="button" class="style-pill-btn ' + (isAct ? 'active' : '') + '" onclick="updateBlock(' + idx + ', \'style\', \'' + st.key + '\'); renderAll();">' +
            '<i class="fas ' + st.icon + '"></i> ' + st.label +
          '</button>';
        });
        html += '</div>';
      } else if (block.type === 'hero') {
        html += '<div style="font-size:0.74rem;font-weight:800;color:#475569;margin-top:4px;">Front Page Hero Architecture:</div><div class="style-picker-row">';
        HERO_STYLES.forEach(function(st) {
          var isAct = (block.style || 'grid_3') === st.key;
          html += '<button type="button" class="style-pill-btn ' + (isAct ? 'active' : '') + '" onclick="updateBlock(' + idx + ', \'style\', \'' + st.key + '\'); renderAll();">' +
            st.label +
          '</button>';
        });
        html += '</div>';
      }

      html += '</div>';
      card.innerHTML = html;
      container.appendChild(card);
    });
  }

  function renderBlueprint() {
    var stack = document.getElementById('blueprintStack');
    if (!stack) return;
    if (!blocks || blocks.length === 0) {
      stack.innerHTML = '<div style="padding:16px;text-align:center;font-size:0.75rem;color:#94a3b8;">Empty page</div>';
      return;
    }
    stack.innerHTML = blocks.map(function(b, idx) {
      var meta = getCatalogMeta(b.type);
      var bars = '<span style="background:' + meta.color + '"></span><span></span><span></span>';
      if (b.type === 'hero') bars = '<span style="flex:2;background:#1e3a8a"></span><span style="flex:1"></span><span style="flex:1;background:#dc2626"></span>';
      else if (b.type === 'today_wire' || b.type === 'ticker') bars = '<span style="background:#dc2626"></span>';
      else if (b.type === 'photo_journal') bars = '<span style="background:#0f172a"></span><span style="background:#0f172a"></span><span style="background:#0f172a"></span><span style="background:#0f172a"></span>';

      return '<div class="bp-item ' + (!b.enabled ? 'is-off' : '') + '" onclick="focusBlockCard(' + idx + ')">' +
        '<div class="bp-item-top">' +
          '<span>' + String(idx + 1).padStart(2, '0') + '. ' + (b.title_en || b.title_km || meta.label) + '</span>' +
          '<span style="color:' + (b.enabled ? '#16a34a' : '#94a3b8') + '">' + (b.enabled ? '●' : '○') + '</span>' +
        '</div>' +
        '<div class="bp-item-sub">' +
          '<span>' + meta.label + (b.style ? ' (' + b.style + ')' : '') + '</span>' +
          '<span>' + (b.limit ? b.limit + ' items' : '') + '</span>' +
        '</div>' +
        '<div class="bp-mini-bars">' + bars + '</div>' +
      '</div>';
    }).join('');
  }

  function focusBlockCard(idx) {
    var el = document.getElementById('studioBlockCard_' + idx);
    if (!el) return;
    el.classList.remove('is-collapsed');
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('highlight-flash');
    setTimeout(function() { el.classList.remove('highlight-flash'); }, 1400);
  }

  function renderAll() {
    renderLibrary();
    renderDeskCoverage();
    renderBlocks();
    renderBlueprint();
    renderCustomTemplates();
  }

  function toggleCollapseAll() {
    allCollapsed = !allCollapsed;
    var btn = document.getElementById('collapseAllBtn');
    if (btn) btn.innerHTML = allCollapsed ? '<i class="fas fa-expand-alt"></i> Expand All' : '<i class="fas fa-compress-alt"></i> Compact View';
    renderBlocks();
  }

  // Drag & Drop
  var dropBeforeIndex = null;
  function handleDragStart(e) {
    dragSrcIndex = parseInt(this.getAttribute('data-index'), 10);
    this.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', String(dragSrcIndex));
  }
  function clearDropMarks() {
    document.querySelectorAll('.block-card').forEach(function(c) {
      c.classList.remove('drop-before', 'drop-after', 'dragging');
    });
    dropBeforeIndex = null;
  }
  function handleDragOver(e) {
    if (e.preventDefault) e.preventDefault();
    var card = e.target.closest ? e.target.closest('.block-card') : null;
    if (!card || dragSrcIndex === null) return false;
    var idx = parseInt(card.getAttribute('data-index'), 10);
    var rect = card.getBoundingClientRect();
    var before = e.clientY < rect.top + rect.height / 2;
    clearDropMarks();
    card.classList.add(before ? 'drop-before' : 'drop-after');
    dropBeforeIndex = before ? idx : idx + 1;
    return false;
  }
  function handleDrop(e) {
    if (e.stopPropagation) e.stopPropagation();
    var target = dropBeforeIndex;
    if (dragSrcIndex !== null && target !== null && dragSrcIndex !== target) {
      pushHistory();
      var item = blocks.splice(dragSrcIndex, 1)[0];
      if (dragSrcIndex < target) target--;
      blocks.splice(target, 0, item);
      renderAll();
      scheduleSave();
      showToast('⇅ Section reordered & auto-saved');
    }
    clearDropMarks();
    return false;
  }
  function handleDragEnd() { clearDropMarks(); }

  function moveBlock(idx, dir) {
    var newIdx = idx + dir;
    if (newIdx < 0 || newIdx >= blocks.length) return;
    pushHistory();
    var temp = blocks[idx];
    blocks[idx] = blocks[newIdx];
    blocks[newIdx] = temp;
    renderAll();
    scheduleSave();
  }

  function duplicateBlock(idx) {
    pushHistory();
    var copy = JSON.parse(JSON.stringify(blocks[idx]));
    copy.id = 'block-' + Date.now();
    blocks.splice(idx + 1, 0, copy);
    renderAll();
    scheduleSave();
    showToast('<i class="fas fa-copy"></i> Section duplicated');
  }

  function toggleBlock(idx) {
    pushHistory();
    blocks[idx].enabled = !blocks[idx].enabled;
    renderAll();
    scheduleSave();
    showToast(blocks[idx].enabled ? '<i class="fas fa-eye"></i> Section enabled' : '<i class="fas fa-eye-slash"></i> Section hidden');
  }

  function deleteBlock(idx) {
    pushHistory();
    blocks.splice(idx, 1);
    renderAll();
    scheduleSave();
    showToast('<i class="fas fa-trash"></i> Section removed (Click Undo to restore)');
  }

  function updateBlock(idx, key, val) {
    blocks[idx][key] = val;
    renderBlueprint();
    renderDeskCoverage();
    scheduleSave();
  }

  function buildNewBlock(type) {
    var defaultTitles = {
      hero: { km: 'ព័ត៌មានលេចធ្លោប្រចាំថ្ងៃ', en: 'Front Page Lead & Live Wire' },
      today_wire: { km: 'ព័ត៌មានថ្មីៗទាន់ហេតុការណ៍ថ្ងៃនេះ', en: "Today's Live News Wire" },
      ticker: { km: 'ព័ត៌មានទាន់ហេតុការណ៍ថ្ងៃនេះ', en: "Today's Live Wire" },
      spotlight: { km: 'បទវិភាគស៊ីជម្រៅប្រចាំថ្ងៃ', en: 'In-Depth Editorial Spotlight' },
      category: { km: 'ព័ត៌មានជាតិ', en: 'National News' },
      multi_desk: { km: 'ទិដ្ឋភាពរួមតាមផ្នែកព័ត៌មាន', en: 'Across The Editorial Desks' },
      opinion_desk: { km: 'បទវិភាគ និងទស្សនៈនិពន្ធនាយក', en: 'Editorial Analysis & Perspectives' },
      photo_journal: { km: 'កម្រងរូបភាពព័ត៌មានប្រចាំថ្ងៃ', en: 'In Pictures: Photojournalism Desk' },
      headlines: { km: 'កំពូលព័ត៌មានពេញនិយមទាំង ១០', en: 'Top 10 Most Read Briefings' },
      tags: { km: 'ប្រធានបទកំពុងពេញនិយម', en: 'Trending Topics & Desks' },
      stats: { km: 'ស្ថិតិបន្ទប់ព័ត៌មាន', en: 'Newsroom Metrics' },
      newsletter: { km: 'ព្រឹត្តិបត្រព័ត៌មានប្រចាំថ្ងៃ', en: 'Daily Editorial Briefing' },
      ad_slot: { km: 'ផ្ទាំងពាណិជ្ជកម្ម', en: 'Advertisement' },
      article_comments: { km: 'មតិយោបល់អ្នកអាន', en: 'Reader Discussion' },
      article_related: { km: 'អត្ថបទពាក់ព័ន្ធ', en: 'More Coverage From This Desk' }
    };
    var nb = {
      id: 'block-' + Date.now(),
      type: type,
      title_km: (defaultTitles[type] && defaultTitles[type].km) || 'ផ្នែកថ្មី',
      title_en: (defaultTitles[type] && defaultTitles[type].en) || 'New Section',
      enabled: true,
      limit: type === 'headlines' ? 10 : (type === 'tags' ? 20 : (type === 'photo_journal' || type === 'opinion_desk' ? 4 : 6)),
      style: type === 'category' ? 'grid_3_col' : (type === 'hero' ? 'grid_3' : '')
    };
    if (type === 'category' && availableCategories.length > 0) {
      nb.category_id = availableCategories[0].id;
    }
    if (type === 'ad_slot') {
      nb.position_slot = currentPage === 'article' ? 'article_bottom' : 'homepage_mid_banner';
