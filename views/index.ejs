<% if (typeof homepageBlocks !=='undefined' && homepageBlocks && homepageBlocks.length> 0) { %>
  <!-- DYNAMIC MODULAR HOMEPAGE ENGINE -->
  <% homepageBlocks.forEach(function(block) { %>
    <% if (block.enabled) { %>

      <!-- BLOCK TYPE: HERO SHOWCASE -->
      <% if (block.type==='hero' ) { %>
        <section class="hero-section block-section block-hero">
          <div class="container">
            <% var heroStyle=block.style || (typeof siteSettings !=='undefined' && siteSettings &&
              siteSettings.hero_layout_style) || 'grid_3' ; %>

              <% if (heroStyle==='single_hero_banner' && featured && featured.length> 0) { %>
                <div style="margin-bottom: 24px;">
                  <a href="/article/<%= featured[0].slug %>" class="hero-main" style="height: 460px;">
                    <img src="<%= featured[0].image_url %>" alt="<%= featured[0][`title_${lang}`] %>">
                    <div class="hero-overlay"
                      style="padding: 40px; background: linear-gradient(to top, rgba(0,0,0,0.95), rgba(0,0,0,0.2));">
                      <span class="hero-category badge-cat-<%= featured[0].category_slug %>">
                        <%= featured[0][`category_name_${lang}`] %>
                      </span>
                      <h1 class="hero-title" style="font-size: 2.2rem; line-height: 1.3; margin-top: 12px;">
                        <%= featured[0][`title_${lang}`] %>
                      </h1>
                      <div
                        style="display: flex; gap: 16px; align-items: center; margin-top: 12px; color: rgba(255,255,255,0.85); font-size: 0.9rem;">
                        <span><i class="fas fa-calendar-days"></i> <%= new Date(featured[0].created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US'
                            , { weekday: 'long' , year: 'numeric' , month: 'long' , day: 'numeric' }) %></span>
                        <span><i class="fas fa-stopwatch"></i> <%= featured[0].read_time_minutes || 3 %>
                            <%= lang==='km' ? 'នាទីអាន' : 'min read' %></span>
                        <span><i class="fas fa-eye"></i> <%= featured[0].views_count || 120 %>
                            <%= lang==='km' ? 'ការទស្សនា' : 'views' %></span>
                      </div>
                    </div>
                  </a>
                </div>

                <% } else if (heroStyle==='split_2' && featured && featured.length> 0) { %>
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;"
                    class="split-hero-grid">
                    <% featured.slice(0, 2).forEach(function(f) { %>
                      <a href="/article/<%= f.slug %>" class="hero-main" style="height: 380px;">
                        <img src="<%= f.image_url %>" alt="<%= f[`title_${lang}`] %>">
                        <div class="hero-overlay" style="padding: 28px;">
                          <span class="hero-category badge-cat-<%= f.category_slug %>">
                            <%= f[`category_name_${lang}`] %>
                          </span>
                          <h2 class="hero-title" style="font-size: 1.5rem; line-height: 1.3; margin-top: 8px;">
                            <%= f[`title_${lang}`] %>
                          </h2>
                          <span class="hero-meta" style="margin-top: 8px; font-size: 0.85rem;"><i class="fas fa-calendar-days"></i> <%= new
                              Date(f.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , { year: 'numeric'
                              , month: 'short' , day: 'numeric' }) %></span>
                        </div>
                      </a>
                      <% }) %>
                  </div>

                  <% } else if (heroStyle==='carousel' && featured && featured.length> 0) { %>
                    <div class="hero-carousel" data-carousel>
                      <div class="carousel-track">
                        <% featured.forEach(function(f, fi) { %>
                          <div class="carousel-slide <%= fi === 0 ? 'active' : '' %>">
                            <a href="/article/<%= f.slug %>" class="carousel-slide-link">
                              <img src="<%= f.image_url %>" alt="<%= f[`title_${lang}`] %>">
                              <div class="carousel-overlay">
                                <span class="hero-category badge-cat-<%= f.category_slug %>">
                                  <%= f[`category_name_${lang}`] %>
                                </span>
                                <h2 class="carousel-title">
                                  <%= f[`title_${lang}`] %>
                                </h2>
                                <span class="carousel-meta"><i class="fas fa-calendar-days"></i> <%= new
                                    Date(f.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                    year: 'numeric' , month: 'short' , day: 'numeric' }) %> &bull; <i class="fas fa-stopwatch"></i> <%= f.read_time_minutes || 3
                                    %>
                                    <%= lang==='km' ? 'នាទីអាន' : 'min read' %></span>
                              </div>
                            </a>
                          </div>
                          <% }) %>
                      </div>
                      <button class="carousel-nav carousel-prev" data-carousel-prev aria-label="Previous">&#8249;</button>
                      <button class="carousel-nav carousel-next" data-carousel-next aria-label="Next">&#8250;</button>
                      <div class="carousel-dots" data-carousel-dots>
                        <% featured.forEach(function(f, fi) { %>
                          <button class="carousel-dot <%= fi === 0 ? 'active' : '' %>" data-carousel-dot="<%= fi %>"
                            aria-label="Slide <%= fi + 1 %>"></button>
                          <% }) %>
                      </div>
                    </div>

                    <% } else if (heroStyle==='mosaic' && featured && featured.length> 0) { %>
                    <div class="hero-mosaic">
                      <% if (featured.length > 0) { %>
                        <a href="/article/<%= featured[0].slug %>" class="hero-mosaic-tall">
                          <img src="<%= featured[0].image_url %>" alt="<%= featured[0][`title_${lang}`] %>">
                          <div class="hero-overlay" style="padding: 26px;">
                            <span class="hero-category badge-cat-<%= featured[0].category_slug %>">
                              <%= featured[0][`category_name_${lang}`] %>
                            </span>
                            <h2 class="hero-title" style="font-size: 1.5rem; line-height: 1.3; margin-top: 10px;">
                              <%= featured[0][`title_${lang}`] %>
                            </h2>
                            <span class="hero-meta" style="margin-top: 8px; font-size: 0.85rem;"><i class="fas fa-calendar-days"></i> <%= new
                                Date(featured[0].created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                year: 'numeric' , month: 'short' , day: 'numeric' }) %></span>
                          </div>
                        </a>
                        <% } %>
                        <div class="hero-mosaic-col">
                          <% if (featured.length > 1) { %>
                            <a href="/article/<%= featured[1].slug %>" class="hero-mosaic-wide">
                              <img src="<%= featured[1].image_url %>" alt="<%= featured[1][`title_${lang}`] %>">
                              <div class="hero-overlay" style="padding: 20px;">
                                <span class="hero-category badge-cat-<%= featured[1].category_slug %>">
                                  <%= featured[1][`category_name_${lang}`] %>
                                </span>
                                <h3 style="font-size: 1.15rem; line-height: 1.3; margin-top: 6px; color: #fff;">
                                  <%= featured[1][`title_${lang}`] %>
                                </h3>
                              </div>
                            </a>
                            <% } %>
                            <div class="hero-mosaic-minis">
                              <% featured.slice(2, 4).forEach(function(f) { %>
                                <a href="/article/<%= f.slug %>" class="hero-mosaic-mini">
                                  <img src="<%= f.image_url %>" alt="<%= f[`title_${lang}`] %>">
                                  <span class="hero-mini-title"><%= f[`title_${lang}`] %></span>
                                </a>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <% } else if (heroStyle==='hero_2x2' && featured && featured.length> 0) { %>
                    <div class="hero-2x2">
                      <% featured.slice(0, 4).forEach(function(f) { %>
                        <a href="/article/<%= f.slug %>" class="hero-2x2-card">
                          <img src="<%= f.image_url %>" alt="<%= f[`title_${lang}`] %>">
                          <div class="hero-overlay" style="padding: 22px;">
                            <span class="hero-category badge-cat-<%= f.category_slug %>">
                              <%= f[`category_name_${lang}`] %>
                            </span>
                            <h3 style="font-size: 1.2rem; line-height: 1.3; margin-top: 8px; color: #fff;">
                              <%= f[`title_${lang}`] %>
                            </h3>
                            <span class="hero-meta" style="margin-top: 6px; font-size: 0.8rem;"><i class="fas fa-calendar-days"></i> <%= new
                                Date(f.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , { year:
                                'numeric' , month: 'short' , day: 'numeric' }) %></span>
                          </div>
                        </a>
                        <% }) %>
                    </div>

                    <% } else { %>
                    <div class="hero-grid">
                      <% if (featured && featured.length> 0) { %>
                        <a href="/article/<%= featured[0].slug %>" class="hero-main">
                          <img src="<%= featured[0].image_url %>" alt="<%= featured[0][`title_${lang}`] %>">
                          <div class="hero-overlay">
                            <span class="hero-category badge-cat-<%= featured[0].category_slug %>">
                              <%= featured[0][`category_name_${lang}`] %>
                            </span>
                            <h2 class="hero-title">
                              <%= featured[0][`title_${lang}`] %>
                            </h2>
                            <span class="hero-meta"><i class="fas fa-calendar-days"></i> <%= new
                                Date(featured[0].created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                weekday: 'long' , year: 'numeric' , month: 'long' , day: 'numeric' }) %></span>
                          </div>
                        </a>
                        <% } %>
                          <div class="hero-side">
                            <% if (featured && featured.length> 1) { %>
                              <% featured.slice(1, 3).forEach(function(f) { %>
                                <a href="/article/<%= f.slug %>" class="hero-side-card">
                                  <img src="<%= f.image_url %>" alt="<%= f[`title_${lang}`] %>">
                                  <div class="hero-side-overlay">
                                    <span class="hero-category badge-cat-<%= f.category_slug %>">
                                      <%= f[`category_name_${lang}`] %>
                                    </span>
                                    <h3 class="hero-side-title">
                                      <%= f[`title_${lang}`] %>
                                    </h3>
                                  </div>
                                </a>
                                <% }) %>
                                  <% } %>
                          </div>
                    </div>
                    <% } %>
          </div>
        </section>

        <!-- BLOCK TYPE: SPOTLIGHT ARTICLE -->
        <% } else if (block.type==='spotlight' && articles && articles.length> 0) { %>
          <section class="section block-section block-spotlight">
            <div class="container">
              <div class="section-header">
                <h2 class="section-title">
                  <%= lang==='km' ? (block.title_km || 'ព័ត៌មានសំខាន់ប្រចាំថ្ងៃ' ) : (block.title_en
                    || 'Top Daily Spotlight' ) %>
                </h2>
              </div>
              <% var spotlight=articles[0]; %>
                <article class="card-template-wide">
                  <a href="/article/<%= spotlight.slug %>" class="card-img-link">
                    <img src="<%= spotlight.image_url %>" alt="<%= spotlight[`title_${lang}`] %>" class="card-img">
                  </a>
                  <div class="article-card-body">
                    <div class="article-card-meta">
                      <span class="article-card-category badge-cat-<%= spotlight.category_slug %>">
                        <%= spotlight[`category_name_${lang}`] %>
                      </span>
                      <span class="article-card-date">&bull; <%= new
                          Date(spotlight.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                          year: 'numeric' , month: 'short' , day: 'numeric' }) %></span>
                      <span class="article-card-views">&bull; <i class="fas fa-eye"></i> <%= spotlight.views_count || 120 %></span>
                    </div>
                    <h3 class="article-card-title">
                      <a href="/article/<%= spotlight.slug %>">
                        <%= spotlight[`title_${lang}`] %>
                      </a>
                    </h3>
                    <p class="article-card-excerpt">
                      <%= spotlight[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 200) %>...
                    </p>
                    <div class="article-card-footer">
                      <a href="/article/<%= spotlight.slug %>" class="read-more">
                        <%= t('common.read_more') %> &rarr;
                      </a>
                      <span class="read-time"><i class="fas fa-stopwatch"></i> <%= spotlight.read_time_minutes || 3 %> min read</span>
                    </div>
                  </div>
                </article>
            </div>
          </section>

          <!-- BLOCK TYPE: CATEGORY NEWS GRID -->
          <% } else if (block.type==='category' ) { %>
            <% var catArticles=(articlesByCat && block.category_id && articlesByCat[block.category_id]) ?
              articlesByCat[block.category_id] : (articles || []).slice(0, block.limit || 6); %>
              <% if (catArticles && catArticles.length> 0) { %>
                <section class="section block-section block-category">
                  <div class="container">
                    <div class="section-header">
                      <h2 class="section-title">
                        <%= lang==='km' ? (block.title_km || 'ព័ត៌មាន' ) : (block.title_en || 'Category News' ) %>
                      </h2>
                    </div>

                    <% if (block.style==='grid_3_col' ) { %>
                      <div class="grid grid-cols-3 gap-6" style="margin-bottom: 24px;">
                        <% catArticles.slice(0, block.limit || 6).forEach(function(a) { %>
                          <article class="card-template-standard">
                            <a href="/article/<%= a.slug %>">
                              <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>" class="article-card-img">
                            </a>
                            <div class="article-card-body">
                              <div class="article-card-meta">
                                <span class="article-card-category badge-cat-<%= a.category_slug %>">
                                  <%= a[`category_name_${lang}`] %>
                                </span>
                                <span class="article-card-date">&bull; <%= new
                                    Date(a.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                    year: 'numeric' , month: 'short' , day: 'numeric' }) %></span>
                              </div>
                              <h3 class="article-card-title">
                                <a href="/article/<%= a.slug %>">
                                  <%= a[`title_${lang}`] %>
                                </a>
                              </h3>
                              <p class="article-card-excerpt">
                                <%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 95) %>...
                              </p>
                              <div class="article-card-footer">
                                <a href="/article/<%= a.slug %>" class="read-more">
                                  <%= t('common.read_more') %> &rarr;
                                </a>
                              </div>
                            </div>
                          </article>
                          <% }) %>
                      </div>

                      <% } else if (block.style==='list_view' ) { %>
                        <div class="grid grid-cols-1 gap-4" style="margin-bottom: 24px;">
                          <% catArticles.slice(0, block.limit || 4).forEach(function(a) { %>
                            <article class="card-template-minimal">
                              <div class="article-card-body">
                                <div class="article-card-meta">
                                  <span class="article-card-category badge-cat-<%= a.category_slug %>">
                                    <%= a[`category_name_${lang}`] %>
                                  </span>
                                  <span class="article-card-date">&bull; <%= new
                                      Date(a.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                      year: 'numeric' , month: 'short' , day: 'numeric' }) %></span>
                                </div>
                                <h3 class="article-card-title">
                                  <a href="/article/<%= a.slug %>">
                                    <%= a[`title_${lang}`] %>
                                  </a>
                                </h3>
                                <p class="article-card-excerpt" style="-webkit-line-clamp: 2;">
                                  <%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 160) %>...
                                </p>
                              </div>
                            </article>
                            <% }) %>
                        </div>

                        <% } else if (block.style==='featured_top' ) { %>
                          <!-- Featured Top: 1 wide story + grid below -->
                          <% var featList=catArticles.slice(0, block.limit || 7); %>
                          <% if (featList.length > 0) { %>
                            <a href="/article/<%= featList[0].slug %>" class="hero-main"
                              style="height: 330px; margin-bottom: 20px;">
                              <img src="<%= featList[0].image_url %>" alt="<%= featList[0][`title_${lang}`] %>">
                              <div class="hero-overlay" style="padding: 30px;">
                                <span class="hero-category badge-cat-<%= featList[0].category_slug %>">
                                  <%= featList[0][`category_name_${lang}`] %>
                                </span>
                                <h3 style="font-size: 1.65rem; line-height: 1.35; margin-top: 10px; color: #ffffff;">
                                  <%= featList[0][`title_${lang}`] %>
                                </h3>
                                <p class="article-card-excerpt"
                                  style="color: rgba(255,255,255,0.85); margin-top: 8px; font-size: 0.95rem; -webkit-line-clamp: 2;">
                                  <%= featList[0][`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 160) %>...
                                </p>
                              </div>
                            </a>
                            <div class="grid grid-cols-2 gap-6" style="margin-bottom: 24px;">
                              <% featList.slice(1).forEach(function(a) { %>
                                <article class="card-template-standard">
                                  <a href="/article/<%= a.slug %>">
                                    <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>"
                                      class="article-card-img">
                                  </a>
                                  <div class="article-card-body">
                                    <div class="article-card-meta">
                                      <span class="article-card-category badge-cat-<%= a.category_slug %>">
                                        <%= a[`category_name_${lang}`] %>
                                      </span>
                                      <span class="article-card-date">&bull; <%= new
                                          Date(a.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                          year: 'numeric' , month: 'short' , day: 'numeric' }) %></span>
                                    </div>
                                    <h3 class="article-card-title">
                                      <a href="/article/<%= a.slug %>">
                                        <%= a[`title_${lang}`] %>
                                      </a>
                                    </h3>
                                    <p class="article-card-excerpt">
                                      <%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 110) %>...
                                    </p>
                                    <div class="article-card-footer">
                                      <a href="/article/<%= a.slug %>" class="read-more">
                                        <%= t('common.read_more') %> &rarr;
                                      </a>
                                    </div>
                                  </div>
                                </article>
                                <% }) %>
                            </div>
                            <% } %>
                        <% } else if (block.style==='big_first' ) { %>
                          <!-- Big First: 1 wide horizontal feature + compact rows below -->
                          <% var bigList=catArticles.slice(0, block.limit || 5); %>
                          <% if (bigList.length > 0) { %>
                            <article class="card-template-wide" style="margin-bottom: 18px;">
                              <a href="/article/<%= bigList[0].slug %>" class="card-img-link">
                                <img src="<%= bigList[0].image_url %>" alt="<%= bigList[0][`title_${lang}`] %>"
                                  class="card-img">
                              </a>
                              <div class="article-card-body">
                                <div class="article-card-meta">
                                  <span class="article-card-category badge-cat-<%= bigList[0].category_slug %>">
                                    <%= bigList[0][`category_name_${lang}`] %>
                                  </span>
                                  <span class="article-card-date">&bull; <i class="fas fa-calendar-days"></i> <%= new
                                      Date(bigList[0].created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US'
                                      , { year: 'numeric' , month: 'short' , day: 'numeric' }) %></span>
                                </div>
                                <h3 class="article-card-title">
                                  <a href="/article/<%= bigList[0].slug %>">
                                    <%= bigList[0][`title_${lang}`] %>
                                  </a>
                                </h3>
                                <p class="article-card-excerpt">
                                  <%= bigList[0][`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 180) %>...
                                </p>
                              </div>
                            </article>
                            <div class="big-first-rows">
                              <% bigList.slice(1).forEach(function(a) { %>
                                <a href="/article/<%= a.slug %>" class="big-first-row">
                                  <span class="big-first-thumb">
                                    <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>">
                                  </span>
                                  <span class="big-first-info">
                                    <span class="article-card-category badge-cat-<%= a.category_slug %>">
                                      <%= a[`category_name_${lang}`] %>
                                    </span>
                                    <span class="big-first-row-title"><%= a[`title_${lang}`] %></span>
                                    <span class="big-first-row-meta"><i class="fas fa-calendar-days"></i> <%= new
                                        Date(a.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                        year: 'numeric' , month: 'short' , day: 'numeric' }) %> &bull; <i class="fas fa-stopwatch"></i> <%= a.read_time_minutes
                                        || 3 %>
                                        <%= lang==='km' ? 'នាទីអាន' : 'min read' %></span>
                                  </span>
                                </a>
                                <% }) %>
                            </div>
                            <% } %>

                        <% } else if (block.style==='horizontal_scroll' ) { %>
                          <!-- Horizontal Scroll: swipeable strip of compact cards -->
                          <div class="hscroll-wrap" data-hscroll>
                            <button type="button" class="hscroll-arrow hscroll-prev" data-hscroll-prev
                              aria-label="Previous">&#8249;</button>
                            <div class="hscroll-track" data-hscroll-track>
                              <% catArticles.slice(0, block.limit || 8).forEach(function(a) { %>
                                <article class="card-template-standard hscroll-card">
                                  <a href="/article/<%= a.slug %>">
                                    <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>"
                                      class="article-card-img">
                                  </a>
                                  <div class="article-card-body">
                                    <div class="article-card-meta">
                                      <span class="article-card-category badge-cat-<%= a.category_slug %>">
                                        <%= a[`category_name_${lang}`] %>
                                      </span>
                                    </div>
                                    <h3 class="article-card-title" style="-webkit-line-clamp: 3;">
                                      <a href="/article/<%= a.slug %>">
                                        <%= a[`title_${lang}`] %>
                                      </a>
                                    </h3>
                                  </div>
                                </article>
                                <% }) %>
                            </div>
                            <button type="button" class="hscroll-arrow hscroll-next" data-hscroll-next
                              aria-label="Next">&#8250;</button>
                          </div>

                        <% } else if (block.style==='masonry' ) { %>
                          <!-- Masonry: mixed card heights for a magazine feel -->
                          <div class="masonry-grid">
                            <% catArticles.slice(0, block.limit || 6).forEach(function(a, mi) { %>
                              <article class="card-template-standard masonry-card <%= mi % 3 === 0 ? 'masonry-tall' :
                                (mi % 3 === 1 ? 'masonry-wide' : '') %>">
                                <a href="/article/<%= a.slug %>">
                                  <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>"
                                    class="article-card-img">
                                </a>
                                <div class="article-card-body">
                                  <div class="article-card-meta">
                                    <span class="article-card-category badge-cat-<%= a.category_slug %>">
                                      <%= a[`category_name_${lang}`] %>
                                    </span>
                                    <span class="article-card-date">&bull; <i class="fas fa-calendar-days"></i> <%= new
                                        Date(a.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                        year: 'numeric' , month: 'short' , day: 'numeric' }) %></span>
                                  </div>
                                  <h3 class="article-card-title">
                                    <a href="/article/<%= a.slug %>">
                                      <%= a[`title_${lang}`] %>
                                    </a>
                                  </h3>
                                  <p class="article-card-excerpt">
                                    <%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 120) %>...
                                  </p>
                                </div>
                              </article>
                              <% }) %>
                          </div>

                        <% } else { %>
                          <!-- Default 2-Col Grid -->
                          <div class="grid grid-cols-2 gap-6" style="margin-bottom: 24px;">
                            <% catArticles.slice(0, block.limit || 4).forEach(function(a) { %>
                              <article class="card-template-standard">
                                <a href="/article/<%= a.slug %>">
                                  <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>"
                                    class="article-card-img">
                                </a>
                                <div class="article-card-body">
                                  <div class="article-card-meta">
                                    <span class="article-card-category badge-cat-<%= a.category_slug %>">
                                      <%= a[`category_name_${lang}`] %>
                                    </span>
                                    <span class="article-card-date">&bull; <%= new
                                        Date(a.created_at).toLocaleDateString(lang==='km' ? 'km-KH' : 'en-US' , {
                                        year: 'numeric' , month: 'short' , day: 'numeric' }) %></span>
                                  </div>
                                  <h3 class="article-card-title">
                                    <a href="/article/<%= a.slug %>">
                                      <%= a[`title_${lang}`] %>
                                    </a>
                                  </h3>
                                  <p class="article-card-excerpt">
                                    <%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 110) %>...
                                  </p>
                                  <div class="article-card-footer">
                                    <a href="/article/<%= a.slug %>" class="read-more">
                                      <%= t('common.read_more') %> &rarr;
                                    </a>
                                  </div>
                                </div>
                              </article>
                              <% }) %>
                          </div>
                          <% } %>
                  </div>
                </section>
                <% } %>

                  <!-- BLOCK TYPE: AD BANNER SLOT -->
                  <% } else if (block.type==='ad_slot' && typeof getAd==='function' ) { %>
                    <% var slotAd=getAd(block.position_slot || 'homepage_mid_banner' ); %>
                      <% if (slotAd) { %>
                        <div class="container block-section block-ad">
                          <div class="ad-container"
                            style="margin: 28px 0; text-align: center; overflow: hidden; border-radius: 8px;">
                            <% if (slotAd.ad_type==='html' && slotAd.html_code) { %>
                              <%- slotAd.html_code %>
                                <% } else { %>
                                  <a href="<%= slotAd.link_url || '#' %>" target="_blank"
                                    onclick="fetch('/api/ads/click/<%= slotAd.id %>', {method:'POST'})">
                                    <img src="<%= slotAd.image_url %>" alt="<%= slotAd.title %>"
                                      style="max-width: 100%; border-radius: 8px; max-height: 120px; object-fit: contain;">
                                  </a>
                                  <% } %>
                          </div>
                        </div>
                        <% } %>

                          <!-- BLOCK TYPE: LATEST HEADLINES TICKER -->
                          <% } else if (block.type==='ticker' && articles && articles.length> 0) { %>
                            <% var tickerStyle=block.style || ((typeof siteSettings !=='undefined' && siteSettings &&
                              siteSettings.ticker_style) || 'marquee' ) ; %>
                            <% var tickerItems=articles.slice(0, block.limit || 10); %>
                            <section class="section block-section block-ticker">
                              <div class="container">
                                <div class="ticker-box ticker-style-<%= tickerStyle %>" <%= tickerStyle === 'slide' ?
                                  'data-ticker-slide' : '' %>>
                                  <span class="ticker-label">
                                    <%= lang==='km' ? (block.title_km || 'ព័ត៌មានចុងក្រោយ' ) : (block.title_en
                                      || 'LATEST HEADLINES' ) %>
                                  </span>
                                  <% if (tickerStyle === 'static') { %>
                                    <div class="ticker-track ticker-static">
                                      <% tickerItems.forEach(function(a, ti) { %>
                                        <a class="ticker-text" href="/article/<%= a.slug %>">
                                          <%= a[`title_${lang}`] %></a>
                                        <% if (ti < tickerItems.length - 1) { %><span class="ticker-sep">•</span><% } %>
                                      <% }) %>
                                    </div>
                                  <% } else if (tickerStyle === 'slide') { %>
                                    <div class="ticker-track ticker-slide">
                                      <% tickerItems.forEach(function(a, si) { %>
                                        <a class="ticker-slide-item <%= si === 0 ? 'active' : '' %>"
                                          href="/article/<%= a.slug %>">
                                          <%= a[`title_${lang}`] %></a>
                                      <% }) %>
                                    </div>
                                  <% } else { %>
                                    <div class="ticker-track" data-ticker-track>
                                      <% for (var tg = 0; tg < 2; tg++) { %>
                                        <span class="ticker-text" <%= tg === 1 ? 'aria-hidden="true"' : '' %>>
                                          <% tickerItems.forEach(function(a, ti) { %>
                                            <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a><% if
                                              (ti < tickerItems.length - 1) { %> • <% } %>
                                          <% }) %> •
                                        </span>
                                      <% } %>
                                    </div>
                                  <% } %>
                                </div>
                              </div>
                            </section>

                            <!-- BLOCK TYPE: TOP HEADLINES NUMBERED LIST -->
                            <% } else if (block.type==='headlines' && articles && articles.length> 0) { %>
                              <section class="section block-section block-headlines">
                                <div class="container">
                                  <div class="section-header">
                                    <h2 class="section-title">
                                      <%= lang==='km' ? (block.title_km || 'កំពូលព័ត៌មាន' ) : (block.title_en
                                        || 'Top Headlines' ) %>
                                    </h2>
                                  </div>
                                  <ol class="headlines-list">
                                    <% (block.limit ? articles.slice(0, block.limit) : articles.slice(0, 10)).forEach(function(a,
                                      idx) { %>
                                      <li class="headlines-item">
                                        <span class="headlines-number"><%= idx + 1 %></span>
                                        <a href="/article/<%= a.slug %>" class="headlines-link">
                                          <%= a[`title_${lang}`] %>
                                        </a>
                                        <span class="headlines-cat badge-cat-<%= a.category_slug %>">
                                          <%= a[`category_name_${lang}`] %>
                                        </span>
                                      </li>
                                      <% }) %>
                                  </ol>
                                </div>
                              </section>

                              <!-- BLOCK TYPE: TAG CLOUD -->
                              <% } else if (block.type==='tags' && tags && tags.length> 0) { %>
                                <section class="section block-section block-tags">
                                  <div class="container">
                                    <div class="section-header">
                                      <h2 class="section-title">
                                        <%= lang==='km' ? (block.title_km || 'ស្លាកព័ត៌មានពេញនិយម' ) : (block.title_en
                                          || 'Popular Tags' ) %>
                                      </h2>
                                    </div>
                                    <div class="tag-cloud">
                                      <% tags.slice(0, block.limit || 20).forEach(function(tag) { %>
                                        <a href="/tag/<%= tag.slug %>" class="tag-chip">
                                          <%= tag[`name_${lang}`] %>
                                        </a>
                                        <% }) %>
                                    </div>
                                  </div>
                                </section>

                                <!-- BLOCK TYPE: SITE STATS STRIP -->
                                <% } else if (block.type==='stats' && articles) { %>
                                  <% var totalViews=articles.reduce(function(s, a) { return s + (a.views_count || 0); }, 0); %>
                                  <section class="section block-section block-stats">
                                    <div class="container">
                                      <div class="stats-strip">
                                        <div class="stats-item">
                                          <span class="stats-number"><%= articles.length.toLocaleString() %></span>
                                          <span class="stats-label"><%= lang==='km' ? 'អត្ថបទសរុប' : 'Total Articles' %></span>
                                        </div>
                                        <div class="stats-item">
                                          <span class="stats-number"><%= (typeof categories !== 'undefined' && categories) ? categories.length : 0 %></span>
                                          <span class="stats-label"><%= lang==='km' ? 'ប្រភេទព័ត៌មាន' : 'Categories' %></span>
                                        </div>
                                        <div class="stats-item">
                                          <span class="stats-number"><%= (typeof tags !== 'undefined' && tags) ? tags.length : 0 %></span>
                                          <span class="stats-label"><%= lang==='km' ? 'ស្លាកព័ត៌មាន' : 'Tags' %></span>
                                        </div>
                                        <div class="stats-item">
                                          <span class="stats-number"><%= totalViews.toLocaleString() %></span>
                                          <span class="stats-label"><%= lang==='km' ? 'ការទស្សនាសរុប' : 'Total Views' %></span>
                                        </div>
                                      </div>
                                    </div>
                                  </section>

                                <!-- BLOCK TYPE: NEWSLETTER CTA -->
                                <% } else if (block.type==='newsletter' ) { %>
                            <section class="section block-section block-newsletter"
                              style="background: linear-gradient(135deg, var(--primary-color, #1e3a8a), #0f172a); color: white; padding: 48px 0; margin: 32px 0;">
                              <div class="container" style="text-align: center; max-width: 680px;">
                                <h2 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 8px; color: white;">
                                  <%= lang==='km' ? (block.title_km || 'ជាវព័ត៌មានប្រចាំថ្ងៃ' ) : (block.title_en
                                    || 'Subscribe to Daily Newsletter' ) %>
                                </h2>
                                <p style="color: rgba(255,255,255,0.8); margin-bottom: 24px;">
                                  <%= lang==='km'
                                    ? 'ទទួលព័ត៌មានទាន់ហេតុការណ៍ និងព័ត៌មានសំខាន់ៗជារៀងរាល់ថ្ងៃតាមសារអេឡិចត្រូនិចរបស់អ្នក'
                                    : 'Get breaking news updates and daily highlights delivered straight to your inbox.'
                                    %>
                                </p>
                                <form class="js-newsletter-form" novalidate
                                  style="display: flex; gap: 12px; justify-content: center;">
                                  <input type="email" placeholder="<%= t('newsletter.placeholder') %>" required
                                    class="js-newsletter-input"
                                    style="padding: 12px 18px; border-radius: 30px; border: none; width: 320px; font-size: 0.95rem;">
                                  <button type="submit" class="js-newsletter-btn"
                                    style="background: var(--accent-color, #dc2626); color: white; border: none; padding: 12px 28px; border-radius: 30px; font-weight: 700; cursor: pointer; transition: transform 0.2s;">
                                    <%= t('newsletter.subscribe') %>
                                  </button>
                                </form>
                                <p class="js-newsletter-msg" style="display: none; margin-top: 12px; font-weight: 700; font-size: 0.9rem;"></p>
                              </div>
                            </section>
                            <% } %>

                              <% } %>
                                <% }) %>

                                  <% } else { %>
                                    <!-- FALLBACK DEFAULT HOMEPAGE -->
                                    <section class="hero-section">
                                      <div class="container">
                                        <div class="hero-grid">
                                          <% if (featured && featured.length> 0) { %>
                                            <a href="/article/<%= featured[0].slug %>" class="hero-main">
                                              <img src="<%= featured[0].image_url %>"
                                                alt="<%= featured[0][`title_${lang}`] %>">
                                              <div class="hero-overlay">
                                                <span class="hero-category badge-cat-<%= featured[0].category_slug %>">
                                                  <%= featured[0][`category_name_${lang}`] %>
                                                </span>
                                                <h2 class="hero-title">
                                                  <%= featured[0][`title_${lang}`] %>
                                                </h2>
                                              </div>
                                            </a>
                                            <% } %>
                                        </div>
                                      </div>
                                    </section>
                                    <% } %>