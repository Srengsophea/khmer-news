  .about-desk-latest {
    border-left: 2px solid var(--rule-light, #e2e8f0);
    padding-left: 20px;
  }
  .about-desk-latest-label {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
