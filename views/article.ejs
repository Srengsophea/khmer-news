<section class="section" style="padding: 32px 0;">
  <div class="container">
    <!-- Breadcrumb Bar -->
    <nav class="breadcrumb" style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; color: #64748b; margin-bottom: 24px; background: #ffffff; padding: 10px 16px; border-radius: 30px; border: 1px solid #e2e8f0; width: fit-content;">
      <a href="/" style="color: var(--primary-color, #1e3a8a); font-weight: 600;">🏠 <%= t('nav.home') %></a>
      <span>&rsaquo;</span>
      <a href="/category/<%= article.category_slug %>" style="color: var(--primary-color, #1e3a8a); font-weight: 600;"><%= article[`category_name_${lang}`] %></a>
      <span>&rsaquo;</span>
      <span style="color: #94a3b8; max-width: 400px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= article[`title_${lang}`] %></span>
    </nav>

    <div class="content-layout" style="display: grid; grid-template-columns: 2.5fr 1fr; gap: 32px;">
      <div class="main-column">
        <article class="article-detail" style="background: #ffffff; border-radius: 16px; padding: 36px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px -4px rgba(15,23,42,0.04);">
          <div class="article-header" style="margin-bottom: 24px;">
            <span class="article-category badge-cat-<%= article.category_slug %>" style="display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin-bottom: 12px;">
              <%= article[`category_name_${lang}`] %>
            </span>
            
            <h1 class="article-title" style="font-size: 2.2rem; font-weight: 800; color: #0f172a; line-height: 1.4; margin-bottom: 16px;">
              <%= article[`title_${lang}`] %>
            </h1>
            
            <div class="article-meta-row" style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding: 14px 0; border-top: 1px solid #f1f5f9; border-bottom: 1px solid #f1f5f9; font-size: 0.88rem; color: #475569;">
              <span style="display: flex; align-items: center; gap: 6px;">✍️ <strong><%= article.author_name || 'Khmer News Desk' %></strong></span>
              <span>&bull;</span>
              <span>📅 <%= new Date(article.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
              <span>&bull;</span>
              <span>⏱️ <%= article.read_time_minutes || 3 %> <%= lang === 'km' ? 'នាទីអាន' : 'min read' %></span>
              <span>&bull;</span>
              <span>👁️ <%= article.views_count || 120 %> <%= lang === 'km' ? 'ការទស្សនា' : 'views' %></span>
            </div>

            <!-- Social Share Bar -->
            <div class="share-toolbar" style="display: flex; align-items: center; gap: 12px; margin-top: 16px;">
              <span style="font-weight: 700; font-size: 0.85rem; color: #64748b;"><%= lang === 'km' ? 'ចែករំលែក៖' : 'Share:' %></span>
              <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('http://localhost:3000/article/' + article.slug) %>" target="_blank" class="share-btn share-fb" style="background: #1877f2; color: white; padding: 7px 18px; border-radius: 30px; font-size: 0.82rem; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 6px;">Facebook</a>
              <a href="https://t.me/share/url?url=<%= encodeURIComponent('http://localhost:3000/article/' + article.slug) %>&text=<%= encodeURIComponent(article[`title_${lang}`]) %>" target="_blank" class="share-btn share-tg" style="background: #229ed9; color: white; padding: 7px 18px; border-radius: 30px; font-size: 0.82rem; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 6px;">Telegram</a>
              <button type="button" onclick="navigator.clipboard.writeText(window.location.href); alert('<%= lang === 'km' ? 'បានចម្លងតំណភ្ជាប់!' : 'Link copied to clipboard!' %>');" class="share-btn share-copy" style="background: #f1f5f9; color: #1e293b; border: 1px solid #cbd5e1; padding: 7px 18px; border-radius: 30px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">📋 Copy Link</button>
            </div>
          </div>

          <!-- Featured Hero Image Frame -->
          <div style="border-radius: 12px; overflow: hidden; margin-bottom: 28px; border: 1px solid #e2e8f0; background: #f8fafc;">
            <img src="<%= article.image_url %>" alt="<%= article[`title_${lang}`] %>" class="article-hero-img" style="width: 100%; max-height: 480px; object-fit: cover;">
          </div>

          <div class="article-body">
            <div class="article-content" style="font-size: 1.12rem; line-height: 2.0; color: #1e293b;">
              <%- article[`content_${lang}`] %>
            </div>

            <!-- DYNAMIC AD SLOT: Inline Article Ad -->
            <% if (typeof getAd === 'function') { %>
              <% var inlineAd = getAd('article_inline') || getAd('inline'); %>
              <% if (inlineAd) { %>
                <div class="inline-ad-banner" style="margin: 36px 0; text-align: center; background: #f8fafc; padding: 12px; border-radius: 12px; border: 1px dashed #cbd5e1;">
                  <% if (inlineAd.ad_type === 'html' && inlineAd.html_code) { %>
                    <%- inlineAd.html_code %>
                  <% } else { %>
                    <a href="<%= inlineAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= inlineAd.id %>', {method:'POST'})">
                      <img src="<%= inlineAd.image_url %>" alt="<%= inlineAd.title %>" style="max-height: 140px; border-radius: 8px; width: 100%; object-fit: contain;">
                    </a>
                  <% } %>
                </div>
              <% } %>
            <% } %>

            <!-- DYNAMIC AD SLOT: Article Bottom Ad -->
            <% if (typeof getAd === 'function') { %>
              <% var bottomAd = getAd('article_bottom'); %>
              <% if (bottomAd) { %>
                <div class="article-bottom-ad" style="margin-top: 28px; text-align: center;">
                  <% if (bottomAd.ad_type === 'html' && bottomAd.html_code) { %>
                    <%- bottomAd.html_code %>
                  <% } else { %>
                    <a href="<%= bottomAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= bottomAd.id %>', {method:'POST'})">
                      <img src="<%= bottomAd.image_url %>" alt="<%= bottomAd.title %>" style="max-height: 120px; border-radius: 8px; border: 1px solid #e2e8f0; width: 100%; object-fit: contain;">
                    </a>
                  <% } %>
                </div>
              <% } %>
            <% } %>

          </div>
        </article>
      </div>

      <!-- SIDEBAR WIDGETS -->
      <aside class="sidebar" style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- SIDEBAR WIDGET 1: CATEGORIES LIST -->
        <div class="sidebar-widget" style="background: #ffffff; border-radius: 16px; padding: 24px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
          <h3 class="widget-title" style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 2px solid var(--accent-color, #dc2626);">
            📂 <%= t('admin.categories') %>
          </h3>
          <ul class="category-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(function(c) { %>
                <li class="category-item">
                  <a href="/category/<%= c.slug %>" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-radius: 8px; background: #f8fafc; color: #1e293b; font-weight: 600; text-decoration: none; transition: all 0.2s;">
                    <span style="display: flex; align-items: center; gap: 8px;">
                      <span>📰</span>
                      <span><%= c[`name_${lang}`] %></span>
                    </span>
                    <span style="font-size: 0.8rem; color: #94a3b8; background: #ffffff; padding: 2px 8px; border-radius: 12px; border: 1px solid #e2e8f0;">&rarr;</span>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </div>

        <!-- SIDEBAR WIDGET 2: TOP TRENDING STORIES -->
        <div class="sidebar-widget" style="background: #ffffff; border-radius: 16px; padding: 24px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
          <h3 class="widget-title" style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 2px solid var(--primary-color, #1e3a8a);">
            🔥 <%= lang === 'km' ? 'ព័ត៌មានពេញនិយម' : 'Trending Stories' %>
          </h3>
          <ul class="trending-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
            <% if (articles && articles.length > 0) { %>
              <% articles.slice(0, 5).forEach(function(a, idx) { %>
                <li class="trending-item" style="display: flex; gap: 12px; align-items: flex-start;">
                  <span class="trending-number" style="background: <%= idx === 0 ? '#b91c1c' : (idx === 1 ? '#d97706' : '#1e3a8a') %>; color: white; font-weight: 800; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; flex-shrink: 0;">
                    <%= idx + 1 %>
                  </span>
                  <span class="trending-title" style="font-size: 0.95rem; font-weight: 700; line-height: 1.4;">
                    <a href="/article/<%= a.slug %>" style="color: #0f172a; text-decoration: none;"><%= a[`title_${lang}`] %></a>
                  </span>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </div>

        <!-- DYNAMIC AD SLOT: Sidebar Ad Banner -->
        <% if (typeof getAd === 'function') { %>
          <% var sidebarAd = getAd('sidebar'); %>
          <% if (sidebarAd) { %>
            <div class="sidebar-widget ad-widget" style="padding: 12px; display: flex; justify-content: center; overflow: hidden; text-align: center; background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0;">
              <% if (sidebarAd.ad_type === 'html' && sidebarAd.html_code) { %>
                <%- sidebarAd.html_code %>
              <% } else { %>
                <a href="<%= sidebarAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= sidebarAd.id %>', {method:'POST'})">
                  <img src="<%= sidebarAd.image_url %>" alt="<%= sidebarAd.title %>" style="width: 100%; border-radius: 12px; border: 1px solid #e2e8f0; max-height: 280px; object-fit: cover;">
                </a>
              <% } %>
            </div>
          <% } %>
        <% } %>

      </aside>
    </div>
  </div>
</section>

<!-- RELATED ARTICLES SECTION -->
<section class="related-section" style="background: #f8fafc; padding: 48px 0; border-top: 1px solid #e2e8f0;">
  <div class="container">
    <div class="section-header" style="margin-bottom: 24px;">
      <h2 class="section-title" style="font-size: 1.5rem; font-weight: 800; color: #0f172a;"><%= lang === 'km' ? 'ព័ត៌មានទាក់ទង' : 'Related Articles' %></h2>
    </div>
    <div class="related-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
      <% if (articles && articles.length > 0) { %>
        <% articles.forEach(function(a) { %>
          <article class="card-template-standard" style="background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <a href="/article/<%= a.slug %>">
              <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>" class="article-card-img" style="width: 100%; height: 180px; object-fit: cover;">
            </a>
            <div class="article-card-body" style="padding: 16px;">
              <div class="article-card-meta" style="margin-bottom: 8px; font-size: 0.8rem; color: #64748b;">
                <span class="article-card-category badge-cat-<%= a.category_slug %>" style="padding: 2px 8px; border-radius: 12px; font-weight: 700;"><%= a[`category_name_${lang}`] %></span>
                <span>&bull; <%= new Date(a.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
              </div>
              <h3 class="article-card-title" style="font-size: 1rem; font-weight: 700; line-height: 1.4; margin-bottom: 12px;">
                <a href="/article/<%= a.slug %>" style="color: #0f172a; text-decoration: none;"><%= a[`title_${lang}`] %></a>
              </h3>
              <div class="article-card-footer">
                <a href="/article/<%= a.slug %>" class="read-more" style="color: var(--primary-color, #1e3a8a); font-weight: 700; font-size: 0.85rem;"><%= t('common.read_more') %> &rarr;</a>
              </div>
            </div>
          </article>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>

<script>
  window.addEventListener('scroll', function() {
    var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    var scrolled = (winScroll / height) * 100;
    var bar = document.getElementById('readingProgress');
    if (bar) {
      bar.style.width = scrolled + '%';
    }
  });
</script>
