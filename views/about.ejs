    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink, #0f172a);
    margin-bottom: 8px;
  }
  .about-desk-desc {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-soft, #334155);
    margin: 0 0 12px;
  }
  .about-desk-beats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .about-beat-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 9px;
