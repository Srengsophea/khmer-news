        <div id="themeOverrideNotice" style="display: none; margin-top: 14px; background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 8px; padding: 10px 12px; font-size: 0.82rem; line-height: 1.5;"></div>
