        </div>
        <div>
          <label style="display: block; font-weight: 600; margin-bottom: 6px;">Ticker Text (English)</label>
          <input type="text" name="breaking_news_text_en" value="<%= settings.breaking_news_text_en || '' %>" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 6px;">
