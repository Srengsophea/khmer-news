  }
  .about-timeline-title {
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink, #0f172a);
    margin: 0 0 14px;
  }
  .about-timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--ink, #0f172a);
    padding-left: 18px;
