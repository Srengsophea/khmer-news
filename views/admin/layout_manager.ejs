          <option value="static" <%= settings.ticker_style === 'static' ? 'selected' : '' %>>Static List (no animation)</option>
          <option value="slide" <%= settings.ticker_style === 'slide' ? 'selected' : '' %>>Slide (auto-rotating headline)</option>
        </select>
        <p style="font-size: 0.8rem; color: #94a3b8; margin-top: 6px;">Applies to all "Latest Headlines" ticker blocks on the homepage.</p>
