  // HTML5 Drag and Drop handlers with visual top/bottom drop indicators
  var dropBeforeIndex = null;

  function handleDragStart(e) {
    dragSrcIndex = parseInt(this.getAttribute('data-index'));
    this.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', String(dragSrcIndex));
  }
  function clearDropMarks() {
    document.querySelectorAll('.block-card').forEach(function (c) {
      c.classList.remove('drop-before', 'drop-after', 'drag-over', 'dragging');
    });
    dropBeforeIndex = null;
  }
  function handleDragOver(e) {
    if (e.preventDefault) e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    var card = e.target.closest ? e.target.closest('.block-card') : null;
    if (!card || dragSrcIndex === null) return false;
    var idx = parseInt(card.getAttribute('data-index'));
    var rect = card.getBoundingClientRect();
    var before = e.clientY < rect.top + rect.height / 2;
    clearDropMarks();
    card.classList.add(before ? 'drop-before' : 'drop-after');
    dropBeforeIndex = before ? idx : idx + 1;
    return false;
  }
  function handleDrop(e) {
    if (e.stopPropagation) e.stopPropagation();
    var target = dropBeforeIndex;
    if (dragSrcIndex !== null && target !== null && dragSrcIndex !== target) {
      var item = blocks.splice(dragSrcIndex, 1)[0];
      if (dragSrcIndex < target) target--;
      blocks.splice(target, 0, item);
      renderBlocks();
      scheduleSave();
      showToast('⇅ Block reordered — saved automatically');
    }
    clearDropMarks();
    return false;
  }
  function handleDragEnd() {
    clearDropMarks();
  }

  function moveBlock(idx, dir) {
    var newIdx = idx + dir;
    if (newIdx < 0 || newIdx >= blocks.length) return;
    var temp = blocks[idx];
    blocks[idx] = blocks[newIdx];
    blocks[newIdx] = temp;
    renderBlocks();
    scheduleSave();
  }

  function toggleBlock(idx) {
    blocks[idx].enabled = !blocks[idx].enabled;
    renderBlocks();
    scheduleSave();
    showToast(blocks[idx].enabled ? '<i class="fas fa-eye"></i> Block shown — saved automatically' : '<i class="fas fa-eye-slash"></i> Block hidden — saved automatically');
  }

  function deleteBlock(idx) {
    if (confirm('Remove this section block from homepage?')) {
      blocks.splice(idx, 1);
      renderBlocks();
      scheduleSave();
      showToast('<i class="fas fa-trash"></i> Block removed — saved automatically');
    }
  }

  function updateBlock(idx, key, val) {
    blocks[idx][key] = val;
    scheduleSave();
  }

  function buildNewBlock(type) {
    var defaultTitles = {
      ticker: { km: 'ព័ត៌មានចុងក្រោយ', en: 'Latest Headlines' },
      headlines: { km: 'កំពូលព័ត៌មាន', en: 'Top Headlines' },
      tags: { km: 'ស្លាកព័ត៌មានពេញនិយម', en: 'Popular Tags' },
      hero: { km: 'ព័ត៌មានលេចធ្លោ', en: 'Featured Showcase' },
      spotlight: { km: 'ព័ត៌មានសំខាន់', en: 'Spotlight' },
      category: { km: 'ព័ត៌មានថ្មីៗ', en: 'Latest Category Stories' },
      newsletter: { km: 'ព្រឹត្តិបត្រព័ត៌មាន', en: 'Newsletter' },
      ad_slot: { km: 'ផ្ទាំងពាណិជ្ជកម្ម', en: 'Ad Banner' },
      stats: { km: 'ស្ថិតិព័ត៌មាន', en: 'Site Stats' },
      article_comments: { km: 'មតិយោបល់', en: 'Comments' },
      article_related: { km: 'អត្ថបទពាក់ព័ន្ធ', en: 'Related Articles' }
    };
    var newBlock = {
      id: 'block-' + Date.now(),
      type: type,
      title_km: (defaultTitles[type] && defaultTitles[type].km) || 'ផ្នែកថ្មី',
      title_en: (defaultTitles[type] && defaultTitles[type].en) || 'New Section',
      enabled: true,
      limit: type === 'ticker' ? 10 : (type === 'tags' ? 20 : 6),
      style: type === 'category' ? 'grid_3_col' : ''
    };
    if (type === 'category' && availableCategories.length > 0) {
      newBlock.category_id = availableCategories[0].id;
    }
    if (type === 'ad_slot') {
      newBlock.position_slot = currentPage === 'article' ? 'article_bottom' : 'homepage_mid_banner';
    }
    if (type === 'article_related') {
      newBlock.limit = 4;
    }
    return newBlock;
  }

  function addNewBlock(type) {
    blocks.push(buildNewBlock(type));
    renderBlocks();
    scheduleSave();
    showToast('<i class="fas fa-plus"></i> Block added — saved automatically');
  }

  function addNewBlockAt(type, idx) {
    blocks.splice(idx, 0, buildNewBlock(type));
    renderBlocks();
    scheduleSave();
    showToast('<i class="fas fa-plus"></i> Block inserted — saved automatically');
  }

