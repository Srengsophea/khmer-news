              </div>
              <% if (latestArt) { %>
                <h4 class="about-desk-latest-title">
                  <a href="/article/<%= latestArt.slug %>"><%= latestArt[`title_${lang}`] || latestArt.title_en %></a>
                </h4>
                <div class="about-desk-latest-time">
                  <%= typeof timeAgo === 'function' ? timeAgo(latestArt.created_at) : String(latestArt.created_at).slice(0, 16) %>
                  &bull; <%= latestArt.author_name || 'Khmer News Desk' %>
                </div>
              <% } else { %>
                <div class="about-desk-latest-time"><%= lang === 'km' ? 'កំពុងធ្វើបច្ចុប្បន្នភាព...' : 'Updating live wire...' %></div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- 5. CODE OF JOURNALISTIC ETHICS & STANDARDS -->
    <div class="about-sec-head" id="ethics">
      <h2 class="about-sec-title">
        <span class="sec-num">SECTION 03 //</span>
        <%= lang === 'km' ? 'ក្រមសីលធម៌វិជ្ជាជីវៈ និងស្តង់ដារផ្ទៀងផ្ទាត់ការពិត' : 'Code of Journalistic Ethics & Verification Protocol' %>
      </h2>
      <span class="about-sec-sub"><%= lang === 'km' ? 'គោលការណ៍គ្រឹះទាំង ៤ របស់បន្ទប់ព័ត៌មានយើងខ្ញុំ' : 'The Four Pillars Governing Every Dispatch We Publish' %></span>
    </div>

    <div class="about-ethics-grid">
      <div class="about-ethic-col">
        <div class="about-ethic-num">PRINCIPLE 01 // VERIFICATION</div>
        <h3 class="about-ethic-title"><%= lang === 'km' ? 'ការផ្ទៀងផ្ទាត់ប្រភពឯករាជ្យយ៉ាងតិច ២' : 'Dual-Source & Primary Document Rule' %></h3>
        <p class="about-ethic-text">
          <%= lang === 'km'
            ? 'រាល់អត្ថបទព័ត៌មានត្រូវតែផ្អែកលើឯកសារផ្លូវការ ស្ថិតិបឋម ឬការបញ្ជាក់ពីប្រភពឯករាជ្យយ៉ាងតិចពីរ មុនពេលអនុញ្ញាតឱ្យចេញផ្សាយនៅលើគេហទំព័រ។ យើងមិនផ្សាយពាក្យចចាមអារ៉ាមដែលគ្មានប្រភពច្បាស់លាស់ឡើយ។'
            : 'No dispatch enters the Khmer News wire without primary documentation, official data releases, or confirmation from at least two independent on-the-record sources. Unverified rumors are never published.' %>
        </p>
      </div>

      <div class="about-ethic-col">
        <div class="about-ethic-num">PRINCIPLE 02 // INDEPENDENCE</div>
        <h3 class="about-ethic-title"><%= lang === 'km' ? 'ការបែងចែកដាច់ស្រឡះរវាងព័ត៌មាន និងពាណិជ្ជកម្ម' : 'Strict Editorial & Commercial Firewall' %></h3>
        <p class="about-ethic-text">
          <%= lang === 'km'
            ? 'ការសម្រេចចិត្តជ្រើសរើសប្រធានបទ និងខ្លឹមសារព័ត៌មានធ្វើឡើងដោយគណៈកម្មាធិការនិពន្ធតែមួយគត់។ ផ្ទាំងពាណិជ្ជកម្ម ឬអត្ថបទឧបត្ថម្ភត្រូវបានដាក់ស្លាកសម្គាល់យ៉ាងច្បាស់លាស់ ដើម្បីកុំឱ្យអ្នកអានភាន់ច្រឡំ។'
            : 'Coverage decisions are made exclusively by our editors. Sponsored placements and display advertisements are clearly labeled and strictly separated from newsroom reporting and analysis.' %>
        </p>
      </div>

      <div class="about-ethic-col">
        <div class="about-ethic-num">PRINCIPLE 03 // ACCOUNTABILITY</div>
        <h3 class="about-ethic-title"><%= lang === 'km' ? 'គោលការណ៍កែតម្រូវដោយតម្លាភាព' : 'Transparent Corrections & Timestamps' %></h3>
        <p class="about-ethic-text">
          <%= lang === 'km'
            ? 'ប្រសិនបើមានកំហុសឆ្គងផ្នែកទិន្នន័យ ឬតួលេខណាមួយកើតឡើង ក្រុមនិពន្ធនឹងធ្វើការកែតម្រូវជាបន្ទាន់ ដោយភ្ជាប់ជាមួយកំណត់សម្គាល់កែតម្រូវ និងម៉ោងធ្វើបច្ចុប្បន្នភាពយ៉ាងច្បាស់លាស់នៅខាងក្រោមអត្ថបទ។'
            : 'When factual clarifications or updates are required, we amend the record promptly with an explicit timestamped editor\'s note explaining what was updated and why.' %>
        </p>
      </div>

      <div class="about-ethic-col">
        <div class="about-ethic-num">PRINCIPLE 04 // BILINGUAL CRAFT</div>
        <h3 class="about-ethic-title"><%= lang === 'km' ? 'គុណភាពអក្សរសាស្ត្រខ្មែរ និងអង់គ្លេស' : 'Native Bilingual Editorial Craft' %></h3>
        <p class="about-ethic-text">
          <%= lang === 'km'
            ? 'យើងមិនប្រើប្រាស់ការបកប្រែដោយម៉ាស៊ីនស្វ័យប្រវត្តិដោយគ្មានការត្រួតពិនិត្យនោះទេ។ អត្ថបទនីមួយៗត្រូវបានកែសម្រួលដោយអ្នកនិពន្ធជំនាញ ដើម្បីរក្សាភាពត្រឹមត្រូវនៃវាក្យសព្ទច្បាប់ សេដ្ឋកិច្ច និងបច្ចេកវិទ្យា។'
            : 'We reject raw machine translation. Every story is edited by specialist Khmer and English journalists to preserve legal, financial, diplomatic, and technical precision.' %>
        </p>
      </div>
    </div>

    <!-- 6. THE EDITORIAL MASTHEAD & NEWSROOM LEADERSHIP -->
    <div class="about-sec-head" id="leadership">
      <h2 class="about-sec-title">
        <span class="sec-num">SECTION 04 //</span>
        <%= lang === 'km' ? 'គណៈកម្មាធិការនិពន្ធ និងថ្នាក់ដឹកនាំបន្ទប់ព័ត៌មាន' : 'The Editorial Masthead & Newsroom Leadership' %>
      </h2>
      <span class="about-sec-sub"><%= lang === 'km' ? 'ក្រុមនិពន្ធនាយកទទួលបន្ទុកគុណភាពសារព័ត៌មានប្រចាំថ្ងៃ' : 'Senior Editors & Bureau Chiefs Directing Daily Coverage' %></span>
    </div>

    <div class="about-leadership-grid">
      <% leadershipTeam.forEach(function(member) { %>
        <div class="about-leader-item">
          <div class="about-leader-role"><%= lang === 'km' ? member.role_km : member.role_en %></div>
          <h3 class="about-leader-name"><%= lang === 'km' ? member.name_km : member.name_en %></h3>
          <p class="about-leader-bio"><%= lang === 'km' ? member.bio_km : member.bio_en %></p>
          <a href="mailto:<%= member.email %>" class="about-leader-email">
            <i class="fas fa-envelope"></i> <%= member.email %>
          </a>
        </div>
      <% }) %>
    </div>

    <!-- 7. GLOBAL BUREAUS, PRESS ROOM & CONTACT DIRECTORY -->
    <div class="about-sec-head" id="bureaus">
      <h2 class="about-sec-title">
        <span class="sec-num">SECTION 05 //</span>
        <%= lang === 'km' ? 'ការិយាល័យសារព័ត៌មាន ការផ្តល់ដំណឹង និងទំនាក់ទំនងផ្លូវការ' : 'Newsroom Bureaus, Confidential Tips & Press Inquiries' %>
      </h2>
      <span class="about-sec-sub"><%= lang === 'km' ? 'ទាក់ទងមកកាន់ក្រុមការងារ Khmer News' : 'Direct Channels to Reach Our Editors & Commercial Team' %></span>
    </div>

    <div class="about-bureaus-grid">
      <div class="about-bureau-col">
        <h3><i class="fas fa-building-columns" style="color: var(--accent, #dc2626);"></i> <%= lang === 'km' ? 'ការិយាល័យកណ្តាលរាជធានីភ្នំពេញ' : 'Phnom Penh Central Newsroom' %></h3>
        <p>
          <%= lang === 'km'
            ? 'មជ្ឈមណ្ឌលផលិតព័ត៌មានទ្វិភាសា ២៤ ម៉ោង និងការិយាល័យគ្រប់គ្រងទូទៅរបស់ Khmer News ស្ថិតនៅកណ្តាលរាជធានីភ្នំពេញ។'
            : 'Our 24-hour central wire desk, executive editorial board, and multimedia production studio operate from central Phnom Penh.' %>
        </p>
        <ul class="about-bureau-list">
          <li><strong><%= lang === 'km' ? 'អាសយដ្ឋាន៖' : 'Address:' %></strong> <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings[`contact_address_${lang}`]) || (lang === 'km' ? 'មហាវិថីព្រះមុនីវង្ស រាជធានីភ្នំពេញ កម្ពុជា' : 'Preah Monivong Blvd, Sangkat Boeung Keng Kang, Phnom Penh, Cambodia') %></li>
          <li><strong><%= lang === 'km' ? 'ទូរស័ព្ទបន្ទប់ព័ត៌មាន៖' : 'Newsdesk Phone:' %></strong> <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.contact_phone) || '+855 23 456 789' %></li>
          <li><strong><%= lang === 'km' ? 'អ៊ីមែលផ្លូវការ៖' : 'General Desk:' %></strong> <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.contact_email) || 'info@khmernews.com.kh' %></li>
        </ul>
      </div>

      <div class="about-bureau-col">
        <h3><i class="fas fa-globe" style="color: var(--accent, #dc2626);"></i> <%= lang === 'km' ? 'ការិយាល័យតំបន់ និងអ្នកឆ្លើយឆ្លងព័ត៌មាន' : 'Regional & Provincial Bureaus' %></h3>
        <p>
          <%= lang === 'km'
            ? 'បណ្តាញអ្នកយកព័ត៌មានប្រចាំតំបន់សេដ្ឋកិច្ច និងទេសចរណ៍សំខាន់ៗ ដើម្បីរាយការណ៍ផ្ទាល់ពីមូលដ្ឋាន។'
            : 'Field correspondents stationed across key economic corridors and regional capitals.' %>
        </p>
        <ul class="about-bureau-list">
          <li><strong>Siem Reap & Northern Bureau:</strong> Tourism, Heritage & Airport Corridor (`siemreap@khmernews.com.kh`)</li>
          <li><strong>Sihanoukville & Coastal SEZ Desk:</strong> Deep-Sea Port, Maritime Trade & Industrial Zones (`coastal@khmernews.com.kh`)</li>
          <li><strong>ASEAN Diplomatic Wire:</strong> Regional Summits & Cross-Border Trade (`asean@khmernews.com.kh`)</li>
        </ul>
      </div>

      <div class="about-bureau-col">
        <h3><i class="fas fa-paper-plane" style="color: var(--accent, #dc2626);"></i> <%= lang === 'km' ? 'ផ្ញើព័ត៌មាន សហការ និងផ្សព្វផ្សាយ' : 'News Tips, Press Releases & Advertising' %></h3>
        <p>
          <%= lang === 'km'
            ? 'មានដំណឹងសំខាន់ សេចក្តីប្រកាសព័ត៌មានផ្លូវការ ឬមានបំណងផ្សព្វផ្សាយពាណិជ្ជកម្មនៅលើគេហទំព័រ Khmer News? សូមទាក់ទងមកកាន់យើងខ្ញុំផ្ទាល់៖'
            : 'Have a confidential news tip, official press release, correction request, or corporate sponsorship inquiry? Connect with our desks directly:' %>
        </p>
        <div class="about-cta-links">
          <a href="/today" class="about-cta-btn is-primary">
            <i class="fas fa-bolt"></i> <%= lang === 'km' ? 'ព័ត៌មានថ្ងៃនេះ (Today Now)' : 'Today\'s Live Wire' %>
          </a>
          <a href="/contact" class="about-cta-btn">
            <i class="fas fa-envelope"></i> <%= lang === 'km' ? 'ទាក់ទងបន្ទប់ព័ត៌មាន' : 'Contact Newsroom' %>
          </a>
          <a href="/advertise" class="about-cta-btn">
            <i class="fas fa-bullhorn"></i> <%= lang === 'km' ? 'ផ្សព្វផ្សាយពាណិជ្ជកម្ម' : 'Advertise With Us' %>
          </a>
          <a href="/feed.xml" target="_blank" class="about-cta-btn">
            <i class="fas fa-rss"></i> RSS Wire
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
