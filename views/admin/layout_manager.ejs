  function switchTab(tab) {
    document.getElementById('blocksStudioSection').style.display = tab === 'blocks' ? 'block' : 'none';
    document.getElementById('presetsStudioSection').style.display = tab === 'presets' ? 'block' : 'none';
    document.getElementById('themeStudioSection').style.display = tab === 'theme' ? 'block' : 'none';
    document.getElementById('tabBlocksBtn').className = 'studio-mode-tab ' + (tab === 'blocks' ? 'active' : '');
    document.getElementById('tabPresetsBtn').className = 'studio-mode-tab ' + (tab === 'presets' ? 'active' : '');
    document.getElementById('tabThemeBtn').className = 'studio-mode-tab ' + (tab === 'theme' ? 'active' : '');
    var ps = document.getElementById('pageSwitcherWrap');
    if (ps) ps.style.display = tab === 'theme' ? 'none' : 'flex';
  }

  function switchPage(page) {
    if (!blocksByPage[page]) return;
    currentPage = page;
    blocks = blocksByPage[page];
    historyStack = [];
    var uBtn = document.getElementById('undoBtn');
    if (uBtn) uBtn.disabled = true;

    ['home', 'category', 'article'].forEach(function(p) {
      var id = p === 'home' ? 'pageHomeBtn' : (p === 'category' ? 'pageCatBtn' : 'pageArtBtn');
      var el = document.getElementById(id);
      if (el) el.className = 'page-pill' + (p === currentPage ? ' active' : '');
    });

    var bpTitle = document.getElementById('blueprintPageTitle');
    var bpLink = document.getElementById('blueprintOpenLink');
    if (bpTitle) bpTitle.textContent = page === 'home' ? 'Front Page Architecture' : (page === 'category' ? 'Category Desk Architecture' : 'Article Page Architecture');
    if (bpLink) bpLink.href = page === 'home' ? '/' : (page === 'category' ? '/category/national' : '/today');

    renderAll();
  }

  function exportLayoutJson() {
    var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(blocks, null, 2));
    var a = document.createElement('a');
    a.setAttribute("href", dataStr);
    a.setAttribute("download", "khmer-news-layout-" + currentPage + ".json");
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  function importLayoutJson() {
    var raw = prompt('Paste exported Layout JSON array here:');
    if (!raw) return;
    try {
      var parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) throw new Error('Invalid');
      pushHistory();
      blocks = parsed;
      blocksByPage[currentPage] = blocks;
      renderAll();
      scheduleSave();
      showToast('<i class="fas fa-check"></i> Layout JSON imported & saved');
    } catch (e) {
      showToast('Invalid JSON format', true);
    }
  }

  var saveTimer = null;
  function scheduleSave() {
    var st = document.getElementById('autosaveStatus');
    if (st) st.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    if (saveTimer) clearTimeout(saveTimer);
    saveTimer = setTimeout(function() { saveAllBlocks(false); }, 350);
  }

  function showToast(msg, isError) {
    var t = document.getElementById('builderToast');
    if (!t) {
      t = document.createElement('div');
      t.id = 'builderToast';
      document.body.appendChild(t);
    }
    t.innerHTML = msg;
    t.style.background = isError ? '#b91c1c' : '#0f172a';
    t.style.opacity = '1';
    clearTimeout(showToast._timer);
    showToast._timer = setTimeout(function() { t.style.opacity = '0'; }, 2400);
  }

  function saveAllBlocks(manual) {
    if (saveTimer) { clearTimeout(saveTimer); saveTimer = null; }
    return fetch('/admin/layout/blocks/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ blocks: blocks, page: currentPage })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      var st = document.getElementById('autosaveStatus');
      if (st) st.innerHTML = '<i class="fas fa-check-circle"></i> All changes saved live';
      if (data.success && manual) showToast('<i class="fas fa-check"></i> Layout published live to website!');
      return data;
    });
  }

  // Theme Auto-save & Preview
  var themeSaveTimer = null;
  function themeChanged() {
    var stage = document.getElementById('pvStage');
    var p = (document.getElementById('primaryColorPicker') || {}).value || '#1e3a8a';
    var a = (document.getElementById('accentColorPicker') || {}).value || '#dc2626';
    var pt = document.getElementById('primaryColorText');
    var at = document.getElementById('accentColorText');
    if (pt) pt.value = p;
    if (at) at.value = a;
    if (stage) {
      stage.style.setProperty('--pv-primary', p);
      stage.style.setProperty('--pv-accent', a);
    }
    var txtKm = document.querySelector('input[name="breaking_news_text_km"]');
    var txtEn = document.querySelector('input[name="breaking_news_text_en"]');
    var bt = document.getElementById('pvBreakingText');
    if (bt) bt.textContent = (txtEn && txtEn.value.trim()) || (txtKm && txtKm.value.trim()) || 'Live updates from Phnom Penh';

    if (themeSaveTimer) clearTimeout(themeSaveTimer);
    themeSaveTimer = setTimeout(function() {
      var form = document.getElementById('themeSettingsForm');
      if (!form) return;
      var data = new URLSearchParams(new FormData(form));
      fetch('/admin/layout/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body: data.toString()
      }).then(function() {
        showToast('<i class="fas fa-palette"></i> Brand & Theme settings auto-saved');
      });
    }, 500);
  }

  function setTheme(primary, accent) {
    var p = document.getElementById('primaryColorPicker');
    var a = document.getElementById('accentColorPicker');
    if (p) p.value = primary;
    if (a) a.value = accent;
    themeChanged();
  }

  function saveCurrentAsTemplate() {
    var name = prompt('Enter a name for this custom layout preset:');
    if (!name || !name.trim()) return;
    fetch('/admin/layout/templates/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name.trim(), blocks: blocks, page: currentPage })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        customTemplates = data.templates || [];
        renderCustomTemplates();
        showToast('<i class="fas fa-bookmark"></i> Saved preset "' + name.trim() + '"');
      }
    });
  }

  function applyCustomTemplate(name) {
    var t = customTemplates.find(function(x) { return x.name === name && (x.page || 'home') === currentPage; });
    if (!t) return;
    pushHistory();
    blocks = JSON.parse(JSON.stringify(t.blocks));
    blocksByPage[currentPage] = blocks;
    renderAll();
    switchTab('blocks');
    scheduleSave();
    showToast('<i class="fas fa-check"></i> Applied custom preset "' + name + '"');
  }

  function deleteCustomTemplate(name) {
    fetch('/admin/layout/templates/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, page: currentPage })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        customTemplates = data.templates || [];
        renderCustomTemplates();
        showToast('<i class="fas fa-trash"></i> Deleted preset "' + name + '"');
      }
    });
  }

  function renderCustomTemplates() {
    var list = document.getElementById('customTemplatesList');
    if (!list) return;
    var mine = customTemplates.filter(function(t) { return (t.page || 'home') === currentPage; });
    if (mine.length === 0) {
      list.innerHTML = '<span style="font-size:0.82rem;color:#64748b;">No custom presets saved yet. Click "Save Preset" in the top bar to save your current layout!</span>';
      return;
    }
    list.innerHTML = mine.map(function(t) {
      var safe = t.name.replace(/'/g, "\\'");
      return '<div style="border:1px solid #cbd5e1;padding:10px 14px;background:#f8fafc;display:flex;align-items:center;gap:10px;">' +
        '<strong>' + t.name + '</strong>' +
        '<span style="font-size:0.75rem;color:#64748b;">(' + (t.blocks || []).length + ' sections)</span>' +
        '<button type="button" class="studio-mini-btn" onclick="applyCustomTemplate(\'' + safe + '\')">Apply</button>' +
        '<button type="button" class="studio-mini-btn" onclick="deleteCustomTemplate(\'' + safe + '\')"><i class="fas fa-xmark"></i></button>' +
      '</div>';
    }).join('');
  }

  document.addEventListener('DOMContentLoaded', function() {
    if (activeTab === 'theme') switchTab('theme');
    renderAll();
    var p = document.getElementById('primaryColorPicker');
    var a = document.getElementById('accentColorPicker');
    if (p) p.addEventListener('input', themeChanged);
    if (a) a.addEventListener('input', themeChanged);
  });
