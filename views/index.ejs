<section class="hero-section">
  <div class="container">
    <div class="hero-grid">
      <% if (featured && featured.length > 0) { %>
        <a href="/article/<%= featured[0].slug %>" class="hero-main">
          <img src="<%= featured[0].image_url %>" alt="<%= featured[0][`title_${lang}`] %>">
          <div class="hero-overlay">
            <span class="hero-category"><%= featured[0][`category_name_${lang}`] %></span>
            <h2 class="hero-title"><%= featured[0][`title_${lang}`] %></h2>
            <span class="hero-meta"><%= new Date(featured[0].created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
          </div>
        </a>
      <% } %>
      <div class="hero-side">
        <% if (featured && featured.length > 1) { %>
          <% featured.slice(1, 3).forEach(function(f) { %>
            <a href="/article/<%= f.slug %>" class="hero-side-card">
              <img src="<%= f.image_url %>" alt="<%= f[`title_${lang}`] %>">
              <div class="hero-side-overlay">
                <span class="hero-category"><%= f[`category_name_${lang}`] %></span>
                <h3 class="hero-side-title"><%= f[`title_${lang}`] %></h3>
              </div>
            </a>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="content-layout">
      <div class="main-column">
        
        <!-- SECTION 1: Spotlight (Featured/Wide) -->
        <% if (articles && articles.length > 0) { %>
          <div class="section-header">
            <h2 class="section-title"><%= t('labels.featured') %></h2>
          </div>
          <div style="margin-bottom: 32px;">
            <% var spotlight = articles[0]; %>
            <article class="card-template-wide">
              <a href="/article/<%= spotlight.slug %>" class="card-img-link">
                <img src="<%= spotlight.image_url %>" alt="<%= spotlight[`title_${lang}`] %>" class="card-img">
              </a>
              <div class="article-card-body">
                <div class="article-card-meta">
                  <span class="article-card-category badge-cat-<%= spotlight.category_slug %>"><%= spotlight[`category_name_${lang}`] %></span>
                  <span class="article-card-date">&bull; <%= new Date(spotlight.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                </div>
                <h3 class="article-card-title">
                  <a href="/article/<%= spotlight.slug %>"><%= spotlight[`title_${lang}`] %></a>
                </h3>
                <p class="article-card-excerpt"><%= spotlight[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 200) %>...</p>
                <div class="article-card-footer">
                  <a href="/article/<%= spotlight.slug %>" class="read-more"><%= t('common.read_more') %> &rarr;</a>
                </div>
              </div>
            </article>
          </div>
        <% } %>

        <!-- SECTION 2: Latest Stories (Consistent 2-Column Grid) -->
        <% if (articles && articles.length > 1) { %>
          <div class="section-header">
            <h2 class="section-title"><%= t('admin.recent_articles') %></h2>
          </div>
          <div class="grid grid-cols-2 gap-6" style="margin-bottom: 32px;">
            <% articles.slice(1, 7).forEach(function(a) { %>
              <article class="card-template-standard">
                <a href="/article/<%= a.slug %>">
                  <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>" class="article-card-img">
                </a>
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span class="article-card-category badge-cat-<%= a.category_slug %>"><%= a[`category_name_${lang}`] %></span>
                    <span class="article-card-date">&bull; <%= new Date(a.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                  </div>
                  <h3 class="article-card-title">
                    <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
                  </h3>
                  <p class="article-card-excerpt"><%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 120) %>...</p>
                  <div class="article-card-footer">
                    <a href="/article/<%= a.slug %>" class="read-more"><%= t('common.read_more') %> &rarr;</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>

        <!-- SECTION 3: More Stories (Minimal List Style) -->
        <% if (articles && articles.length > 7) { %>
          <div class="section-header">
            <h2 class="section-title"><%= t('common.view_all') %></h2>
          </div>
          <div class="grid grid-cols-1 gap-4">
            <% articles.slice(7, 15).forEach(function(a) { %>
              <article class="card-template-minimal">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span class="article-card-category badge-cat-<%= a.category_slug %>"><%= a[`category_name_${lang}`] %></span>
                    <span class="article-card-date">&bull; <%= new Date(a.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                  </div>
                  <h3 class="article-card-title">
                    <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
                  </h3>
                  <p class="article-card-excerpt" style="-webkit-line-clamp: 2;"><%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 160) %>...</p>
                  <div class="article-card-footer" style="margin-top: 8px;">
                    <a href="/article/<%= a.slug %>" class="read-more"><%= t('common.read_more') %> &rarr;</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>

      </div>

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-widget">
          <h3 class="widget-title"><%= t('common.view_all') %></h3>
          <ul class="trending-list">
            <% articles.slice(0, 7).forEach(function(a, idx) { %>
              <li class="trending-item">
                <span class="trending-number"><%= idx + 1 %></span>
                <span class="trending-title">
                  <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
                </span>
              </li>
            <% }) %>
          </ul>
        </div>
        
        <div class="sidebar-widget">
          <h3 class="widget-title"><%= t('admin.categories') %></h3>
          <ul class="category-list">
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(function(c) { %>
                <li class="category-item">
                  <a href="/category/<%= c.slug %>">
                    <span>📰</span>
                    <span><%= c[`name_${lang}`] %></span>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </div>

        <% if (typeof siteAds !== 'undefined' && siteAds) { %>
          <% var sidebarAd = siteAds.find(ad => ad.position === 'sidebar'); %>
          <% if (sidebarAd) { %>
            <div class="sidebar-widget" style="padding: 10px; display: flex; justify-content: center; overflow: hidden;">
              <a href="<%= sidebarAd.link_url %>" target="_blank">
                <img src="<%= sidebarAd.image_url %>" alt="<%= sidebarAd.title %>" style="width: 100%; border-radius: 6px; border: 1px solid #e2e8f0; max-height: 250px; object-fit: cover;">
              </a>
            </div>
          <% } %>
        <% } %>
      </aside>

    </div>
  </div>
</section>
