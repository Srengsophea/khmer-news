<section class="editorial-search-page">
  <div class="container">
    <header class="editorial-section-banner">
      <div class="editorial-section-banner-top">
        <nav class="editorial-breadcrumb">
          <a href="/"><%= t('nav.home') %></a>
          <span>/</span>
          <span><%= t('nav.search') %></span>
        </nav>
      </div>
      <div class="editorial-section-banner-main">
        <div>
          <h1 class="editorial-page-title"><%= t('nav.search') %></h1>
        </div>
      </div>

      <div class="search-suggest-wrap" style="margin-top: 16px;">
        <form action="/search" method="GET" class="editorial-search-bar" autocomplete="off">
          <input type="text" name="q" id="searchInput" value="<%= query %>" placeholder="<%= t('common.search_placeholder') %>" autofocus>
          <button type="submit"><i class="fas fa-search"></i> <%= t('nav.search') %></button>
        </form>
        <div class="search-suggest" id="searchSuggest" style="display: none;"></div>
      </div>
    </header>

    <% if (query) { %>
      <div class="editorial-search-meta">
        <strong><%= articles.length %></strong> <%= lang === 'km' ? 'លទ្ធផលសម្រាប់' : 'dispatches matching' %>
        “<strong><%= query %></strong>”
      </div>
    <% } %>

    <% if (query && articles && articles.length > 0) { %>
      <div class="editorial-chronological-wire">
        <% articles.forEach(function(a) { %>
          <article class="editorial-wire-row">
            <div class="editorial-wire-time-col">
              <time class="editorial-wire-badge" datetime="<%= a.created_at %>" data-live-time="<%= a.created_at %>"><%= timeAgo(a.created_at) %></time>
              <span class="editorial-wire-clock"><%= String(a.created_at || '').slice(0, 10) %></span>
            </div>
            <div class="editorial-wire-content-col">
              <div class="editorial-meta-row">
                <% if (a.category_name_en) { %>
                  <a href="/category/<%= a.category_slug %>" class="editorial-kicker"><%= a[`category_name_${lang}`] %></a>
                <% } %>
              </div>
              <h3 class="editorial-wire-headline">
                <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
              </h3>
              <p class="editorial-wire-summary">
                <%= a[`summary_${lang}`] ? a[`summary_${lang}`] : stripHtml(a[`content_${lang}`], 190) %>
              </p>
              <div class="editorial-byline">
                <span><%= a.author_name || 'Khmer News Desk' %></span>
                <span>•</span>
                <span><%= a.read_time_minutes || 3 %> <%= t('common.minutes_read') %></span>
              </div>
            </div>
            <% if (a.image_url) { %>
              <a href="/article/<%= a.slug %>" class="editorial-wire-thumb">
                <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>" loading="lazy">
              </a>
            <% } %>
          </article>
        <% }) %>
      </div>

      <% if (pagination && pagination.totalPages > 1) { %>
        <nav class="editorial-pagination">
          <% var basePath = '/search?q=' + encodeURIComponent(query); %>
          <% if (pagination.current > 1) { %>
            <a href="<%= basePath %>&page=<%= pagination.current - 1 %>" class="page-link">&larr; <%= t('common.prev') %></a>
          <% } %>
          <% pagination.pages.forEach(function(p) { %>
            <a href="<%= basePath %>&page=<%= p %>" class="page-link <%= p === pagination.current ? 'active' : '' %>"><%= p %></a>
          <% }) %>
          <% if (pagination.current < pagination.totalPages) { %>
            <a href="<%= basePath %>&page=<%= pagination.current + 1 %>" class="page-link"><%= t('common.next') %> &rarr;</a>
          <% } %>
        </nav>
      <% } %>
    <% } else if (query) { %>
      <div class="empty-state">
        <p><%= lang === 'km' ? 'រកមិនឃើញលទ្ធផលសម្រាប់' : 'No dispatches found for' %> “<%= query %>”</p>
      </div>
    <% } %>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var input = document.getElementById('searchInput');
    var suggest = document.getElementById('searchSuggest');
    if (!input || !suggest) return;
    var timer = null;
    input.addEventListener('input', function () {
      clearTimeout(timer);
      var q = input.value.trim();
      if (q.length < 2) { suggest.style.display = 'none'; return; }
      timer = setTimeout(function () {
        fetch('/api/search?q=' + encodeURIComponent(q))
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (!data || data.length === 0) { suggest.style.display = 'none'; return; }
            suggest.innerHTML = data.slice(0, 6).map(function (a) {
              var title = a.title_en || a.title_km;
              return '<a href="/article/' + a.slug + '" class="suggest-item">' +
                '<span class="suggest-icon"><i class="fas fa-newspaper"></i></span>' +
                '<span class="suggest-title">' + title + '</span>' +
                '<span class="suggest-cat">' + (a.name_en || '') + '</span></a>';
            }).join('');
            suggest.style.display = 'block';
          })
          .catch(function () { suggest.style.display = 'none'; });
      }, 250);
    });
    document.addEventListener('click', function (e) {
      if (!suggest.contains(e.target) && e.target !== input) {
        suggest.style.display = 'none';
      }
    });
  });
</script>
