<section class="hero-section">
  <div class="container">
    <% var heroStyle = (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.hero_layout_style) ? siteSettings.hero_layout_style : 'grid_3'; %>

    <% if (heroStyle === 'single_hero_banner' && featured && featured.length > 0) { %>
      <!-- HERO STYLE: Single Ultra-Wide Hero Banner -->
      <div style="margin-bottom: 24px;">
        <a href="/article/<%= featured[0].slug %>" class="hero-main" style="height: 460px;">
          <img src="<%= featured[0].image_url %>" alt="<%= featured[0][`title_${lang}`] %>">
          <div class="hero-overlay" style="padding: 40px; background: linear-gradient(to top, rgba(0,0,0,0.95), rgba(0,0,0,0.2));">
            <span class="hero-category badge-cat-<%= featured[0].category_slug %>"><%= featured[0][`category_name_${lang}`] %></span>
            <h1 class="hero-title" style="font-size: 2.2rem; line-height: 1.3; margin-top: 12px;"><%= featured[0][`title_${lang}`] %></h1>
            <div style="display: flex; gap: 16px; align-items: center; margin-top: 12px; color: rgba(255,255,255,0.85); font-size: 0.9rem;">
              <span>📅 <%= new Date(featured[0].created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
              <span>⏱️ <%= featured[0].read_time_minutes || 3 %> <%= lang === 'km' ? 'នាទីអាន' : 'min read' %></span>
              <span>👁️ <%= featured[0].views_count || 120 %> <%= lang === 'km' ? 'ការទស្សនា' : 'views' %></span>
            </div>
          </div>
        </a>
      </div>

    <% } else if (heroStyle === 'split_2' && featured && featured.length > 0) { %>
      <!-- HERO STYLE: Split Dual Featured -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;" class="split-hero-grid">
        <% featured.slice(0, 2).forEach(function(f) { %>
          <a href="/article/<%= f.slug %>" class="hero-main" style="height: 380px;">
            <img src="<%= f.image_url %>" alt="<%= f[`title_${lang}`] %>">
            <div class="hero-overlay" style="padding: 28px;">
              <span class="hero-category badge-cat-<%= f.category_slug %>"><%= f[`category_name_${lang}`] %></span>
              <h2 class="hero-title" style="font-size: 1.5rem; line-height: 1.3; margin-top: 8px;"><%= f[`title_${lang}`] %></h2>
              <span class="hero-meta" style="margin-top: 8px; font-size: 0.85rem;">📅 <%= new Date(f.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
            </div>
          </a>
        <% }) %>
      </div>

    <% } else { %>
      <!-- HERO STYLE: Standard 3-Card Grid -->
      <div class="hero-grid">
        <% if (featured && featured.length > 0) { %>
          <a href="/article/<%= featured[0].slug %>" class="hero-main">
            <img src="<%= featured[0].image_url %>" alt="<%= featured[0][`title_${lang}`] %>">
            <div class="hero-overlay">
              <span class="hero-category badge-cat-<%= featured[0].category_slug %>"><%= featured[0][`category_name_${lang}`] %></span>
              <h2 class="hero-title"><%= featured[0][`title_${lang}`] %></h2>
              <span class="hero-meta">📅 <%= new Date(featured[0].created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            </div>
          </a>
        <% } %>
        <div class="hero-side">
          <% if (featured && featured.length > 1) { %>
            <% featured.slice(1, 3).forEach(function(f) { %>
              <a href="/article/<%= f.slug %>" class="hero-side-card">
                <img src="<%= f.image_url %>" alt="<%= f[`title_${lang}`] %>">
                <div class="hero-side-overlay">
                  <span class="hero-category badge-cat-<%= f.category_slug %>"><%= f[`category_name_${lang}`] %></span>
                  <h3 class="hero-side-title"><%= f[`title_${lang}`] %></h3>
                </div>
              </a>
            <% }) %>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>
</section>

<section class="section">
  <div class="container">
    <div class="content-layout">
      <div class="main-column">
        
        <!-- SECTION 1: Spotlight (Featured/Wide) -->
        <% if (articles && articles.length > 0) { %>
          <div class="section-header">
            <h2 class="section-title"><%= t('labels.featured') %></h2>
          </div>
          <div style="margin-bottom: 32px;">
            <% var spotlight = articles[0]; %>
            <article class="card-template-wide">
              <a href="/article/<%= spotlight.slug %>" class="card-img-link">
                <img src="<%= spotlight.image_url %>" alt="<%= spotlight[`title_${lang}`] %>" class="card-img">
              </a>
              <div class="article-card-body">
                <div class="article-card-meta">
                  <span class="article-card-category badge-cat-<%= spotlight.category_slug %>"><%= spotlight[`category_name_${lang}`] %></span>
                  <span class="article-card-date">&bull; <%= new Date(spotlight.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                  <span class="article-card-views">&bull; 👁️ <%= spotlight.views_count || 48 %></span>
                </div>
                <h3 class="article-card-title">
                  <a href="/article/<%= spotlight.slug %>"><%= spotlight[`title_${lang}`] %></a>
                </h3>
                <p class="article-card-excerpt"><%= spotlight[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 190) %>...</p>
                <div class="article-card-footer">
                  <a href="/article/<%= spotlight.slug %>" class="read-more"><%= t('common.read_more') %> &rarr;</a>
                  <span class="read-time">⏱️ <%= spotlight.read_time_minutes || 3 %> min read</span>
                </div>
              </div>
            </article>
          </div>
        <% } %>

        <!-- DYNAMIC AD SLOT: Mid Banner -->
        <% if (typeof getAd === 'function') { %>
          <% var midAd = getAd('homepage_mid_banner'); %>
          <% if (midAd) { %>
            <div class="ad-container mid-banner-ad" style="margin: 28px 0; text-align: center; overflow: hidden; border-radius: 8px;">
              <% if (midAd.ad_type === 'html' && midAd.html_code) { %>
                <%- midAd.html_code %>
              <% } else { %>
                <a href="<%= midAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= midAd.id %>', {method:'POST'})">
                  <img src="<%= midAd.image_url %>" alt="<%= midAd.title %>" style="max-width: 100%; border-radius: 8px; max-height: 120px; object-fit: contain;">
                </a>
              <% } %>
            </div>
          <% } %>
        <% } %>

        <!-- SECTION 2: Latest Stories (2-Column Grid) -->
        <% if (articles && articles.length > 1) { %>
          <div class="section-header">
            <h2 class="section-title"><%= t('admin.recent_articles') %></h2>
          </div>
          <div class="grid grid-cols-2 gap-6" style="margin-bottom: 32px;">
            <% articles.slice(1, 7).forEach(function(a) { %>
              <article class="card-template-standard">
                <a href="/article/<%= a.slug %>">
                  <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>" class="article-card-img">
                </a>
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span class="article-card-category badge-cat-<%= a.category_slug %>"><%= a[`category_name_${lang}`] %></span>
                    <span class="article-card-date">&bull; <%= new Date(a.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                  </div>
                  <h3 class="article-card-title">
                    <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
                  </h3>
                  <p class="article-card-excerpt"><%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 110) %>...</p>
                  <div class="article-card-footer">
                    <a href="/article/<%= a.slug %>" class="read-more"><%= t('common.read_more') %> &rarr;</a>
                    <span class="read-time">⏱️ <%= a.read_time_minutes || 3 %> min</span>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>

        <!-- SECTION 3: Minimal List Style -->
        <% if (articles && articles.length > 7) { %>
          <div class="section-header">
            <h2 class="section-title"><%= t('common.view_all') %></h2>
          </div>
          <div class="grid grid-cols-1 gap-4" style="margin-bottom: 32px;">
            <% articles.slice(7, 15).forEach(function(a) { %>
              <article class="card-template-minimal">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span class="article-card-category badge-cat-<%= a.category_slug %>"><%= a[`category_name_${lang}`] %></span>
                    <span class="article-card-date">&bull; <%= new Date(a.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                    <span class="article-card-views">&bull; 👁️ <%= a.views_count || 32 %></span>
                  </div>
                  <h3 class="article-card-title">
                    <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
                  </h3>
                  <p class="article-card-excerpt" style="-webkit-line-clamp: 2;"><%= a[`content_${lang}`].replace(/<[^>]*>/g, '').substring(0, 160) %>...</p>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>

        <!-- DYNAMIC AD SLOT: Bottom Banner -->
        <% if (typeof getAd === 'function') { %>
          <% var bottomAd = getAd('homepage_bottom_banner'); %>
          <% if (bottomAd) { %>
            <div class="ad-container bottom-banner-ad" style="margin-top: 20px; text-align: center;">
              <% if (bottomAd.ad_type === 'html' && bottomAd.html_code) { %>
                <%- bottomAd.html_code %>
              <% } else { %>
                <a href="<%= bottomAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= bottomAd.id %>', {method:'POST'})">
                  <img src="<%= bottomAd.image_url %>" alt="<%= bottomAd.title %>" style="max-width: 100%; border-radius: 8px; max-height: 120px; object-fit: contain;">
                </a>
              <% } %>
            </div>
          <% } %>
        <% } %>

      </div>

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-widget">
          <h3 class="widget-title">🔥 <%= t('common.view_all') %></h3>
          <ul class="trending-list">
            <% articles.slice(0, 7).forEach(function(a, idx) { %>
              <li class="trending-item">
                <span class="trending-number"><%= idx + 1 %></span>
                <span class="trending-title">
                  <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
                </span>
              </li>
            <% }) %>
          </ul>
        </div>
        
        <div class="sidebar-widget">
          <h3 class="widget-title">📂 <%= t('admin.categories') %></h3>
          <ul class="category-list">
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(function(c) { %>
                <li class="category-item">
                  <a href="/category/<%= c.slug %>">
                    <span>📰</span>
                    <span><%= c[`name_${lang}`] %></span>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </div>

        <!-- DYNAMIC AD SLOT: Sidebar -->
        <% if (typeof getAd === 'function') { %>
          <% var sidebarAd = getAd('sidebar'); %>
          <% if (sidebarAd) { %>
            <div class="sidebar-widget ad-widget" style="padding: 12px; display: flex; justify-content: center; overflow: hidden; text-align: center;">
              <% if (sidebarAd.ad_type === 'html' && sidebarAd.html_code) { %>
                <%- sidebarAd.html_code %>
              <% } else { %>
                <a href="<%= sidebarAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= sidebarAd.id %>', {method:'POST'})">
                  <img src="<%= sidebarAd.image_url %>" alt="<%= sidebarAd.title %>" style="width: 100%; border-radius: 8px; border: 1px solid #e2e8f0; max-height: 280px; object-fit: cover;">
                </a>
              <% } %>
            </div>
          <% } %>
        <% } %>

      </aside>

    </div>
  </div>
</section>
