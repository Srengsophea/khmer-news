<div class="admin-page">
  <div class="cms-page-header">
    <div>
      <span class="cms-kicker">NEWSROOM ARCHIVE & LIVE WIRE MANAGER</span>
      <h1 class="admin-page-title">
        <%= (typeof article !== 'undefined' && article) ? (article.id ? t('admin.edit_article') : t('admin.add_article')) : t('admin.articles') %>
        <% if (typeof articles !== 'undefined' && articles && articles.length > 0) { %>
          <span class="cms-count-pill"><%= articles.length %></span>
        <% } %>
      </h1>
    </div>
    <div class="cms-header-actions">
      <% if (typeof article !== 'undefined' && article) { %>
        <a href="/admin/articles" class="cms-btn cms-btn-outline">&larr; Back to All Dispatches</a>
      <% } else { %>
        <form method="POST" action="/admin/articles/sync-today" style="margin:0;">
          <button type="submit" class="cms-btn cms-btn-live">
            <i class="fas fa-bolt"></i> <%= lang === 'km' ? 'ធ្វើបច្ចុប្បន្នភាពព័ត៌មានថ្ងៃនេះ' : "Sync Today's News Now" %>
          </button>
        </form>
        <a href="/admin/articles/edit/0" class="cms-btn cms-btn-primary">
          <i class="fas fa-plus"></i> <%= t('admin.add_article') %>
        </a>
      <% } %>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="cms-alert cms-alert-success">
      <i class="fas fa-circle-check"></i> <%= success %>
    </div>
  <% } %>

  <% if (typeof article !== 'undefined' && article) { %>
    <!-- 2-COLUMN NEWSROOM ARTICLE EDITOR -->
    <% 
    var existingGallery = [];
    try {
      if (article.gallery_images) {
        existingGallery = typeof article.gallery_images === 'string' ? JSON.parse(article.gallery_images) : article.gallery_images;
      }
    } catch(e) { existingGallery = []; }
    if (!Array.isArray(existingGallery)) existingGallery = [];
  %>
  <form method="POST" action="/admin/articles/save" enctype="multipart/form-data" class="cms-editor-grid">
      <input type="hidden" name="id" value="<%= article.id %>">

      <!-- Left Main Column: Bilingual Headlines, Summaries & Body -->
      <div class="cms-editor-main">
        <div class="cms-panel">
          <div class="cms-panel-head">
            <h2><i class="fas fa-heading"></i> Bilingual Headlines & Standfirst Summaries</h2>
          </div>
          <div class="form-group">
            <label><%= t('labels.title') %> (English) *</label>
            <input type="text" name="title_en" value="<%= article.title_en %>" class="form-control" required placeholder="Enter authoritative English headline...">
          </div>
          <div class="form-group">
            <label><%= t('labels.title') %> (Khmer / ភាសាខ្មែរ) *</label>
            <input type="text" name="title_km" value="<%= article.title_km %>" class="form-control" required placeholder="បញ្ចូលចំណងជើងព័ត៌មានជាភាសាខ្មែរ...">
          </div>
          <div class="cms-form-row-2">
            <div class="form-group">
              <label>Standfirst / Deck Summary (EN)</label>
              <input type="text" name="summary_en" value="<%= article.summary_en || '' %>" class="form-control" placeholder="Concise 1-2 sentence executive summary...">
            </div>
            <div class="form-group">
              <label>Standfirst / Deck Summary (KM)</label>
              <input type="text" name="summary_km" value="<%= article.summary_km || '' %>" class="form-control" placeholder="សេចក្តីសង្ខេបខ្លីៗ...">
            </div>
          </div>
        </div>

        <div class="cms-panel" style="margin-top: 20px;">
          <div class="cms-panel-head">
            <h2><i class="fas fa-align-left"></i> Full Dispatch Body (HTML / Paragraphs)</h2>
          </div>
          <div class="form-group">
            <label><%= t('labels.content') %> (English) *</label>
            <textarea name="content_en" rows="8" class="form-control" required><%= article.content_en || '' %></textarea>
          </div>
          <div class="form-group">
            <label><%= t('labels.content') %> (Khmer / ភាសាខ្មែរ) *</label>
            <textarea name="content_km" rows="8" class="form-control" required><%= article.content_km || '' %></textarea>
          </div>
        </div>
      </div>

      <!-- Right Sidebar Column: Publishing Metadata, Image Preview & Tags -->
      <aside class="cms-editor-side">
        <div class="cms-panel">
          <div class="cms-panel-head">
            <h2><i class="fas fa-paper-plane"></i> Publishing & Desk</h2>
          </div>
          <div class="form-group">
            <label><%= t('labels.category') %></label>
            <select name="category_id" class="form-control">
              <option value="">-- Select Desk --</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= c.id == article.category_id ? 'selected' : '' %>><%= c.name_en %> / <%= c.name_km %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label class="cms-checkbox-label">
              <input type="checkbox" name="is_featured" value="1" <%= article.is_featured ? 'checked' : '' %>>
              <strong>★ Pin as Front Page Lead / Featured</strong>
            </label>
          </div>

          <div class="cms-form-row-2">
            <div class="form-group">
              <label><%= t('labels.author') %></label>
              <input type="text" name="author_name" value="<%= article.author_name || 'Khmer News Desk' %>" class="form-control">
            </div>
            <div class="form-group">
              <label><%= t('labels.read_time') %></label>
              <input type="number" name="read_time_minutes" value="<%= article.read_time_minutes || 3 %>" class="form-control" min="1" max="60">
            </div>
          </div>

          <input type="hidden" name="card_template" value="<%= article.card_template || 'standard' %>">

          <div class="cms-editor-submit-row">
            <button type="submit" class="cms-btn cms-btn-primary" style="width:100%; justify-content:center;">
              <i class="fas fa-floppy-disk"></i> <%= t('labels.save') %> Dispatch
            </button>
            <a href="/admin/articles" class="cms-btn cms-btn-outline" style="width:100%; justify-content:center;">
              <%= t('labels.cancel') %>
            </a>
          </div>
        </div>

        <!-- LEAD PHOTO PANEL (LOCAL FILE UPLOAD + URL) -->
        <div class="cms-panel" style="margin-top: 20px;">
          <div class="cms-panel-head">
            <h2><i class="fas fa-camera"></i> Primary Lead Photo</h2>
          </div>
          
          <div class="cms-upload-type-bar">
            <button type="button" id="btnLeadFile" class="cms-upload-type-btn active" onclick="switchLeadUpload('file')">
              <i class="fas fa-upload"></i> Upload from Computer
            </button>
            <button type="button" id="btnLeadUrl" class="cms-upload-type-btn" onclick="switchLeadUpload('url')">
              <i class="fas fa-link"></i> Web Image URL
            </button>
          </div>

          <div id="leadFileBox" class="cms-dropzone-box" style="margin-top: 12px;">
            <label class="cms-dropzone-label" for="leadImageFile">
              <i class="fas fa-cloud-arrow-up" style="font-size: 1.8rem; color: var(--accent, #dc2626); margin-bottom: 6px;"></i>
              <span style="font-weight: 700; color: #0f172a; font-size: 0.85rem;">Click to browse or drag image here</span>
              <span style="font-size: 0.72rem; color: #64748b;">JPG, PNG, WEBP up to 15MB</span>
              <input type="file" name="lead_image_file" id="leadImageFile" accept="image/*" style="display:none;" onchange="previewLocalFile(this, 'editorImagePreview', 'leadFileNameDisplay')">
            </label>
            <div id="leadFileNameDisplay" class="cms-filename-pill" style="display:none;"></div>
          </div>

          <div id="leadUrlBox" class="form-group" style="margin-top: 12px; display: none;">
            <label><%= t('labels.image_url') %></label>
            <input type="text" name="image_url" id="editorImageUrl" value="<%= article.image_url || '' %>" class="form-control" placeholder="https://..." oninput="previewUrlInput(this, 'editorImagePreview')">
          </div>

          <div class="cms-img-preview-frame" style="margin-top: 12px;">
            <img id="editorImagePreview" src="<%= article.image_url || 'https://picsum.photos/seed/khmernews/800/450' %>" alt="Preview" onerror="this.onerror=null;this.src='https://picsum.photos/seed/khmernews/800/450';">
          </div>
        </div>

        <!-- MULTI-IMAGE STORY GALLERY (2-3 PHOTOS) -->
        <div class="cms-panel" style="margin-top: 20px;">
          <div class="cms-panel-head">
            <h2><i class="fas fa-images"></i> Multi-Image Gallery (2–3 Photos)</h2>
            <span style="font-size: 0.72rem; font-weight: 800; color: var(--accent, #dc2626);">Multi-Photo Story</span>
          </div>
          <p style="font-size: 0.78rem; line-height: 1.5; color: #64748b; margin: 0 0 14px;">
            Add 1 or 2 extra photos for this story. In the published news article, photos render as an editorial photo gallery with click-to-enlarge lightbox.
          </p>

          <!-- Photo 2 -->
          <div class="cms-gallery-slot-box" style="border: 1px solid #e2e8f0; padding: 12px; margin-bottom: 14px; background: #f8fafc;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <strong style="font-size: 0.78rem; text-transform: uppercase; color: #0f172a;"><i class="fas fa-image"></i> Photo 2 (Detail / In-Action)</strong>
              <% if (existingGallery[0]) { %><span class="cms-tag-featured" style="font-size:0.65rem;">Attached</span><% } %>
            </div>
            <input type="hidden" name="existing_gallery_1" value="<%= existingGallery[0] || '' %>">
            <div style="display: grid; gap: 6px;">
              <input type="file" name="gallery_file_1" accept="image/*" class="form-control" style="font-size: 0.76rem;" onchange="previewLocalFile(this, 'galleryPrev1')">
              <input type="text" name="gallery_url_1" value="<%= existingGallery[0] || '' %>" placeholder="Or paste Photo 2 URL https://..." class="form-control" style="font-size: 0.76rem;" oninput="previewUrlInput(this, 'galleryPrev1')">
            </div>
            <div class="cms-img-preview-frame" style="height: 100px; margin-top: 8px;">
              <img id="galleryPrev1" src="<%= existingGallery[0] || 'https://picsum.photos/seed/gallery1/600/350' %>" alt="Photo 2" onerror="this.onerror=null;this.src='https://picsum.photos/seed/gallery1/600/350';">
            </div>
          </div>

          <!-- Photo 3 -->
          <div class="cms-gallery-slot-box" style="border: 1px solid #e2e8f0; padding: 12px; background: #f8fafc;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <strong style="font-size: 0.78rem; text-transform: uppercase; color: #0f172a;"><i class="fas fa-image"></i> Photo 3 (Specs / Diagram)</strong>
              <% if (existingGallery[1]) { %><span class="cms-tag-featured" style="font-size:0.65rem;">Attached</span><% } %>
            </div>
            <input type="hidden" name="existing_gallery_2" value="<%= existingGallery[1] || '' %>">
            <div style="display: grid; gap: 6px;">
              <input type="file" name="gallery_file_2" accept="image/*" class="form-control" style="font-size: 0.76rem;" onchange="previewLocalFile(this, 'galleryPrev2')">
              <input type="text" name="gallery_url_2" value="<%= existingGallery[1] || '' %>" placeholder="Or paste Photo 3 URL https://..." class="form-control" style="font-size: 0.76rem;" oninput="previewUrlInput(this, 'galleryPrev2')">
            </div>
            <div class="cms-img-preview-frame" style="height: 100px; margin-top: 8px;">
              <img id="galleryPrev2" src="<%= existingGallery[1] || 'https://picsum.photos/seed/gallery2/600/350' %>" alt="Photo 3" onerror="this.onerror=null;this.src='https://picsum.photos/seed/gallery2/600/350';">
            </div>
          </div>
        </div>

        <div class="cms-panel" style="margin-top: 20px;">
          <div class="cms-panel-head">
            <h2><i class="fas fa-hashtag"></i> Topic Tags</h2>
          </div>
          <div class="cms-tag-selector">
            <% if (typeof allTags !== 'undefined' && allTags && allTags.length > 0) { %>
              <% allTags.forEach(function(tag) { %>
                <label class="cms-tag-check">
                  <input type="checkbox" name="tag_ids" value="<%= tag.id %>"
                    <%= (typeof articleTagIds !== 'undefined' && articleTagIds.indexOf(tag.id) !== -1) ? 'checked' : '' %>>
                  <span>#<%= tag.name_en %> / <%= tag.name_km %></span>
                </label>
              <% }) %>
            <% } %>
          </div>
        </div>
      </aside>
    </form>

    <script>
      function switchLeadUpload(mode) {
        var btnFile = document.getElementById('btnLeadFile');
        var btnUrl = document.getElementById('btnLeadUrl');
        var boxFile = document.getElementById('leadFileBox');
        var boxUrl = document.getElementById('leadUrlBox');
        if (mode === 'file') {
          btnFile.classList.add('active');
          btnUrl.classList.remove('active');
          boxFile.style.display = 'block';
          boxUrl.style.display = 'none';
        } else {
          btnUrl.classList.add('active');
          btnFile.classList.remove('active');
          boxUrl.style.display = 'block';
          boxFile.style.display = 'none';
        }
      }

      function previewLocalFile(input, previewId, nameDisplayId) {
        if (input.files && input.files[0]) {
          var file = input.files[0];
          var reader = new FileReader();
          reader.onload = function(e) {
            var img = document.getElementById(previewId);
            if (img) img.src = e.target.result;
          };
          reader.readAsDataURL(file);
          if (nameDisplayId) {
            var nameBox = document.getElementById(nameDisplayId);
            if (nameBox) {
              nameBox.style.display = 'inline-block';
              nameBox.innerHTML = '<i class="fas fa-file-image"></i> ' + file.name + ' (' + Math.round(file.size / 1024) + ' KB)';
            }
          }
        }
      }

      function previewUrlInput(input, previewId) {
        var val = input.value.trim();
        var img = document.getElementById(previewId);
        if (img && val) {
          img.src = val;
        }
      }
    </script>

  <% } else { %>
    <!-- FILTER & SEARCH TOOLBAR -->
    <div class="cms-filter-toolbar">
      <div class="cms-search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="cmsArticleSearch" placeholder="Filter by headline (Khmer or English), author, or ID...">
      </div>

      <select id="cmsCategoryFilter" class="cms-select">
        <option value="">All Editorial Desks</option>
        <% (categories || []).forEach(function(c) { %>
          <option value="<%= c.name_en %>"><%= c.name_en %> / <%= c.name_km %></option>
        <% }) %>
      </select>

      <div class="cms-status-tabs" id="cmsStatusTabs">
        <button type="button" data-status="all" class="cms-tab-btn active">All (<%= articles.length %>)</button>
        <button type="button" data-status="today" class="cms-tab-btn"><span class="live-pulse-dot"></span> Today Live</button>
        <button type="button" data-status="featured" class="cms-tab-btn">★ Featured Lead</button>
      </div>
    </div>

    <div class="cms-panel">
      <div class="cms-table-wrap">
        <table class="admin-table" id="cmsArticlesTable">
          <thead>
            <tr>
              <th style="width: 54px;">ID</th>
              <th style="width: 76px;">Photo</th>
              <th>Bilingual Headline (KM / EN)</th>
              <th>Desk</th>
              <th>Published</th>
              <th>Reads</th>
              <th>Lead ★</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (articles && articles.length > 0) { %>
              <% articles.forEach(function(a) { %>
                <% var fresh = isFreshToday(a.created_at); %>
                <tr data-desk="<%= a.category_name_en || '' %>"
                    data-featured="<%= a.is_featured ? '1' : '0' %>"
                    data-today="<%= fresh ? '1' : '0' %>">
                  <td><strong>#<%= a.id %></strong></td>
                  <td>
                    <img src="<%= a.image_url || ('https://picsum.photos/seed/news-' + a.id + '/800/450') %>" alt="" class="cms-table-thumb" loading="lazy" onerror="this.onerror=null;this.src='https://picsum.photos/seed/news-<%= a.id %>/800/450';">
                  </td>
                  <td>
                    <a href="/admin/articles/edit/<%= a.id %>" class="cms-table-title"><%= a.title_km %></a>
                    <div class="cms-table-subtitle"><%= a.title_en %></div>
                  </td>
                  <td>
                    <span class="cms-desk-pill"><%= a.category_name_en || 'Uncategorized' %></span>
                  </td>
                  <td>
                    <div class="cms-time-cell">
                      <% if (fresh) { %><span class="live-pulse-dot"></span><% } %>
                      <strong data-live-time="<%= a.created_at %>"><%= timeAgo(a.created_at) %></strong>
                    </div>
                    <div class="cms-date-sub"><%= String(a.created_at || '').slice(0, 16) %></div>
                  </td>
                  <td><strong><%= (a.views_count || 0).toLocaleString() %></strong></td>
                  <td>
                    <form method="POST" action="/admin/articles/toggle-featured/<%= a.id %>" style="margin:0;">
                      <button type="submit" class="cms-star-btn <%= a.is_featured ? 'is-active' : '' %>" title="Toggle Front Page Lead">
                        ★
                      </button>
                    </form>
                  </td>
                  <td style="text-align: right;">
                    <div class="cms-row-actions" style="justify-content: flex-end;">
                      <form method="POST" action="/admin/articles/bump/<%= a.id %>" style="margin:0;">
                        <button type="submit" class="cms-action-btn is-bump" title="Bump timestamp to Today Now">
                          <i class="fas fa-bolt"></i> Now
                        </button>
                      </form>
                      <a href="/admin/articles/edit/<%= a.id %>" class="cms-action-btn"><%= t('labels.edit') %></a>
                      <a href="/article/<%= a.slug %>" target="_blank" class="cms-action-btn" title="View Live">↗</a>
                      <a href="/admin/articles/delete/<%= a.id %>" class="cms-action-btn is-danger" onclick="return confirm('Delete this dispatch?')">
                        <i class="fas fa-trash"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="8"><%= t('common.no_articles') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var searchInput = document.getElementById('cmsArticleSearch');
        var catSelect = document.getElementById('cmsCategoryFilter');
        var statusBtns = document.querySelectorAll('#cmsStatusTabs .cms-tab-btn');
        var rows = document.querySelectorAll('#cmsArticlesTable tbody tr[data-desk]');
        var activeStatus = 'all';

        function applyFilters() {
          var q = (searchInput ? searchInput.value : '').toLowerCase().trim();
          var cat = catSelect ? catSelect.value : '';
          rows.forEach(function(row) {
            var text = row.textContent.toLowerCase();
            var rowDesk = row.getAttribute('data-desk') || '';
            var isFeat = row.getAttribute('data-featured') === '1';
            var isToday = row.getAttribute('data-today') === '1';

            var matchQ = !q || text.indexOf(q) !== -1;
            var matchCat = !cat || rowDesk === cat;
            var matchStatus = activeStatus === 'all' ||
              (activeStatus === 'featured' && isFeat) ||
              (activeStatus === 'today' && isToday);

            row.style.display = (matchQ && matchCat && matchStatus) ? '' : 'none';
          });
        }

        if (searchInput) searchInput.addEventListener('input', applyFilters);
        if (catSelect) catSelect.addEventListener('change', applyFilters);
        statusBtns.forEach(function(btn) {
          btn.addEventListener('click', function() {
            statusBtns.forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            activeStatus = btn.getAttribute('data-status') || 'all';
            applyFilters();
          });
        });
      });
    </script>
  <% } %>
</div>
