      ];
    } else if (tpl === 'magazine') {
      blocks = [
        { id: "b-hero", type: "hero", title_km: "ទស្សនាវដ្តីព័ត៌មាន", title_en: "Editorial Magazine", style: "", enabled: true, limit: 2 },
        { id: "b-cat-tech", type: "category", category_id: 4, title_km: "បច្ចេកវិទ្យា", title_en: "Technology", style: "grid_2_col", enabled: true, limit: 4 },
        { id: "b-newsletter", type: "newsletter", title_km: "ជាវព័ត៌មានប្រចាំថ្ងៃ", title_en: "Daily Newsletter", enabled: true },
        { id: "b-ad-bottom", type: "ad_slot", title_km: "ផ្ទាំងពាណិជ្ជកម្មខាងក្រោម", title_en: "Bottom Banner", position_slot: "homepage_bottom_banner", enabled: true }
      ];
    } else if (tpl === 'compact') {
      blocks = [
        { id: "b-hero", type: "hero", title_km: "ព័ត៌មានលេចធ្លោ", title_en: "Featured Carousel", style: "", enabled: true, limit: 5 },
        { id: "b-ticker", type: "ticker", title_km: "ព័ត៌មានចុងក្រោយ", title_en: "Latest Headlines", enabled: true, limit: 10 },
        { id: "b-headlines", type: "headlines", title_km: "កំពូលព័ត៌មាន", title_en: "Top 10 Headlines", enabled: true, limit: 10 },
        { id: "b-tags", type: "tags", title_km: "ស្លាកព័ត៌មានពេញនិយម", title_en: "Popular Tags", enabled: true, limit: 20 },
        { id: "b-newsletter", type: "newsletter", title_km: "ជាវព័ត៌មានប្រចាំថ្ងៃ", title_en: "Daily Newsletter", enabled: true }
      ];
    } else if (tpl === 'tech') {
      blocks = [
        { id: "b-hero", type: "hero", title_km: "ព័ត៌មានបច្ចេកវិទ្យា", title_en: "Tech Highlights", style: "", enabled: true, limit: 5 },
        { id: "b-cat-tech", type: "category", category_id: 4, title_km: "បច្ចេកវិទ្យា", title_en: "Technology", style: "grid_3_col", enabled: true, limit: 6 },
        { id: "b-headlines", type: "headlines", title_km: "កំពូលព័ត៌មាន", title_en: "Top Headlines", enabled: true, limit: 8 },
        { id: "b-tags", type: "tags", title_km: "ស្លាកព័ត៌មានពេញនិយម", title_en: "Popular Tags", enabled: true, limit: 20 },
        { id: "b-ad-bottom", type: "ad_slot", title_km: "ផ្ទាំងពាណិជ្ជកម្មខាងក្រោម", title_en: "Bottom Banner", position_slot: "homepage_bottom_banner", enabled: true }
      ];
    } else if (tpl === 'economy') {
      blocks = [
        { id: "b-hero", type: "hero", title_km: "សេដ្ឋកិច្ចប្រចាំថ្ងៃ", title_en: "Economy Today", style: "", enabled: true, limit: 2 },
        { id: "b-stats", type: "stats", title_km: "ស្ថិតិព័ត៌មាន", title_en: "Site Stats", enabled: true },
        { id: "b-cat-economy", type: "category", category_id: 5, title_km: "សេដ្ឋកិច្ច", title_en: "Economy & Business", style: "featured_top", enabled: true, limit: 7 },
        { id: "b-headlines", type: "headlines", title_km: "កំពូលព័ត៌មាន", title_en: "Top Headlines", enabled: true, limit: 8 },
        { id: "b-newsletter", type: "newsletter", title_km: "ជាវព័ត៌មានប្រចាំថ្ងៃ", title_en: "Daily Newsletter", enabled: true }
      ];
    } else if (tpl === 'minimal') {
      blocks = [
        { id: "b-hero", type: "hero", title_km: "ព័ត៌មានលេចធ្លោ", title_en: "Featured Story", style: "", enabled: true, limit: 1 },
        { id: "b-cat-national", type: "category", category_id: 1, title_km: "ព័ត៌មានជាតិ", title_en: "National News", style: "list_view", enabled: true, limit: 5 },
        { id: "b-headlines", type: "headlines", title_km: "កំពូលព័ត៌មាន", title_en: "Top Headlines", enabled: true, limit: 10 },
        { id: "b-tags", type: "tags", title_km: "ស្លាកព័ត៌មានពេញនិយម", title_en: "Popular Tags", enabled: true, limit: 20 }
      ];
    }
    blocksByPage.home = blocks;
    switchPage('home');
    scheduleSave();
    showToast('<i class="fas fa-bolt"></i> Template applied to the homepage — saved automatically');
  }

  var saveTimer = null;

  function scheduleSave() {
    if (saveTimer) clearTimeout(saveTimer);
    saveTimer = setTimeout(saveAllBlocks, 350);
  }

  function showToast(msg, isError) {
    var t = document.getElementById('builderToast');
    if (!t) {
      t = document.createElement('div');
      t.id = 'builderToast';
      document.body.appendChild(t);
    }
    t.innerHTML = msg;
    t.style.background = isError ? '#b91c1c' : '#166534';
    t.style.opacity = '1';
    clearTimeout(showToast._timer);
    showToast._timer = setTimeout(function () { t.style.opacity = '0'; }, 2400);
  }

  function saveAllBlocks() {
    if (saveTimer) { clearTimeout(saveTimer); saveTimer = null; }
    return fetch('/admin/layout/blocks/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ blocks: blocks, page: currentPage })
    })
    .then(function (res) { return res.json(); })
    .then(function (data) {
      if (data.success) showToast('<i class="fas fa-check"></i> Layout saved automatically');
      else showToast('<i class="fas fa-xmark"></i> Failed to save layout', true);
      return data;
    })
    .catch(function () { showToast('<i class="fas fa-xmark"></i> Failed to save layout', true); });
  }

  // ---- Theme tab auto-save: changes publish to the site immediately ----
  var themeSaveTimer = null;
  function scheduleThemeSave() {
    if (themeSaveTimer) clearTimeout(themeSaveTimer);
    themeSaveTimer = setTimeout(saveThemeSettings, 600);
  }
  function saveThemeSettings() {
    if (themeSaveTimer) { clearTimeout(themeSaveTimer); themeSaveTimer = null; }
    var form = document.querySelector('#themeStudioSection form');
    if (!form) return Promise.resolve();
    var data = new URLSearchParams(new FormData(form));
    return fetch('/admin/layout/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
      body: data.toString()
    })
    .then(function (res) { return res.json().catch(function () { return { success: false }; }); })
    .then(function (d) {
      if (d && d.success) showToast('<i class="fas fa-check"></i> Theme saved — applied to your site');
      else showToast('<i class="fas fa-xmark"></i> Failed to save theme', true);
    })
    .catch(function () { showToast('<i class="fas fa-xmark"></i> Failed to save theme', true); });
  }
  function themeChanged() {
    refreshThemePreview();
    scheduleThemeSave();
  }

  function switchTab(tab) {
    document.getElementById('blocksStudioSection').style.display = tab === 'blocks' ? 'block' : 'none';
    document.getElementById('themeStudioSection').style.display = tab === 'theme' ? 'block' : 'none';
    document.getElementById('tabBlocksBtn').className = 'studio-tab ' + (tab === 'blocks' ? 'active' : '');
    document.getElementById('tabThemeBtn').className = 'studio-tab ' + (tab === 'theme' ? 'active' : '');
  }

  function setPrimary(color) {
    document.getElementById('primaryColorPicker').value = color;
    document.getElementById('primaryColorText').value = color;
    themeChanged();
  }

  function setHeroStyle(value) {
    var sel = document.getElementById('heroStyleSelect');
    if (sel) sel.value = value;
    themeChanged();
  }

  // ---- Live theme preview ----
  function refreshThemePreview() {
    var stage = document.getElementById('pvStage');
    if (!stage) return;

    var primary = (document.getElementById('primaryColorPicker') || {}).value || '#1e3a8a';
    var accent = (document.getElementById('accentColorPicker') || {}).value || '#dc2626';
    stage.style.setProperty('--pv-primary', primary);
    stage.style.setProperty('--pv-accent', accent);

    // Hero style swap
    var heroSel = document.getElementById('heroStyleSelect');
    var heroStyle = heroSel ? heroSel.value : 'grid_3';
    document.querySelectorAll('.pv-hero-v').forEach(function (el) {
      el.style.display = el.getAttribute('data-v') === heroStyle ? 'flex' : 'none';
    });

    // Ticker style swap
    var tickerSel = document.getElementById('tickerStyleSelect');
    var tickerStyle = tickerSel ? tickerSel.value : 'marquee';
    document.querySelectorAll('.pv-ticker-v').forEach(function (el) {
      el.style.display = el.getAttribute('data-v') === tickerStyle ? 'flex' : 'none';
    });

    // Breaking news bar
    var breakingChk = document.querySelector('input[name="breaking_news_enabled"]');
    var breakingBar = document.getElementById('pvBreaking');
    if (breakingBar && breakingChk) {
      breakingBar.style.display = breakingChk.checked ? 'flex' : 'none';
    }
    var txtKm = document.querySelector('input[name="breaking_news_text_km"]');
    var txtEn = document.querySelector('input[name="breaking_news_text_en"]');
    var bt = document.getElementById('pvBreakingText');
    if (bt) {
      bt.textContent = (txtKm && txtKm.value.trim()) || (txtEn && txtEn.value.trim()) || 'Live breaking news updates';
    }

    // Custom CSS injection (scoped to the preview so it can be tested live)
    var css = document.querySelector('textarea[name="custom_css"]');
    var styleEl = document.getElementById('pvCustomCss');
    if (css && styleEl) styleEl.textContent = css.value || '';
  }

  function setTheme(primary, accent) {
    var p = document.getElementById('primaryColorPicker');
    var a = document.getElementById('accentColorPicker');
    if (p) p.value = primary;
    if (a) a.value = accent;
    themeChanged();
    showToast('<i class="fas fa-palette"></i> Theme palette applied — auto-saved to your site');
  }

  function applyThemeDefaultsToBlocks() {
    var heroSel = document.getElementById('heroStyleSelect');
    var tickerSel = document.getElementById('tickerStyleSelect');
    var changed = 0;
    blocks.forEach(function (b) {
      if (b.type === 'hero' || b.type === 'ticker') {
        if (b.style) { b.style = ''; changed++; }
      }
    });
    renderBlocks();
    scheduleSave();
    refreshThemeOverrideNotice();
    showToast(changed > 0 ? ('<i class="fas fa-bolt"></i> Cleared ' + changed + ' block override(s) — theme style now applies everywhere') : '<i class="fas fa-check"></i> All blocks already follow the theme setting');
  }

  function refreshThemeOverrideNotice() {
    var notice = document.getElementById('themeOverrideNotice');
    if (!notice) return;
    var overrides = blocks.filter(function (b) { return (b.type === 'hero' || b.type === 'ticker') && b.style; });
    if (overrides.length > 0) {
      notice.style.display = 'block';
      notice.innerHTML = '<i class="fas fa-triangle-exclamation"></i> <strong>' + overrides.length + ' block(s)</strong> on your homepage have their own pinned style and will <strong>ignore this theme default</strong> until set to "Follow Theme Setting". Click the green button below to clear them.';
    } else {
      notice.style.display = 'none';
    }
  }

  function saveCurrentAsTemplate() {
    if (!blocks || blocks.length === 0) { showToast('Add some blocks first', true); return; }
    var name = prompt('Name this custom layout template:');
    if (!name || !name.trim()) return;
    var payload = { name: name.trim(), blocks: blocks, page: currentPage };
    fetch('/admin/layout/templates/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.success) {
        customTemplates = data.templates || [];
        renderCustomTemplates();
        showToast('<i class="fas fa-folder-tree"></i> Template "' + name.trim() + '" saved');
      } else {
        showToast(data.error || 'Failed to save template', true);
      }
    });
  }

  function applyCustomTemplate(name) {
    var t = customTemplates.find(function (x) { return x.name === name && (x.page || 'home') === currentPage; });
    if (!t) { showToast('Template not found', true); return; }
    if (!confirm('Apply custom layout "' + name + '"? This replaces your current block arrangement.')) return;
    var tplPage = t.page || 'home';
    blocksByPage[tplPage] = JSON.parse(JSON.stringify(t.blocks));
    switchPage(tplPage);
    scheduleSave();
    showToast('<i class="fas fa-folder-tree"></i> Custom layout "' + name + '" applied — saved automatically');
  }

  function deleteCustomTemplate(name) {
    if (!confirm('Delete custom layout "' + name + '"?')) return;
    fetch('/admin/layout/templates/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, page: currentPage })
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.success) {
        customTemplates = data.templates || [];
        renderCustomTemplates();
        showToast('<i class="fas fa-trash"></i> Template "' + name + '" deleted');
      }
    });
  }

  function renderCustomTemplates() {
    var list = document.getElementById('customTemplatesList');
    if (!list) return;
    var pageLabel = currentPage === 'category' ? 'category' : (currentPage === 'article' ? 'article' : 'homepage');
    var mine = customTemplates.filter(function (t) { return (t.page || 'home') === currentPage; });
    if (mine.length === 0) {
      list.innerHTML = '<span style="font-size: 0.82rem; color: rgba(255,255,255,0.55);">No custom ' + pageLabel + ' layouts saved yet — click "Save Current Layout as Template" to create your first one.</span>';
      return;
    }
    list.innerHTML = '';
    mine.forEach(function (t) {
      var card = document.createElement('div');
      card.className = 'custom-tpl-card';
      card.style.cssText = 'background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; padding: 12px 14px; display: flex; align-items: center; gap: 10px;';
      var safeName = t.name.replace(/'/g, "\\'");
      card.innerHTML = '<span style="font-size: 1rem;"><i class="fas fa-folder-tree"></i></span>' +
        '<span style="font-size: 0.88rem; font-weight: 700; color: #ffffff;">' + t.name + '</span>' +
        '<span style="font-size: 0.72rem; color: rgba(255,255,255,0.6);">' + (t.blocks || []).length + ' blocks</span>' +
        '<button type="button" onclick="applyCustomTemplate(\'' + safeName + '\')" style="background: #2563eb; border: none; color: #fff; padding: 5px 12px; border-radius: 6px; font-size: 0.78rem; font-weight: 700; cursor: pointer;">Apply</button>' +
        '<button type="button" onclick="deleteCustomTemplate(\'' + safeName + '\')" style="background: transparent; border: 1px solid rgba(248,113,113,0.6); color: #fca5a5; padding: 5px 10px; border-radius: 6px; font-size: 0.78rem; cursor: pointer;"><i class="fas fa-xmark"></i></button>';
      list.appendChild(card);
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    if (activeTab === 'theme') switchTab('theme');
    refreshThemeOverrideNotice();
    renderBlocks();

    // Live preview event wiring — every change also auto-saves
    ['primaryColorPicker', 'accentColorPicker', 'heroStyleSelect', 'tickerStyleSelect'].forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('change', themeChanged);
      if (el.type === 'color') el.addEventListener('input', themeChanged);
    });
    document.querySelectorAll('input[name="breaking_news_enabled"], input[name="breaking_news_text_km"], input[name="breaking_news_text_en"], textarea[name="custom_css"]').forEach(function (el) {
      el.addEventListener('input', themeChanged);
      el.addEventListener('change', themeChanged);
    });

    refreshThemePreview();
  });
</script>
