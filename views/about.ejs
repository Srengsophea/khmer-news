    font-weight: 800;
    line-height: 1.45;
    margin: 0 0 6px;
  }
  .about-desk-latest-title a {
    color: var(--ink, #0f172a);
    text-decoration: none;
  }
  .about-desk-latest-title a:hover {
    color: var(--accent, #dc2626);
  }
  .about-desk-latest-time {
    font-size: 0.75rem;
    color: var(--ink-muted, #64748b);
  }

  /* Section 5: 4-Column Code of Ethics */
  .about-ethics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 2px solid var(--ink, #0f172a);
    padding-bottom: 32px;
    margin-bottom: 52px;
  }
  .about-ethic-col {
    padding: 0 22px;
    border-right: 1px solid var(--rule-light, #e2e8f0);
  }
  .about-ethic-col:first-child {
    padding-left: 0;
  }
  .about-ethic-col:last-child {
    border-right: none;
    padding-right: 0;
  }
  .about-ethic-num {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: var(--accent, #dc2626);
    margin-bottom: 8px;
  }
  .about-ethic-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.08rem;
    font-weight: 800;
    color: var(--ink, #0f172a);
    margin: 0 0 10px;
  }
  .about-ethic-text {
    font-size: 0.88rem;
    line-height: 1.68;
    color: var(--ink-soft, #334155);
    margin: 0;
  }

  /* Section 6: Editorial Masthead & Leadership Grid */
  .about-leadership-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px 24px;
    margin-bottom: 52px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--rule-light, #e2e8f0);
  }
  .about-leader-item {
    border-top: 2px solid var(--ink, #0f172a);
    padding-top: 14px;
  }
  .about-leader-role {
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent, #dc2626);
    margin-bottom: 4px;
  }
  .about-leader-name {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.12rem;
    font-weight: 900;
    color: var(--ink, #0f172a);
    margin: 0 0 8px;
  }
  .about-leader-bio {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--ink-soft, #334155);
    margin: 0 0 10px;
  }
  .about-leader-email {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--ink-muted, #64748b);
    text-decoration: none;
  }
  .about-leader-email:hover {
    color: var(--accent, #dc2626);
  }

  /* Section 7: Bureaus, Press & Contact Strip */
  .about-bureaus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 3px double var(--ink, #0f172a);
    padding-bottom: 32px;
  }
  .about-bureau-col {
    padding: 0 26px;
    border-right: 1px solid var(--rule-light, #e2e8f0);
  }
  .about-bureau-col:first-child {
    padding-left: 0;
  }
  .about-bureau-col:last-child {
    border-right: none;
    padding-right: 0;
  }
  .about-bureau-col h3 {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.12rem;
    font-weight: 800;
    margin: 0 0 10px;
    color: var(--ink, #0f172a);
  }
  .about-bureau-col p {
    font-size: 0.88rem;
    line-height: 1.68;
    color: var(--ink-soft, #334155);
    margin: 0 0 12px;
  }
  .about-bureau-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--ink-soft, #334155);
  }
  .about-cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 12px;
  }
  .about-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    border: 1.5px solid var(--ink, #0f172a);
    color: var(--ink, #0f172a);
    transition: all 0.15s;
  }
  .about-cta-btn.is-primary {
    background: var(--accent, #dc2626);
    border-color: var(--accent, #dc2626);
    color: #fff;
  }
  .about-cta-btn:hover {
    background: var(--ink, #0f172a);
    color: #fff;
    border-color: var(--ink, #0f172a);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .about-metrics-strip {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px 0;
    }
    .about-story-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .about-story-main {
      padding-right: 0;
      border-right: none;
    }
    .about-story-side {
      padding-left: 0;
      border-top: 1px solid var(--rule-light, #e2e8f0);
      padding-top: 28px;
    }
    .about-desk-row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .about-desk-latest {
      border-left: none;
      padding-left: 0;
      border-top: 1px dotted var(--rule-light, #cbd5e1);
      padding-top: 12px;
    }
    .about-ethics-grid,
    .about-leadership-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .about-ethic-col {
      padding: 0;
      border-right: none;
    }
    .about-bureaus-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .about-bureau-col {
      padding: 0;
      border-right: none;
      border-bottom: 1px solid var(--rule-light, #e2e8f0);
      padding-bottom: 20px;
    }
  }
  @media (max-width: 640px) {
    .about-metrics-strip,
    .about-pillars-3col,
    .about-ethics-grid,
    .about-leadership-grid {
      grid-template-columns: 1fr;
    }
    .about-metric-col {
      padding: 10px 0;
      border-right: none;
      border-bottom: 1px solid var(--rule-light, #e2e8f0);
    }
  }
</style>

