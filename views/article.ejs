<section class="section">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/"><%= t('nav.home') %></a> &rarr;
      <a href="/category/<%= article.category_slug %>"><%= article[`category_name_${lang}`] %></a> &rarr;
      <span><%= article[`title_${lang}`].substring(0, 50) %>...</span>
    </nav>

    <div class="content-layout">
      <div class="main-column">
        <article class="article-detail">
          <div class="article-header">
            <span class="article-category badge-cat-<%= article.category_slug %>"><%= article[`category_name_${lang}`] %></span>
            <h1 class="article-title"><%= article[`title_${lang}`] %></h1>
            
            <div class="article-meta-row" style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding: 12px 0; border-top: 1px solid #f1f5f9; border-bottom: 1px solid #f1f5f9; margin-top: 16px; font-size: 0.9rem; color: #64748b;">
              <span>✍️ <strong><%= article.author_name || 'Khmer News Desk' %></strong></span>
              <span>📅 <%= new Date(article.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
              <span>⏱️ <%= article.read_time_minutes || 3 %> <%= lang === 'km' ? 'នាទីអាន' : 'min read' %></span>
              <span>👁️ <%= article.views_count || 1 %> <%= lang === 'km' ? 'ការទស្សនា' : 'views' %></span>
            </div>

            <!-- Social Share Bar -->
            <div class="share-toolbar" style="display: flex; align-items: center; gap: 12px; margin: 16px 0;">
              <span style="font-weight: 700; font-size: 0.85rem; color: #475569;"><%= lang === 'km' ? 'ចែករំលែក៖' : 'Share:' %></span>
              <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('http://localhost:3000/article/' + article.slug) %>" target="_blank" class="share-btn share-fb" style="background: #1877f2; color: white; padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; text-decoration: none;">Facebook</a>
              <a href="https://t.me/share/url?url=<%= encodeURIComponent('http://localhost:3000/article/' + article.slug) %>&text=<%= encodeURIComponent(article[`title_${lang}`]) %>" target="_blank" class="share-btn share-tg" style="background: #229ed9; color: white; padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; text-decoration: none;">Telegram</a>
              <button type="button" onclick="navigator.clipboard.writeText(window.location.href); alert('<%= lang === 'km' ? 'បានចម្លងតំណភ្ជាប់!' : 'Link copied to clipboard!' %>');" class="share-btn share-copy" style="background: #e2e8f0; color: #1e293b; border: none; padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; cursor: pointer;">📋 Copy Link</button>
            </div>
          </div>

          <img src="<%= article.image_url %>" alt="<%= article[`title_${lang}`] %>" class="article-hero-img">

          <div class="article-body">
            <div class="article-content">
              <%- article[`content_${lang}`] %>
            </div>

            <!-- DYNAMIC AD SLOT: Inline Article Ad -->
            <% if (typeof getAd === 'function') { %>
              <% var inlineAd = getAd('article_inline') || getAd('inline'); %>
              <% if (inlineAd) { %>
                <div class="inline-ad-banner" style="margin: 32px 0; text-align: center;">
                  <% if (inlineAd.ad_type === 'html' && inlineAd.html_code) { %>
                    <%- inlineAd.html_code %>
                  <% } else { %>
                    <a href="<%= inlineAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= inlineAd.id %>', {method:'POST'})">
                      <img src="<%= inlineAd.image_url %>" alt="<%= inlineAd.title %>" style="max-height: 140px; border-radius: 8px; border: 1px solid #e2e8f0; width: 100%; object-fit: contain;">
                    </a>
                  <% } %>
                </div>
              <% } %>
            <% } %>

            <!-- DYNAMIC AD SLOT: Article Bottom Ad -->
            <% if (typeof getAd === 'function') { %>
              <% var bottomAd = getAd('article_bottom'); %>
              <% if (bottomAd) { %>
                <div class="article-bottom-ad" style="margin-top: 24px; text-align: center;">
                  <% if (bottomAd.ad_type === 'html' && bottomAd.html_code) { %>
                    <%- bottomAd.html_code %>
                  <% } else { %>
                    <a href="<%= bottomAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= bottomAd.id %>', {method:'POST'})">
                      <img src="<%= bottomAd.image_url %>" alt="<%= bottomAd.title %>" style="max-height: 120px; border-radius: 8px; border: 1px solid #e2e8f0; width: 100%; object-fit: contain;">
                    </a>
                  <% } %>
                </div>
              <% } %>
            <% } %>

          </div>
        </article>
      </div>

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-widget">
          <h3 class="widget-title">📂 <%= t('admin.categories') %></h3>
          <ul class="category-list">
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(function(c) { %>
                <li class="category-item">
                  <a href="/category/<%= c.slug %>">
                    <span>📰</span>
                    <span><%= c[`name_${lang}`] %></span>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </div>

        <!-- DYNAMIC AD SLOT: Sidebar Ad -->
        <% if (typeof getAd === 'function') { %>
          <% var sidebarAd = getAd('sidebar'); %>
          <% if (sidebarAd) { %>
            <div class="sidebar-widget ad-widget" style="padding: 12px; display: flex; justify-content: center; overflow: hidden; text-align: center;">
              <% if (sidebarAd.ad_type === 'html' && sidebarAd.html_code) { %>
                <%- sidebarAd.html_code %>
              <% } else { %>
                <a href="<%= sidebarAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= sidebarAd.id %>', {method:'POST'})">
                  <img src="<%= sidebarAd.image_url %>" alt="<%= sidebarAd.title %>" style="width: 100%; border-radius: 8px; border: 1px solid #e2e8f0; max-height: 280px; object-fit: cover;">
                </a>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </aside>
    </div>
  </div>
</section>

<section class="related-section" style="background: #f8fafc; padding: 48px 0; border-top: 1px solid #e2e8f0;">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title"><%= lang === 'km' ? 'ព័ត៌មានទាក់ទង' : 'Related Articles' %></h2>
    </div>
    <div class="related-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
      <% if (articles && articles.length > 0) { %>
        <% articles.forEach(function(a) { %>
          <article class="card-template-standard">
            <a href="/article/<%= a.slug %>">
              <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>" class="article-card-img">
            </a>
            <div class="article-card-body">
              <div class="article-card-meta">
                <span class="article-card-category badge-cat-<%= a.category_slug %>"><%= a[`category_name_${lang}`] %></span>
                <span class="article-card-date">&bull; <%= new Date(a.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
              </div>
              <h3 class="article-card-title">
                <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
              </h3>
              <div class="article-card-footer">
                <a href="/article/<%= a.slug %>" class="read-more"><%= t('common.read_more') %> &rarr;</a>
              </div>
            </div>
          </article>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>

<script>
  // Reading progress bar calculation
  window.addEventListener('scroll', function() {
    var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    var scrolled = (winScroll / height) * 100;
    var bar = document.getElementById('readingProgress');
    if (bar) {
      bar.style.width = scrolled + '%';
    }
  });
</script>
