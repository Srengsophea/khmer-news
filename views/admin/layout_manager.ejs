    btn.textContent = '＋ Insert block here';
    btn.onclick = function () { toggleInsertMenu(idx); };
    var menu = document.createElement('div');
    menu.className = 'insert-menu';
    menu.id = 'insertMenu' + idx;
    menu.style.display = 'none';
    BLOCK_TYPES.forEach(function (bt) {
      var item = document.createElement('button');
      item.type = 'button';
      item.className = 'insert-menu-item';
      item.title = 'Add ' + bt.label;
      item.innerHTML = '<i class="fas ' + bt.icon + '"></i> ' + bt.label;
      item.onclick = function () { insertBlock(idx, bt.type); };
      menu.appendChild(item);
    });
    zone.appendChild(btn);
    zone.appendChild(menu);
    return zone;
  }

  function toggleInsertMenu(idx) {
    var menu = document.getElementById('insertMenu' + idx);
    if (!menu) return;
    var isOpen = menu.style.display !== 'none';
