<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> | <%= (typeof siteSettings !=='undefined' && siteSettings && siteSettings.site_name_en) || 'Khmer News'
        %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Koh+Santepheap:wght@300;400;700;900&family=Noto+Sans+Khmer:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <script>
    // Apply dark mode before first paint to avoid flash
    (function () {
      try {
        var stored = localStorage.getItem('khmer-news-dark-mode');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var dark = stored === null ? prefersDark : (stored === '1');
        if (dark) {
          document.documentElement.classList.add('dark-mode');
        }
      } catch (e) {}
    })();
  </script>

  <style>
    :root {
      --primary-color: <%=(typeof siteSettings !=='undefined' && siteSettings && siteSettings.primary_color) ? siteSettings.primary_color: '#1e3a8a' %>;
      --accent-color: <%=(typeof siteSettings !=='undefined' && siteSettings && siteSettings.accent_color) ? siteSettings.accent_color: '#dc2626' %>;
    }

    <% if (typeof siteSettings !=='undefined' && siteSettings && siteSettings.custom_css) {
      %><%- siteSettings.custom_css %><%
    }

    %>
  </style>
</head>

<body>
  <div id="readingProgress" class="reading-progress"></div>
  <div class="nav-overlay" id="navOverlay"></div>

  <div class="top-bar">
    <div class="container">
      <div class="top-links">
        <span id="currentDate"></span>
        <a href="/about">
          <%= t('nav.about') %>
        </a>
      </div>
      <div class="top-links">
        <button id="darkModeToggle" class="dark-mode-toggle" aria-label="Toggle dark mode" title="Toggle dark mode"><i class="fas fa-moon"></i></button>
        <span>
          <%= t('common.language') %>:
        </span>
        <select id="langSwitcher" class="lang-select">
          <option value="km" <%=lang==='km' ? 'selected' : '' %>>ខ្មែរ</option>
          <option value="en" <%=lang==='en' ? 'selected' : '' %>>English</option>
        </select>
      </div>
    </div>
  </div>

  <header class="site-header">
    <div class="container">
      <!-- HEADER ROW 1: BRAND LOGO + AD BANNER -->
      <div class="header-brand-ad-row">
        <a href="/" class="brand">
          <img src="/images/khmer-new-logo.png" alt="Khmer News Logo" class="brand-logo-img">
          <div class="brand-title-group">
            <span class="brand-main">
              <% if (typeof siteSettings !== 'undefined' && siteSettings) { %>
                <% var siteName = lang === 'km' ? (siteSettings.site_name_km || 'ខ្មែរញូស៍') : (siteSettings.site_name_en || 'Khmer News'); %>
                <%- siteName.replace(/News/gi, '<span class="brand-accent">News</span>').replace(/ញូស៍/g, '<span class="brand-accent">ញូស៍</span>') %>
              <% } else { %>
                Khmer<span class="brand-accent">News</span>
              <% } %>
            </span>
            <span class="brand-sub">
              <%= lang === 'km' ? 'ព័ត៌មានទាន់ហេតុការណ៍ ២៤/៧' : 'BREAKING NEWS 24/7' %>
            </span>
          </div>
        </a>

        <% if (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.header_banner_ad_enabled && typeof getAd === 'function') { %>
          <% var headerTopAd = getAd('header_top') || getAd('header'); %>
          <% if (headerTopAd) { %>
            <div class="header-ad-frame">
              <% if (headerTopAd.ad_type === 'html' && headerTopAd.html_code) { %>
                <%- headerTopAd.html_code %>
              <% } else { %>
                <a href="<%= headerTopAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= headerTopAd.id %>', {method:'POST'})">
                  <img src="<%= headerTopAd.image_url %>" alt="<%= headerTopAd.title %>" class="header-ad-img">
                </a>
              <% } %>
            </div>
          <% } %>
        <% } %>

        <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- HEADER ROW 2: STICKY NAVIGATION BAR (DESKTOP) -->
    <nav class="header-nav-row" id="desktopNavRow">
      <div class="container nav-row-container">
        <ul class="nav-links">
          <li><a href="/" class="nav-link <%= title === 'Khmer News' ? 'active' : '' %>"><%= t('nav.home') %></a></li>
          <% if (typeof categories !== 'undefined' && categories) { categories.forEach(function(c) { %>
            <li><a href="/category/<%= c.slug %>" class="nav-link"><%= c[`name_${lang}`] %></a></li>
          <% }) } %>
        </ul>

        <div class="nav-search-wrapper">
          <form action="/search" method="GET" class="search-form-inline">
            <input type="text" name="q" placeholder="<%= t('common.search_placeholder') %>" class="search-input-inline">
            <button type="submit" class="search-btn"><%= t('nav.search') %></button>
          </form>
        </div>
      </div>
    </nav>

    <!-- MOBILE SLIDE-OUT DRAWER SIDEBAR -->
    <div class="main-nav" id="mainNav">
      <div class="drawer-header">
        <div class="drawer-logo-title">
          <img src="/images/khmer-new-logo.png" alt="Khmer News Logo" style="height: 32px; width: auto; object-fit: contain;">
          <span class="brand-main" style="font-size: 1.25rem; font-weight: 900; line-height: 1;">Khmer<span class="brand-accent">News</span></span>
        </div>
        <button class="drawer-close" id="drawerClose" aria-label="Close menu">&times;</button>
      </div>

      <ul class="nav-links">
        <li><a href="/" class="nav-link <%= title === 'Khmer News' ? 'active' : '' %>"><%= t('nav.home') %></a></li>
        <% if (typeof categories !== 'undefined' && categories) { categories.forEach(function(c) { %>
          <li><a href="/category/<%= c.slug %>" class="nav-link"><%= c[`name_${lang}`] %></a></li>
        <% }) } %>
      </ul>

      <div class="nav-search-wrapper">
        <form action="/search" method="GET" class="search-form-inline">
          <input type="text" name="q" placeholder="<%= t('common.search_placeholder') %>" class="search-input-inline">
          <button type="submit" class="search-btn"><%= t('nav.search') %></button>
        </form>
      </div>
    </div>
  </header>

  <% if (typeof siteSettings !=='undefined' && siteSettings && (siteSettings.breaking_news_enabled==1 ||
    siteSettings.breaking_news_enabled===undefined)) { %>
    <div class="breaking-bar">
      <div class="container">
        <div class="breaking-inner">
          <span class="breaking-label">BREAKING <i class="fas fa-bolt"></i></span>
          <div class="breaking-marquee-track-container">
            <div class="breaking-marquee-track">
              <% var newsTxt='' ; %>
                <% if (lang==='km' && siteSettings.breaking_news_text_km) { %>
                  <% newsTxt=siteSettings.breaking_news_text_km; %>
                    <% } else if (lang==='en' && siteSettings.breaking_news_text_en) { %>
                      <% newsTxt=siteSettings.breaking_news_text_en; %>
                        <% } else if (typeof articles !=='undefined' && articles && articles.length> 0) { %>
                          <% newsTxt=articles.slice(0, 5).map(a=> a[`title_${lang}`]).join(' • '); %>
                            <% } else { %>
                              <% newsTxt=lang==='km' ? siteSettings.site_desc_km : siteSettings.site_desc_en; %>
                                <% } %>
                                  <span class="breaking-text-content">
                                    <%= newsTxt %> •
                                  </span>
                                  <span class="breaking-text-content" aria-hidden="true">
                                    <%= newsTxt %> •
                                  </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

      <main>
        <%- body %>
      </main>

      <footer class="site-footer">
        <div class="container">
          <div class="footer-grid">
            <div class="footer-col brand-col">
              <a href="/" class="brand footer-brand-logo" style="margin-bottom: 16px;">
                <span class="brand-main">
                  <% if (typeof siteSettings !=='undefined' && siteSettings) { %>
                    <% var siteName=lang==='km' ? (siteSettings.site_name_km || 'ខ្មែរញូស៍' ) :
                      (siteSettings.site_name_en || 'Khmer News' ); %>
                      <%- siteName.replace(/News/gi, '<span class="brand-accent">News</span>'
                        ).replace(/ញូស៍/g, '<span class="brand-accent">ញូស៍</span>' ) %>
                        <% } else { %>
                          Khmer<span class="brand-accent">News</span>
                          <% } %>
                </span>
                <span class="brand-sub">
                  <%= lang==='km' ? 'ព័ត៌មានថ្មីៗ' : 'LATEST NEWS' %>
                </span>
              </a>
              <p class="footer-desc">
                <% if (typeof siteSettings !=='undefined' && siteSettings) { %>
                  <%= lang==='km' ? siteSettings.site_desc_km : siteSettings.site_desc_en %>
                    <% } else { %>
                      <%= t('about.content') %>
                        <% } %>
              </p>
              <div class="footer-socials">
                <% if (typeof siteSettings !=='undefined' && siteSettings) { %>
                  <a href="<%= siteSettings.social_facebook || '#' %>" target="_blank" class="social-icon-img"
                    aria-label="Facebook">
                    <img src="/images/facebook.png" alt="Facebook"
                      style="width: 28px; height: 28px; object-fit: contain;">
                  </a>
                  <a href="<%= siteSettings.social_telegram || '#' %>" target="_blank" class="social-icon-img"
                    aria-label="Telegram">
                    <img src="/images/telegram.png" alt="Telegram"
                      style="width: 28px; height: 28px; object-fit: contain;">
                  </a>
                  <a href="<%= siteSettings.social_youtube || '#' %>" target="_blank" class="social-icon-img"
                    aria-label="YouTube">
                    <img src="/images/youtube.png" alt="YouTube"
                      style="width: 28px; height: 28px; object-fit: contain;">
                  </a>
                  <a href="#" target="_blank" class="social-icon-img" aria-label="Platform">
                    <img src="/images/logos.png" alt="Platform" style="width: 28px; height: 28px; object-fit: contain;">
                  </a>
                  <% } else { %>
                    <a href="#" class="social-icon-img" aria-label="Facebook">
                      <img src="/images/facebook.png" alt="Facebook"
                        style="width: 28px; height: 28px; object-fit: contain;">
                    </a>
                    <a href="#" class="social-icon-img" aria-label="Telegram">
                      <img src="/images/telegram.png" alt="Telegram"
                        style="width: 28px; height: 28px; object-fit: contain;">
                    </a>
                    <a href="#" class="social-icon-img" aria-label="YouTube">
                      <img src="/images/youtube.png" alt="YouTube"
                        style="width: 28px; height: 28px; object-fit: contain;">
                    </a>
                    <a href="#" class="social-icon-img" aria-label="Platform">
                      <img src="/images/logos.png" alt="Platform"
                        style="width: 28px; height: 28px; object-fit: contain;">
                    </a>
                    <% } %>
              </div>
            </div>
            <div class="footer-col">
              <h4>
                <%= t('nav.home') %>
              </h4>
              <ul class="footer-links">
                <li><a href="/">
                    <%= t('nav.home') %>
                  </a></li>
                <li><a href="/about">
                    <%= t('nav.about') %>
                  </a></li>
                <li><a href="/contact">Contact Us</a></li>
                <li><a href="/advertise">Advertise</a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h4>
                <%= t('admin.categories') %>
              </h4>
              <ul class="footer-links">
                <% if (typeof categories !=='undefined' && categories) { categories.forEach(c=> { %>
                  <li><a href="/category/<%= c.slug %>">
                      <%= c[`name_${lang}`] %>
                    </a></li>
                  <% }) } %>
              </ul>
            </div>
            <div class="footer-col newsletter-col">
              <h4>
                <%= t('newsletter.title') %>
              </h4>
              <p class="newsletter-desc">
                <%= t('newsletter.desc') %>
              </p>
              <form class="footer-newsletter-form js-newsletter-form" novalidate>
                <input type="email" placeholder="<%= t('newsletter.placeholder') %>" required class="newsletter-input js-newsletter-input">
                <button type="submit" class="newsletter-btn js-newsletter-btn">
                  <%= t('newsletter.subscribe') %>
                </button>
              </form>
              <p class="newsletter-msg js-newsletter-msg" style="display: none; margin-top: 8px; font-size: 0.85rem; font-weight: 600;"></p>
            </div>
          </div>

          <div class="footer-middle">
            <div class="contact-info-row">
              <% if (typeof siteSettings !=='undefined' && siteSettings) { %>
                <span><strong>Address:</strong>
                  <%= lang==='km' ? siteSettings.contact_address_km : siteSettings.contact_address_en %>
                </span>
                <span>&bull;</span>
                <span><strong>Phone:</strong>
                  <%= siteSettings.contact_phone %>
                </span>
                <span>&bull;</span>
                <span><strong>Email:</strong>
                  <%= siteSettings.contact_email %>
                </span>
                <% } else { %>
                  <span><strong>Address:</strong> Preah Monivong Blvd, Phnom Penh, Cambodia</span>
                  <span>&bull;</span>
                  <span><strong>Phone:</strong> +855 23 456 789</span>
                  <span>&bull;</span>
                  <span><strong>Email:</strong> info@khmernews.com</span>
                  <% } %>
            </div>
          </div>

          <div class="footer-bottom">
            <div class="footer-bottom-inner">
              <p>&copy; <%= new Date().getFullYear() %>
                  <%= (typeof siteSettings !=='undefined' && siteSettings && siteSettings.site_name_en) || 'Khmer News'
                    %>. All rights reserved.</p>
              <div class="footer-legal-links">
                <a href="/privacy">
                  <%= t('nav.privacy') %>
                </a>
                <a href="/terms">
                  <%= t('nav.terms') %>
                </a>
                <a href="/feed.xml" title="RSS Feed"><i class="fas fa-rss"></i> RSS</a>
              </div>
            </div>
          </div>
        </div>
      </footer>

      <button id="backToTop" class="back-to-top" aria-label="<%= t('common.back_to_top') %>" title="<%= t('common.back_to_top') %>">↑</button>

      <script src="/js/main.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          var switcher = document.getElementById('langSwitcher');
          if (switcher) {
            switcher.addEventListener('change', function () {
              var lang = this.value;
              window.location.href = '/change-lang/' + lang;
            });
          }

          var toggle = document.getElementById('menuToggle');
          var nav = document.getElementById('mainNav');
          var overlay = document.getElementById('navOverlay');
          var closeBtn = document.getElementById('drawerClose');

          function openMenu() {
            if (nav) nav.classList.add('open');
            if (toggle) toggle.classList.add('open');
            if (overlay) overlay.classList.add('open');
            document.body.classList.add('menu-open');
          }

          function closeMenu() {
            if (nav) nav.classList.remove('open');
            if (toggle) toggle.classList.remove('open');
            if (overlay) overlay.classList.remove('open');
            document.body.classList.remove('menu-open');
          }

          if (toggle) {
            toggle.addEventListener('click', function () {
              if (nav && nav.classList.contains('open')) {
                closeMenu();
              } else {
                openMenu();
              }
            });
          }

          if (overlay) overlay.addEventListener('click', closeMenu);
          if (closeBtn) closeBtn.addEventListener('click', closeMenu);

          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && nav && nav.classList.contains('open')) {
              closeMenu();
            }
          });

          var desktopNav = document.getElementById('desktopNavRow');
      if (desktopNav) {
        window.addEventListener('scroll', function() {
          if (window.scrollY > 120) {
            desktopNav.classList.add('is-sticky');
          } else {
            desktopNav.classList.remove('is-sticky');
          }
        });
      }

      var now = new Date();
          var options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
          var dateEl = document.getElementById('currentDate');
          if (dateEl) {
            dateEl.textContent = now.toLocaleDateString('<%= lang %>', options);
          }

          // Newsletter form (AJAX)
          var newsletterForms = document.querySelectorAll('.js-newsletter-form');
          newsletterForms.forEach(function (form) {
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              var input = form.querySelector('.js-newsletter-input');
              var msg = form.querySelector('.js-newsletter-msg');
              var btn = form.querySelector('.js-newsletter-btn');
              var email = input ? input.value.trim() : '';
              if (!email) { return; }
              if (btn) { btn.disabled = true; btn.textContent = '...'; }
              fetch('/api/newsletter/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
              })
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (msg) {
                  msg.style.display = 'block';
                  if (data.success) {
                    msg.style.color = '#4ade80';
                    msg.textContent = '<%= t('newsletter.success') %>';
                    if (input) input.value = '';
                  } else {
                    msg.style.color = '#f87171';
                    msg.textContent = '<%= t('newsletter.error') %>';
                  }
                }
                if (btn) { btn.disabled = false; btn.textContent = '<%= t('newsletter.subscribe') %>'; }
              })
              .catch(function () {
                if (msg) {
                  msg.style.display = 'block';
                  msg.style.color = '#f87171';
                  msg.textContent = '<%= t('newsletter.error') %>';
                }
                if (btn) { btn.disabled = false; btn.textContent = '<%= t('newsletter.subscribe') %>'; }
              });
            });
          });

          // Dark mode toggle
          var darkToggle = document.getElementById('darkModeToggle');
          if (darkToggle) {
            function syncDarkIcon() {
              var isDark = document.documentElement.classList.contains('dark-mode');
              darkToggle.innerHTML = isDark ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
            }
            darkToggle.addEventListener('click', function () {
              var isDark = document.documentElement.classList.toggle('dark-mode');
              try {
                localStorage.setItem('khmer-news-dark-mode', isDark ? '1' : '0');
              } catch (e) {}
              syncDarkIcon();
            });
            syncDarkIcon();
          }

          // Back to top button
          var backToTop = document.getElementById('backToTop');
          if (backToTop) {
            window.addEventListener('scroll', function () {
              if (window.scrollY > 400) {
                backToTop.classList.add('show');
              } else {
                backToTop.classList.remove('show');
              }
            });
            backToTop.addEventListener('click', function () {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });
          }
        });
      </script>
</body>

</html>