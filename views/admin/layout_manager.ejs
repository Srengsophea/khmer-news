          <button type="button" onclick="setHeroStyle('carousel')" style="background: #f1f5f9; border: 1px solid #cbd5e1; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor: pointer;"><i class="fas fa-images"></i> Carousel</button>
