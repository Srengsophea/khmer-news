    </div>

        <button type="submit" class="btn btn-primary" style="padding: 12px 32px; font-weight: 700; border-radius: 8px;">
          <i class="fas fa-floppy-disk"></i> Save Theme & Brand Settings
        </button>
        </div>

        <!-- LIVE THEME PREVIEW -->
        <div class="theme-preview-scope" style="min-width: 0;">
          <div style="position: sticky; top: 16px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(15,23,42,0.15);">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: #0f172a;">
              <span style="display: flex; gap: 5px;">
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #f87171; display: inline-block;"></span>
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #fbbf24; display: inline-block;"></span>
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #34d399; display: inline-block;"></span>
              </span>
              <span style="font-size: 0.68rem; color: #94a3b8; background: #1e293b; padding: 2px 12px; border-radius: 10px;"><i class="fas fa-lock"></i> khmer-news.local</span>
              <span style="font-size: 0.6rem; font-weight: 800; color: #fbbf24; background: rgba(251,191,36,0.15); padding: 2px 10px; border-radius: 10px; letter-spacing: 0.06em;">● LIVE PREVIEW</span>
            </div>

            <div class="pv-stage" id="pvStage" style="--pv-primary: <%= settings.primary_color || '#1e3a8a' %>; --pv-accent: <%= settings.accent_color || '#dc2626' %>; background: #f8fafc; padding: 14px;">
              <!-- Site header -->
              <div style="background: var(--pv-primary); border-radius: 8px 8px 0 0; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between;">
                <span style="color: #fff; font-weight: 800; font-size: 0.8rem; letter-spacing: 0.06em;">KH NEWS</span>
                <span style="display: flex; gap: 12px;">
                  <span style="color: rgba(255,255,255,0.85); font-size: 0.6rem;">National</span>
                  <span style="color: rgba(255,255,255,0.85); font-size: 0.6rem;">Tech</span>
                  <span style="color: rgba(255,255,255,0.85); font-size: 0.6rem;">Sports</span>
                  <span style="color: rgba(255,255,255,0.85); font-size: 0.6rem;">Culture</span>
                </span>
              </div>

              <!-- Breaking news bar -->
              <div id="pvBreaking" style="background: var(--pv-accent); color: #fff; padding: 5px 16px; font-size: 0.6rem; font-weight: 700; display: flex; gap: 8px; align-items: center;">
                <span><i class="fas fa-bolt"></i> BREAKING</span>
                <span id="pvBreakingText" style="font-weight: 500; opacity: 0.95; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Live breaking news updates</span>
