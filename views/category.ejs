<section class="editorial-category-page">
  <div class="container">
    <!-- Clean Editorial Breadcrumb & Desk Header -->
    <header class="editorial-section-banner">
      <div class="editorial-section-banner-top">
        <nav class="editorial-breadcrumb" aria-label="Breadcrumb">
          <a href="/"><%= t('nav.home') %></a>
          <span>/</span>
          <span><%= category[`name_${lang}`] %></span>
        </nav>
        <a href="/today<%= (typeof isTagPage === 'undefined' || !isTagPage) ? ('?cat=' + category.slug) : '' %>" class="editorial-live-desk-link">
          <span class="live-pulse-dot"></span>
          <%= lang === 'km' ? 'ព័ត៌មានថ្ងៃនេះក្នុងផ្នែកនេះ' : "Today's Live Dispatches" %> &rarr;
        </a>
      </div>

      <div class="editorial-section-banner-main">
        <div>
          <h1 class="editorial-page-title"><%= category[`name_${lang}`] %></h1>
        </div>
        <div class="editorial-view-controls" data-view-toggle>
          <button type="button" data-view="grid" class="editorial-view-btn active" aria-label="Columns view">
            <i class="fas fa-columns"></i> <%= lang === 'km' ? 'ទម្រង់កាសែត' : 'Newspaper' %>
          </button>
          <button type="button" data-view="list" class="editorial-view-btn" aria-label="Wire stream view">
            <i class="fas fa-bars"></i> <%= lang === 'km' ? 'ទម្រង់បញ្ជី' : 'Wire Stream' %>
          </button>
        </div>
      </div>
    </header>

    <% if (articles && articles.length > 0) { %>
      <% var leadStory = articles[0]; %>
      <% var subStories = articles.slice(1, 3); %>
      <% var restStories = articles.slice(3); %>

      <div data-articles-container>
        <!-- Top Desk Lead + 2 Secondary Columns -->
        <div class="editorial-today-lead-grid">
          <article class="editorial-today-lead-main">
            <a href="/article/<%= leadStory.slug %>" class="editorial-media-link">
              <img src="<%= leadStory.image_url %>" alt="<%= leadStory[`title_${lang}`] %>" loading="eager">
            </a>
            <div class="editorial-today-lead-body">
              <div class="editorial-meta-row">
                <span class="editorial-kicker"><%= leadStory[`category_name_${lang}`] || category[`name_${lang}`] %></span>
                <span class="editorial-meta-sep">•</span>
                <time class="editorial-time-fresh"><%= timeAgo(leadStory.created_at) %></time>
              </div>
              <h2 class="editorial-lead-headline">
                <a href="/article/<%= leadStory.slug %>"><%= leadStory[`title_${lang}`] %></a>
              </h2>
              <p class="editorial-lead-deck">
                <%= leadStory[`summary_${lang}`] ? leadStory[`summary_${lang}`] : stripHtml(leadStory[`content_${lang}`], 230) %>
              </p>
              <div class="editorial-byline">
                <span><%= leadStory.author_name || 'Khmer News Desk' %></span>
                <span>•</span>
                <span><%= leadStory.read_time_minutes || 3 %> <%= t('common.minutes_read') %></span>
                <span>•</span>
                <span><%= leadStory.views_count || 120 %> <%= t('common.views') %></span>
              </div>
            </div>
          </article>

          <% if (subStories.length > 0) { %>
            <div class="editorial-today-subleads">
              <div class="editorial-col-label">
                <%= lang === 'km' ? 'របាយការណ៍សំខាន់ៗ' : 'FEATURED DESK REPORTS' %>
              </div>
              <% subStories.forEach(function(sub) { %>
                <article class="editorial-sublead-item">
                  <a href="/article/<%= sub.slug %>" class="editorial-sublead-thumb">
                    <img src="<%= sub.image_url %>" alt="<%= sub[`title_${lang}`] %>" loading="lazy">
                  </a>
                  <div class="editorial-meta-row">
                    <span class="editorial-kicker"><%= sub[`category_name_${lang}`] || category[`name_${lang}`] %></span>
                    <span class="editorial-meta-sep">•</span>
                    <time class="editorial-time"><%= timeAgo(sub.created_at) %></time>
                  </div>
                  <h3 class="editorial-sublead-headline">
                    <a href="/article/<%= sub.slug %>"><%= sub[`title_${lang}`] %></a>
                  </h3>
                  <p class="editorial-sublead-excerpt">
                    <%= sub[`summary_${lang}`] ? sub[`summary_${lang}`] : stripHtml(sub[`content_${lang}`], 120) %>
                  </p>
                </article>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Remaining Articles in Hairline 3-Col Grid (or Stream when toggled) -->
        <% if (restStories.length > 0) { %>
          <div class="editorial-section-rule">
            <h2><%= lang === 'km' ? 'អត្ថបទចុងក្រោយបន្តបន្ទាប់' : 'Latest Desk Dispatches' %></h2>
          </div>

          <div class="editorial-hairline-grid-3" data-articles-grid>
            <% restStories.forEach(function(a) { %>
              <article class="editorial-story-unit">
                <a href="/article/<%= a.slug %>" class="editorial-media-link">
                  <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>" loading="lazy">
                </a>
                <div class="editorial-story-unit-text">
                  <div class="editorial-meta-row">
                    <span class="editorial-kicker"><%= a[`category_name_${lang}`] || category[`name_${lang}`] %></span>
                    <span class="editorial-meta-sep">•</span>
                    <time class="editorial-time"><%= timeAgo(a.created_at) %></time>
                  </div>
                  <h3 class="editorial-story-title">
                    <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
                  </h3>
                  <p class="editorial-story-excerpt">
                    <%= a[`summary_${lang}`] ? a[`summary_${lang}`] : stripHtml(a[`content_${lang}`], 135) %>
                  </p>
                  <div class="editorial-byline">
                    <span><%= a.author_name || 'Khmer News Desk' %></span>
                    <span>•</span>
                    <span><%= a.read_time_minutes || 3 %> <%= t('common.minutes_read') %></span>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Pagination -->
      <% if (pagination && pagination.totalPages > 1) { %>
        <nav class="editorial-pagination" aria-label="Pagination">
          <% var basePath = (typeof isTagPage !== 'undefined' && isTagPage) ? '/tag/' + category.slug : '/category/' + category.slug; %>
          <% if (pagination.current > 1) { %>
            <a href="<%= basePath %>?page=<%= pagination.current - 1 %>" class="page-link">&larr; <%= t('common.prev') %></a>
          <% } %>
          <% pagination.pages.forEach(function(p) { %>
            <a href="<%= basePath %>?page=<%= p %>" class="page-link <%= p === pagination.current ? 'active' : '' %>"><%= p %></a>
          <% }) %>
          <% if (pagination.current < pagination.totalPages) { %>
            <a href="<%= basePath %>?page=<%= pagination.current + 1 %>" class="page-link"><%= t('common.next') %> &rarr;</a>
          <% } %>
        </nav>
      <% } %>
    <% } else { %>
      <div class="empty-state">
        <p><i class="fas fa-newspaper"></i> <%= t('common.no_articles') %></p>
      </div>
    <% } %>

    <% if (typeof tags !== 'undefined' && tags && tags.length > 0) { %>
      <div class="editorial-topics-bar" style="margin-top: 40px;">
        <span class="editorial-topics-label"><%= t('tags.cloud_title') %>:</span>
        <div class="editorial-topic-links">
          <% tags.slice(0, 20).forEach(function(tag) { %>
            <a href="/tag/<%= tag.slug %>" class="editorial-topic-link">#<%= tag[`name_${lang}`] %></a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.querySelector('[data-view-toggle]');
    var grid = document.querySelector('[data-articles-grid]');
    if (!toggle || !grid) return;
    toggle.querySelectorAll('.editorial-view-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        toggle.querySelectorAll('.editorial-view-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        if (btn.getAttribute('data-view') === 'list') {
          grid.classList.add('is-stream-view');
        } else {
          grid.classList.remove('is-stream-view');
        }
      });
    });
  });
</script>
