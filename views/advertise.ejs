<section class="section" style="padding: 40px 0;">
  <div class="container">
    <nav class="breadcrumb" style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; color: #64748b; margin-bottom: 24px; background: #ffffff; padding: 10px 16px; border-radius: 30px; border: 1px solid #e2e8f0; width: fit-content;">
      <a href="/" style="color: var(--primary-color, #1e3a8a); font-weight: 600;"><%= t('nav.home') %></a>
      <span>&rsaquo;</span>
      <span style="color: #94a3b8;"><%= t('nav.advertise') %></span>
    </nav>

    <!-- Hero CTA banner -->
    <div style="background: linear-gradient(135deg, var(--primary-color, #1e3a8a), #0f172a); color: white; border-radius: 16px; padding: 48px 40px; margin-bottom: 32px; text-align: center; box-shadow: 0 8px 24px rgba(15,23,42,0.18);">
      <h1 style="font-size: 2.1rem; font-weight: 900; color: white; margin-bottom: 12px;"><i class="fas fa-bullhorn"></i> <%= t('advertise.title') %></h1>
      <p style="color: rgba(255,255,255,0.85); font-size: 1.05rem; max-width: 620px; margin: 0 auto;"><%= t('advertise.subtitle') %></p>
    </div>

    <div class="section-header" style="margin-bottom: 24px;">
      <h2 class="section-title" style="font-size: 1.5rem; font-weight: 800; color: #0f172a;"><%= t('advertise.why_title') %></h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 40px;">
      <div style="background: #ffffff; border-radius: 14px; padding: 24px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
        <span style="font-size: 2rem;"><i class="fas fa-users"></i></span>
        <h3 style="font-weight: 700; margin: 10px 0 6px; color: #0f172a; font-size: 1.05rem;">Massive Reach</h3>
        <p style="color: #64748b; font-size: 0.92rem; line-height: 1.6;"><%= t('advertise.why_1') %></p>
      </div>
      <div style="background: #ffffff; border-radius: 14px; padding: 24px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
        <span style="font-size: 2rem;"><i class="fas fa-bullseye"></i></span>
        <h3 style="font-weight: 700; margin: 10px 0 6px; color: #0f172a; font-size: 1.05rem;">Premium Placements</h3>
        <p style="color: #64748b; font-size: 0.92rem; line-height: 1.6;"><%= t('advertise.why_2') %></p>
      </div>
      <div style="background: #ffffff; border-radius: 14px; padding: 24px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
        <span style="font-size: 2rem;"><i class="fas fa-earth-asia"></i></span>
        <h3 style="font-weight: 700; margin: 10px 0 6px; color: #0f172a; font-size: 1.05rem;">Bilingual Audience</h3>
        <p style="color: #64748b; font-size: 0.92rem; line-height: 1.6;"><%= t('advertise.why_3') %></p>
      </div>
      <div style="background: #ffffff; border-radius: 14px; padding: 24px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
        <span style="font-size: 2rem;"><i class="fas fa-chart-simple"></i></span>
        <h3 style="font-weight: 700; margin: 10px 0 6px; color: #0f172a; font-size: 1.05rem;">Real Analytics</h3>
        <p style="color: #64748b; font-size: 0.92rem; line-height: 1.6;"><%= t('advertise.why_4') %></p>
      </div>
    </div>

    <!-- Ad positions preview -->
    <div class="section-header" style="margin-bottom: 20px;">
      <h2 class="section-title" style="font-size: 1.5rem; font-weight: 800; color: #0f172a;">Available Ad Positions</h2>
    </div>
    <div style="background: #ffffff; border-radius: 14px; padding: 28px; border: 1px solid #e2e8f0; margin-bottom: 40px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
        <div style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 18px; text-align: center; background: #f8fafc;">
          <strong style="display: block; color: #0f172a;">Header Top Banner</strong>
          <span style="font-size: 0.82rem; color: #64748b;">970×90 / 728×90</span>
        </div>
        <div style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 18px; text-align: center; background: #f8fafc;">
          <strong style="display: block; color: #0f172a;">Inline Article Ad</strong>
          <span style="font-size: 0.82rem; color: #64748b;">728×90 inside article</span>
        </div>
        <div style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 18px; text-align: center; background: #f8fafc;">
          <strong style="display: block; color: #0f172a;">Sidebar Widget</strong>
          <span style="font-size: 0.82rem; color: #64748b;">300×250 sticky</span>
        </div>
        <div style="border: 2px dashed #cbd5e1; border-radius: 10px; padding: 18px; text-align: center; background: #f8fafc;">
          <strong style="display: block; color: #0f172a;">Homepage Banner</strong>
          <span style="font-size: 0.82rem; color: #64748b;">970×120 mid / bottom</span>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div style="background: linear-gradient(135deg, var(--accent-color, #dc2626), #7f1d1d); color: white; border-radius: 16px; padding: 40px; text-align: center; box-shadow: 0 8px 24px rgba(127,29,29,0.2);">
      <h2 style="font-size: 1.6rem; font-weight: 800; color: white; margin-bottom: 10px;"><%= t('advertise.cta_title') %></h2>
      <p style="color: rgba(255,255,255,0.85); max-width: 560px; margin: 0 auto 20px;"><%= t('advertise.cta_text') %></p>
      <a href="/contact" class="btn" style="background: white; color: #7f1d1d; font-weight: 800; padding: 13px 32px; border-radius: 8px; text-decoration: none; display: inline-block;">
        <%= t('advertise.cta_btn') %> &rarr;
      </a>
    </div>
  </div>
</section>
