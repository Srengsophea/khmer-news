<div class="studio-v2">
  <!-- ==================== TOP COMMAND HEADER ==================== -->
  <header class="studio-header">
    <div>
      <span class="cms-kicker">KHMER NEWS VISUAL ARCHITECTURE ENGINE</span>
      <h1 class="studio-title">
        <i class="fas fa-sliders"></i> Layout &amp; Theme Studio 2.0
      </h1>
      <p class="studio-subtitle">
        Design your newspaper front page, category desks, and article pages visually. Every change auto-saves and updates the live blueprint on the right.
      </p>
    </div>

    <div class="studio-header-actions">
      <button type="button" id="undoBtn" onclick="undoBlockChange()" class="cms-btn cms-btn-outline" disabled title="Undo last block change">
        <i class="fas fa-rotate-left"></i> Undo
      </button>
      <button type="button" onclick="saveCurrentAsTemplate()" class="cms-btn cms-btn-outline" title="Save current arrangement as a reusable preset">
        <i class="fas fa-bookmark"></i> Save Preset
      </button>
      <a href="/" target="_blank" class="cms-btn cms-btn-outline">
        <i class="fas fa-arrow-up-right-from-square"></i> Live Site ↗
      </a>
      <button type="button" onclick="saveAllBlocks(true)" class="cms-btn cms-btn-primary">
        <i class="fas fa-floppy-disk"></i> Publish Layout Now
      </button>
    </div>
  </header>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="cms-alert cms-alert-success">
      <i class="fas fa-circle-check"></i> <%= success %>
    </div>
  <% } %>

  <!-- ==================== MAIN MODE TABS ==================== -->
  <div class="studio-mode-bar">
    <div class="studio-mode-tabs">
      <button type="button" id="tabBlocksBtn" class="studio-mode-tab active" onclick="switchTab('blocks')">
        <span class="step-num">1</span>
        <div>
          <strong>Page Structure &amp; Blocks Builder</strong>
          <span>Add, reorder, and style newspaper sections</span>
        </div>
      </button>
      <button type="button" id="tabPresetsBtn" class="studio-mode-tab" onclick="switchTab('presets')">
        <span class="step-num">2</span>
        <div>
          <strong>1-Click Newspaper Templates (<span id="presetCountBadge">8</span>)</strong>
          <span>Instant Reuters, NYT, Live Wire &amp; Custom presets</span>
        </div>
      </button>
      <button type="button" id="tabThemeBtn" class="studio-mode-tab" onclick="switchTab('theme')">
        <span class="step-num">3</span>
        <div>
          <strong>Brand Palette, Typography &amp; Ticker</strong>
          <span>Colors, width, font scale, breaking wire &amp; CSS</span>
        </div>
      </button>
    </div>

    <!-- Page Selector Pill Group -->
    <div class="studio-page-switcher" id="pageSwitcherWrap">
      <span class="switcher-label">Editing Page:</span>
      <button type="button" id="pageHomeBtn" class="page-pill active" onclick="switchPage('home')">
        <i class="fas fa-newspaper"></i> Front Page
      </button>
      <button type="button" id="pageCatBtn" class="page-pill" onclick="switchPage('category')">
        <i class="fas fa-layer-group"></i> Category Desk
      </button>
      <button type="button" id="pageArtBtn" class="page-pill" onclick="switchPage('article')">
        <i class="fas fa-file-lines"></i> Article Page
      </button>
    </div>
  </div>

  <!-- ==================== TAB 1: VISUAL BLOCKS BUILDER + LIVE BLUEPRINT ==================== -->
  <div id="blocksStudioSection" class="studio-section">
    <!-- Desk Coverage & Health Bar (Homepage Only) -->
    <div id="deskCoverageBar" class="studio-coverage-bar">
      <div class="coverage-left">
        <span class="coverage-title"><i class="fas fa-check-double"></i> Front Page Desk Coverage:</span>
        <div id="deskCoveragePills" class="coverage-pills"></div>
      </div>
      <div class="coverage-actions">
        <button type="button" onclick="toggleCollapseAll()" class="studio-mini-btn" id="collapseAllBtn">
          <i class="fas fa-compress-alt"></i> Compact View
        </button>
        <button type="button" onclick="exportLayoutJson()" class="studio-mini-btn" title="Export JSON">
          <i class="fas fa-download"></i> Export
        </button>
        <button type="button" onclick="importLayoutJson()" class="studio-mini-btn" title="Import JSON">
          <i class="fas fa-upload"></i> Import
        </button>
      </div>
    </div>

    <!-- CATEGORIZED ADD-BLOCK LIBRARY -->
    <div class="studio-library-panel">
      <div class="studio-library-head">
        <div>
          <h3><i class="fas fa-plus-circle" style="color:#dc2626"></i> Click Any Section Block Below to Add It to Your Page</h3>
          <p>Each block is 100% card-free and uses crisp newspaper hairline dividers.</p>
        </div>
        <span id="activeBlockCounter" class="studio-counter-badge">0 active blocks</span>
      </div>

      <div id="blockLibraryGrid" class="studio-library-grid">
        <!-- Populated dynamically by JS based on currentPage -->
      </div>
    </div>

    <!-- SPLIT WORKSPACE: LEFT = DRAG & DROP STACK, RIGHT = LIVE INTERACTIVE BLUEPRINT -->
    <div class="studio-workspace-grid">
      <!-- LEFT: DRAG & DROP CANVAS -->
      <div class="studio-canvas-col">
        <div class="studio-col-Subheader">
          <span><i class="fas fa-grip-vertical"></i> DRAG BLOCKS TO REORDER • CLICK VISUAL ICONS TO CHANGE LAYOUT</span>
          <span class="autosave-indicator" id="autosaveStatus"><i class="fas fa-cloud-arrow-up"></i> Auto-save active</span>
        </div>

        <div id="blocksListContainer" class="studio-blocks-stack"></div>
      </div>

      <!-- RIGHT: STICKY LIVE PAGE BLUEPRINT -->
      <aside class="studio-blueprint-col">
        <div class="studio-blueprint-card">
          <div class="blueprint-top">
            <div>
              <span class="blueprint-badge"><span class="live-pulse-dot"></span> LIVE PAGE BLUEPRINT</span>
              <h4 id="blueprintPageTitle">Front Page Architecture</h4>
            </div>
            <a href="/" target="_blank" id="blueprintOpenLink" class="studio-mini-btn">Open Page ↗</a>
          </div>
          <p class="blueprint-help">
            Click any section in this miniature map to jump directly to its settings, or use the eye icon to toggle visibility.
          </p>

          <!-- Simulated Newspaper Masthead -->
          <div class="blueprint-paper">
            <div class="bp-masthead">
              <span>KHMER NEWS</span>
              <span class="bp-live-pill">● TODAY LIVE</span>
            </div>
            <div id="blueprintStack" class="bp-stack"></div>
            <div class="bp-footer">© Khmer News Broadsheet Footer</div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- ==================== TAB 2: 1-CLICK NEWSPAPER TEMPLATES ==================== -->
  <div id="presetsStudioSection" class="studio-section" style="display: none;">
    <div class="studio-presets-panel">
      <div class="studio-presets-header">
        <div>
          <h2><i class="fas fa-wand-magic-sparkles" style="color:#dc2626"></i> One-Click Editorial Newspaper Presets</h2>
          <p>Choose a complete front-page architecture designed after world-class newsrooms, or save your own custom snapshot.</p>
        </div>
        <button type="button" onclick="saveCurrentAsTemplate()" class="cms-btn cms-btn-primary">
          <i class="fas fa-plus"></i> Save Current Layout as Custom Preset
        </button>
      </div>

      <div class="studio-presets-grid">
        <!-- Preset 1: Full Broadsheet (Recommended) -->
        <div class="preset-card is-recommended">
          <div class="preset-card-top">
            <span class="preset-badge">★ RECOMMENDED DEFAULT</span>
            <span class="preset-count">13 Sections • All 5 Desks</span>
          </div>
          <h3>Reuters / NYT Full Broadsheet</h3>
          <p>Complete newspaper edition with 3-Column Front Page Hero + Today's Live Wire, all 5 category desks, 3-Desk Comparison, Spotlight, Photojournalism strip, Top 10 &amp; Briefing.</p>
          <div class="preset-tags">
            <span>3-Col Hero + Wire</span><span>All 5 Desks</span><span>Photo Strip</span><span>3-Desk Cols</span><span>Top 10</span>
          </div>
          <button type="button" onclick="applyTemplate('broadsheet_full')" class="cms-btn cms-btn-primary" style="width:100%;justify-content:center;margin-top:12px;">
            Apply Full Broadsheet Layout
          </button>
        </div>

        <!-- Preset 2: Today Live Breaking Newsroom -->
        <div class="preset-card">
          <div class="preset-card-top">
            <span class="preset-badge is-red">● LIVE WIRE FOCUS</span>
            <span class="preset-count">10 Sections</span>
          </div>
          <h3>Today Live Breaking Newsroom</h3>
          <p>Built for high-velocity breaking news days. Places the Today's Live Wire Timeline right below the Front Page Hero, followed by National, International, and Economy desks.</p>
          <div class="preset-tags">
            <span>Hero + Wire</span><span>Live Timeline</span><span>Ticker</span><span>National</span><span>International</span>
          </div>
          <button type="button" onclick="applyTemplate('today_newsroom')" class="cms-btn cms-btn-outline" style="width:100%;justify-content:center;margin-top:12px;">
            Apply Live Newsroom Layout
          </button>
        </div>

        <!-- Preset 3: Financial Times / Markets & Economy -->
        <div class="preset-card">
          <div class="preset-card-top">
            <span class="preset-badge">BUSINESS &amp; POLICY</span>
            <span class="preset-count">10 Sections</span>
          </div>
          <h3>Markets, Economy &amp; Policy Edition</h3>
          <p>Prioritizes Economy &amp; Markets, 3-Desk Comparison Columns, Editorial Opinion &amp; Analysis, Live Metrics Strip, and National Policy coverage.</p>
          <div class="preset-tags">
            <span>Economy Lead</span><span>3-Desk Cols</span><span>Opinion Desk</span><span>Live Stats</span>
          </div>
          <button type="button" onclick="applyTemplate('economy')" class="cms-btn cms-btn-outline" style="width:100%;justify-content:center;margin-top:12px;">
            Apply Economy &amp; Policy Layout
          </button>
        </div>

        <!-- Preset 4: Executive Morning Briefing -->
        <div class="preset-card">
          <div class="preset-card-top">
            <span class="preset-badge">EXECUTIVE DIGEST</span>
            <span class="preset-count">9 Sections</span>
          </div>
          <h3>Executive Morning Briefing</h3>
          <p>Fast, high-density intelligence layout combining the 3-Column Hero, Today's Live Wire, 3-Desk Comparison, Editorial Analysis, and Top 10 Most Read.</p>
          <div class="preset-tags">
            <span>3-Col Hero</span><span>Today's Wire</span><span>Across The Desks</span><span>Opinion</span><span>Top 10</span>
          </div>
          <button type="button" onclick="applyTemplate('executive')" class="cms-btn cms-btn-outline" style="width:100%;justify-content:center;margin-top:12px;">
            Apply Executive Briefing Layout
          </button>
        </div>

        <!-- Preset 5: Visual & Photojournalism Edition -->
        <div class="preset-card">
          <div class="preset-card-top">
            <span class="preset-badge">VISUAL JOURNALISM</span>
            <span class="preset-count">10 Sections</span>
          </div>
          <h3>Photojournalism &amp; Feature Edition</h3>
          <p>Showcases large widescreen photography with the Dark Photojournalism Strip, In-Depth Spotlight, National &amp; International desks, and Sports.</p>
          <div class="preset-tags">
            <span>Hero</span><span>Photo Strip</span><span>Spotlight</span><span>National</span><span>Sports</span>
          </div>
          <button type="button" onclick="applyTemplate('visual_photo')" class="cms-btn cms-btn-outline" style="width:100%;justify-content:center;margin-top:12px;">
            Apply Photojournalism Layout
          </button>
        </div>

        <!-- Preset 6: Tech & Digital Innovation -->
        <div class="preset-card">
          <div class="preset-card-top">
            <span class="preset-badge">TECH &amp; FUTURE</span>
            <span class="preset-count">9 Sections</span>
          </div>
          <h3>Technology &amp; Innovation Digest</h3>
          <p>Highlights Technology &amp; Innovation, Economy &amp; Startups, International Tech policy, Trending Topic Hashtags, and Top 10 briefings.</p>
          <div class="preset-tags">
            <span>Hero</span><span>Tech 3-Col</span><span>Economy</span><span>Today Wire</span><span>Topics</span>
          </div>
          <button type="button" onclick="applyTemplate('tech')" class="cms-btn cms-btn-outline" style="width:100%;justify-content:center;margin-top:12px;">
            Apply Tech Digest Layout
          </button>
        </div>

        <!-- Preset 7: Classic 5-Desk Newspaper -->
        <div class="preset-card">
          <div class="preset-card-top">
            <span class="preset-badge">CLASSIC EDITION</span>
            <span class="preset-count">11 Sections</span>
          </div>
          <h3>Classic 5-Desk Broadsheet</h3>
          <p>Clean sequential presentation of all 5 editorial desks (National, International, Economy, Technology, Sports) with Top 10 Headlines and Newsletter.</p>
          <div class="preset-tags">
            <span>Hero</span><span>Ticker</span><span>All 5 Desks</span><span>Top 10</span><span>Newsletter</span>
          </div>
          <button type="button" onclick="applyTemplate('classic')" class="cms-btn cms-btn-outline" style="width:100%;justify-content:center;margin-top:12px;">
            Apply Classic 5-Desk Layout
          </button>
        </div>

        <!-- Preset 8: Compact Wire Reader -->
        <div class="preset-card">
          <div class="preset-card-top">
            <span class="preset-badge">ULTRA FAST</span>
            <span class="preset-count">6 Sections</span>
          </div>
          <h3>Minimalist Fast Wire Edition</h3>
          <p>Streamlined, ultra-fast reading experience with Front Page Hero, Today's Chronological Wire, 3-Desk Summary, and Top 10 Most Read.</p>
          <div class="preset-tags">
            <span>Hero</span><span>Today's Wire</span><span>3-Desk Cols</span><span>Top 10</span>
          </div>
          <button type="button" onclick="applyTemplate('minimal')" class="cms-btn cms-btn-outline" style="width:100%;justify-content:center;margin-top:12px;">
            Apply Fast Wire Layout
          </button>
        </div>
      </div>

      <!-- Saved Custom Presets -->
      <div class="studio-custom-presets-box">
        <div class="studio-panel-subhead">
          <h3><i class="fas fa-bookmark"></i> My Saved Custom Presets</h3>
          <span>Snapshots saved for your pages</span>
        </div>
        <div id="customTemplatesList" class="custom-presets-list"></div>
      </div>
    </div>
  </div>

  <!-- ==================== TAB 3: BRAND PALETTE, TYPOGRAPHY & TICKER ==================== -->
  <div id="themeStudioSection" class="studio-section" style="display: none;">
    <form action="/admin/layout/save" method="POST" id="themeSettingsForm">
      <div class="studio-workspace-grid">
        <div class="studio-theme-controls">
          <!-- 1. Editorial Color Palettes -->
          <div class="cms-panel">
            <div class="cms-panel-head">
              <h2><i class="fas fa-palette"></i> 1-Click Newspaper Brand Palettes</h2>
              <span class="cms-badge-live">INSTANT PREVIEW</span>
            </div>
            <div class="palette-grid">
              <button type="button" class="palette-btn" onclick="setTheme('#1e3a8a','#dc2626')">
                <span class="palette-swatches"><i style="background:#1e3a8a"></i><i style="background:#dc2626"></i></span>
                <strong>Phnom Penh Post Blue &amp; Crimson</strong>
              </button>
              <button type="button" class="palette-btn" onclick="setTheme('#0f172a','#dc2626')">
                <span class="palette-swatches"><i style="background:#0f172a"></i><i style="background:#dc2626"></i></span>
                <strong>NYT / Reuters Ink &amp; Wire Red</strong>
              </button>
              <button type="button" class="palette-btn" onclick="setTheme('#991b1b','#d97706')">
                <span class="palette-swatches"><i style="background:#991b1b"></i><i style="background:#d97706"></i></span>
                <strong>BBC / Economist Sovereign Red</strong>
              </button>
              <button type="button" class="palette-btn" onclick="setTheme('#065f46','#dc2626')">
                <span class="palette-swatches"><i style="background:#065f46"></i><i style="background:#dc2626"></i></span>
                <strong>Emerald Financial Broadsheet</strong>
              </button>
              <button type="button" class="palette-btn" onclick="setTheme('#1e293b','#0284c7')">
                <span class="palette-swatches"><i style="background:#1e293b"></i><i style="background:#0284c7"></i></span>
                <strong>Slate &amp; Bloomberg Cyan</strong>
              </button>
              <button type="button" class="palette-btn" onclick="setTheme('#312e81','#e11d48')">
                <span class="palette-swatches"><i style="background:#312e81"></i><i style="background:#e11d48"></i></span>
                <strong>Indigo &amp; Rose Dispatch</strong>
              </button>
            </div>

            <div class="cms-form-row-2" style="margin-top: 18px;">
              <div class="form-group" style="margin-bottom:0;">
                <label>Primary Editorial Ink / Masthead Color</label>
                <div style="display:flex;gap:10px;align-items:center;">
                  <input type="color" id="primaryColorPicker" name="primary_color" value="<%= settings.primary_color || '#1e3a8a' %>" style="width:48px;height:40px;padding:2px;cursor:pointer;">
                  <input type="text" id="primaryColorText" value="<%= settings.primary_color || '#1e3a8a' %>" class="form-control" readonly>
                </div>
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label>Live Wire &amp; Kicker Accent Color</label>
                <div style="display:flex;gap:10px;align-items:center;">
                  <input type="color" id="accentColorPicker" name="accent_color" value="<%= settings.accent_color || '#dc2626' %>" style="width:48px;height:40px;padding:2px;cursor:pointer;">
                  <input type="text" id="accentColorText" value="<%= settings.accent_color || '#dc2626' %>" class="form-control" readonly>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Typography, Proportions & Reading Experience -->
          <div class="cms-panel" style="margin-top: 20px;">
            <div class="cms-panel-head">
              <h2><i class="fas fa-text-height"></i> Broadsheet Width, Typography &amp; Navigation</h2>
            </div>
            <div class=" studio-3col-inputs">
              <div class="form-group">
                <label>Newspaper Container Width</label>
                <select name="content_width" class="form-control" onchange="themeChanged()">
                  <option value="normal" <%= (settings.content_width === 'normal' || !settings.content_width) ? 'selected' : '' %>>Standard Broadsheet (1200px)</option>
                  <option value="wide" <%= settings.content_width === 'wide' ? 'selected' : '' %>>Wide Newsroom (1400px)</option>
                  <option value="full" <%= settings.content_width === 'full' ? 'selected' : '' %>>Ultra-Wide Edition (1720px)</option>
                </select>
              </div>
              <div class="form-group">
                <label>Base Editorial Font Scale</label>
                <select name="font_scale" class="form-control" onchange="themeChanged()">
                  <option value="small" <%= settings.font_scale === 'small' ? 'selected' : '' %>>Compact Wire (94%)</option>
                  <option value="normal" <%= (settings.font_scale === 'normal' || !settings.font_scale) ? 'selected' : '' %>>Standard Newspaper (100%)</option>
                  <option value="large" <%= settings.font_scale === 'large' ? 'selected' : '' %>>Comfortable Large (110%)</option>
                  <option value="xlarge" <%= settings.font_scale === 'xlarge' ? 'selected' : '' %>>Executive Extra Large (120%)</option>
                </select>
              </div>
              <div class="form-group">
                <label>Photo Frame Corner Style</label>
                <select name="corner_style" class="form-control" onchange="themeChanged()">
                  <option value="sharp" <%= (settings.corner_style === 'sharp' || !settings.corner_style) ? 'selected' : '' %>>Sharp Editorial Square (2px)</option>
                  <option value="crisp" <%= settings.corner_style === 'crisp' ? 'selected' : '' %>>Crisp Subtle (6px)</option>
                  <option value="rounded" <%= settings.corner_style === 'rounded' ? 'selected' : '' %>>Soft Rounded (12px)</option>
                </select>
              </div>
            </div>

            <div class="studio-3col-inputs" style="align-items:center;">
              <div class="form-group" style="margin-bottom:0;">
                <label>Articles Per Category Page</label>
                <input type="number" name="pagination_size" min="3" max="48" value="<%= settings.pagination_size || 9 %>" class="form-control" onchange="themeChanged()">
              </div>
              <label class="cms-checkbox-label" style="padding-top:18px;">
                <input type="checkbox" name="sticky_nav" value="1" <%= (settings.sticky_nav == 1 || settings.sticky_nav === undefined) ? 'checked' : '' %> onchange="themeChanged()">
                <strong>Sticky Top Navigation Bar</strong>
              </label>
              <label class="cms-checkbox-label" style="padding-top:18px;">
                <input type="checkbox" name="show_reading_progress" value="1" <%= (settings.show_reading_progress == 1 || settings.show_reading_progress === undefined) ? 'checked' : '' %> onchange="themeChanged()">
                <strong>Article Reading Progress Bar</strong>
              </label>
            </div>
          </div>

          <!-- 3. Default Hero & Breaking News Wire -->
          <div class="cms-panel" style="margin-top: 20px;">
            <div class="cms-panel-head">
              <h2><i class="fas fa-bolt" style="color:#dc2626"></i> Global Breaking Wire &amp; Default Hero Mode</h2>
            </div>
            <div class="cms-form-row-2">
              <div class="form-group">
                <label>Default Front Page Hero Mode</label>
                <select name="hero_layout_style" id="heroStyleSelect" class="form-control" onchange="themeChanged()">
                  <option value="grid_3" <%= (settings.hero_layout_style === 'grid_3' || !settings.hero_layout_style) ? 'selected' : '' %>>3-Col Newspaper Front Page (Lead + Picks + Live Wire)</option>
                  <option value="split_2" <%= settings.hero_layout_style === 'split_2' ? 'selected' : '' %>>Dual Split Lead Stories (2 Equal Columns)</option>
                  <option value="single_hero_banner" <%= settings.hero_layout_style === 'single_hero_banner' ? 'selected' : '' %>>Single Widescreen Lead Report</option>
                </select>
              </div>
              <div class="form-group">
                <label>Ticker Animation Mode</label>
                <select name="ticker_style" id="tickerStyleSelect" class="form-control" onchange="themeChanged()">
                  <option value="marquee" <%= (settings.ticker_style === 'marquee' || !settings.ticker_style) ? 'selected' : '' %>>Continuous Live Wire Scroll</option>
                  <option value="static" <%= settings.ticker_style === 'static' ? 'selected' : '' %>>Static Editorial Strip</option>
                  <option value="slide" <%= settings.ticker_style === 'slide' ? 'selected' : '' %>>Rotating Dispatch Slide</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="cms-checkbox-label">
                <input type="checkbox" name="breaking_news_enabled" value="1" <%= (settings.breaking_news_enabled == 1 || settings.breaking_news_enabled === undefined) ? 'checked' : '' %> onchange="themeChanged()">
                <strong>Enable Global Breaking News Bar Under Navigation</strong>
              </label>
            </div>

            <div class="cms-form-row-2">
              <div class="form-group">
                <label>Breaking News Wire Text (Khmer)</label>
                <input type="text" name="breaking_news_text_km" value="<%= settings.breaking_news_text_km || '' %>" class="form-control" oninput="themeChanged()">
              </div>
              <div class="form-group">
                <label>Breaking News Wire Text (English)</label>
                <input type="text" name="breaking_news_text_en" value="<%= settings.breaking_news_text_en || '' %>" class="form-control" oninput="themeChanged()">
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
              <label>Custom Editorial CSS Overrides (Optional)</label>
              <textarea name="custom_css" rows="3" class="form-control" style="font-family:monospace;" placeholder="/* Custom CSS rules */" oninput="themeChanged()"><%= settings.custom_css || '' %></textarea>
            </div>

            <button type="submit" class="cms-btn cms-btn-primary">
              <i class="fas fa-floppy-disk"></i> Save Theme &amp; Brand Settings
            </button>
          </div>
        </div>

        <!-- Right Column: Live Theme Swatch Preview -->
        <aside class="studio-blueprint-col">
          <div class="studio-blueprint-card">
            <div class="blueprint-top">
              <div>
                <span class="blueprint-badge"><span class="live-pulse-dot"></span> LIVE THEME PREVIEW</span>
                <h4>Masthead &amp; Front Page Colors</h4>
              </div>
            </div>
            <div id="pvStage" style="--pv-primary: <%= settings.primary_color || '#1e3a8a' %>; --pv-accent: <%= settings.accent_color || '#dc2626' %>; background: #ffffff; border: 1px solid #e2e8f0; padding: 14px;">
              <div style="background: var(--pv-primary); color: #fff; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 0.9rem; letter-spacing: -0.02em;">Khmer<span style="color:#fca5a5">News</span></strong>
                <span style="font-size: 0.65rem; background: var(--pv-accent); padding: 2px 7px; font-weight: 800;">● TODAY LIVE</span>
              </div>
              <div id="pvBreaking" style="background: var(--pv-accent); color: #fff; padding: 5px 12px; font-size: 0.68rem; font-weight: 700; display: flex; gap: 6px; align-items: center;">
                <span>BREAKING:</span>
                <span id="pvBreakingText" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Live updates from Phnom Penh</span>
              </div>
              <div style="padding: 12px 0; border-bottom: 2px solid #0f172a; display: grid; grid-template-columns: 1.5fr 1fr; gap: 10px;">
                <div style="border-right: 1px solid #e2e8f0; padding-right: 10px;">
                  <div style="height: 64px; background: linear-gradient(135deg, var(--pv-primary), #0f172a); margin-bottom: 6px;"></div>
                  <span style="font-size: 0.6rem; font-weight: 800; color: var(--pv-accent);">NATIONAL DESK • 5M AGO</span>
                  <div style="font-size: 0.78rem; font-weight: 900; color: #0f172a; line-height: 1.25; margin-top: 2px;">Lead Newspaper Headline Preview</div>
                </div>
                <div>
                  <div style="font-size: 0.62rem; font-weight: 900; border-bottom: 2px solid var(--pv-accent); padding-bottom: 3px; margin-bottom: 6px; color: #0f172a;">● TODAY'S LIVE WIRE</div>
                  <div style="font-size: 0.65rem; padding: 4px 0; border-bottom: 1px solid #e2e8f0; color: #1e293b;"><strong style="color:var(--pv-accent)">4m</strong> Cambodia Infrastructure Dispatch</div>
                  <div style="font-size: 0.65rem; padding: 4px 0; border-bottom: 1px solid #e2e8f0; color: #1e293b;"><strong style="color:var(--pv-accent)">16m</strong> ASEAN Digital Trade Accord</div>
                  <div style="font-size: 0.65rem; padding: 4px 0; color: #1e293b;"><strong style="color:var(--pv-accent)">32m</strong> Kun Khmer Grand Prix Tonight</div>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </form>
  </div>
</div>

