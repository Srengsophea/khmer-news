      <div style="margin-bottom: 16px;">
        <label style="display: flex; align-items: center; gap: 10px; font-weight: 600; cursor: pointer;">
          <input type="checkbox" name="breaking_news_enabled" value="1" <%= (settings.breaking_news_enabled == 1 || settings.breaking_news_enabled === undefined) ? 'checked' : '' %> style="width: 18px; height: 18px;">
          Enable Live Breaking News Ticker Bar
        </label>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
        <div>
          <label style="display: block; font-weight: 600; margin-bottom: 6px;">Ticker Text (Khmer)</label>
