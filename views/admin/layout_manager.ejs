  function addNewBlock(type) {
    pushHistory();
    blocks.push(buildNewBlock(type));
    renderAll();
    scheduleSave();
    showToast('<i class="fas fa-plus"></i> Section added to bottom of page');
    focusBlockCard(blocks.length - 1);
  }

