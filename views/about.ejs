    font-size: 0.94rem;
    font-weight: 800;
    color: var(--ink, #0f172a);
    margin: 2px 0 4px;
  }
  .about-timeline-text {
    font-size: 0.83rem;
    line-height: 1.55;
    color: var(--ink-muted, #64748b);
    margin: 0;
  }

  /* Section 4: 5 Specialized Editorial Desks Directory */
