<section class="editorial-article-page">
  <div class="container">
    <!-- Clean Editorial Breadcrumb -->
    <nav class="editorial-breadcrumb" aria-label="Breadcrumb">
      <a href="/"><%= t('nav.home') %></a>
      <span>/</span>
      <a href="/category/<%= article.category_slug %>"><%= article[`category_name_${lang}`] %></a>
      <span>/</span>
      <span class="editorial-breadcrumb-current"><%= stripHtml(article[`title_${lang}`], 65) %></span>
    </nav>

    <div class="editorial-two-col-layout">
      <!-- MAIN ARTICLE COLUMN (No Box/Card Wrapper) -->
      <div class="editorial-article-main">
        <article class="editorial-article">
          <header class="editorial-article-header">
            <div class="editorial-meta-row">
              <a href="/category/<%= article.category_slug %>" class="editorial-kicker"><%= article[`category_name_${lang}`] %></a>
              <span class="editorial-meta-sep">•</span>
              <time class="editorial-time-fresh"><%= timeAgo(article.created_at) %></time>
              <span class="editorial-meta-sep">•</span>
              <span class="editorial-time">
                <%= new Date(article.created_at).toLocaleDateString(lang === 'km' ? 'km-KH' : 'en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
              </span>
            </div>

            <h1 class="editorial-article-headline"><%= article[`title_${lang}`] %></h1>

            <% if (article[`summary_${lang}`]) { %>
              <p class="editorial-article-standfirst"><%= article[`summary_${lang}`] %></p>
            <% } %>

            <div class="editorial-article-byline-bar">
              <div class="editorial-byline-author">
                <strong><%= article.author_name || 'Khmer News Desk' %></strong>
                <span>• Phnom Penh</span>
                <span>• <%= article.read_time_minutes || 3 %> <%= t('common.minutes_read') %></span>
                <span>• <%= article.views_count || 120 %> <%= t('common.views') %></span>
              </div>

              <div class="editorial-share-bar">
                <a href="#" target="_blank" rel="noopener" data-share="facebook" class="editorial-share-link" title="Share on Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" target="_blank" rel="noopener" data-share="telegram" class="editorial-share-link" title="Share on Telegram"><i class="fab fa-telegram-plane"></i></a>
                <a href="#" target="_blank" rel="noopener" data-share="twitter" class="editorial-share-link" title="Share on X"><i class="fab fa-x-twitter"></i></a>
                <button type="button" data-copy-link class="editorial-share-link" title="Copy Link"><i class="fas fa-link"></i></button>
                <span class="editorial-meta-sep">|</span>
                <button type="button" data-font="-1" class="editorial-share-link" title="Smaller text">A−</button>
                <button type="button" data-font="1" class="editorial-share-link" title="Larger text">A+</button>
                <button type="button" onclick="window.print()" class="editorial-share-link" title="Print"><i class="fas fa-print"></i></button>
              </div>
            </div>
          </header>

          <% if (article.image_url) { %>
            <figure class="editorial-article-figure">
              <img src="<%= article.image_url %>" alt="<%= article[`title_${lang}`] %>" class="article-hero-img">
            </figure>
          <% } %>

          <div class="editorial-article-body article-content">
            <%- article[`content_${lang}`] %>
          </div>

          <!-- Inline Ad Slot -->
          <% if (typeof getAd === 'function') { %>
            <% var inlineAd = getAd('article_inline') || getAd('inline'); %>
            <% if (inlineAd) { %>
              <div class="editorial-ad-slot">
                <span class="editorial-ad-label">ADVERTISEMENT</span>
                <% if (inlineAd.ad_type === 'html' && inlineAd.html_code) { %>
                  <%- inlineAd.html_code %>
                <% } else { %>
                  <a href="<%= inlineAd.link_url || '#' %>" target="_blank" onclick="fetch('/api/ads/click/<%= inlineAd.id %>', {method:'POST'})">
                    <img src="<%= inlineAd.image_url %>" alt="<%= inlineAd.title %>">
                  </a>
                <% } %>
              </div>
            <% } %>
          <% } %>

          <!-- Article Topics -->
          <% if (tags && tags.length > 0) { %>
            <div class="editorial-topics-bar" style="margin-top: 32px;">
              <span class="editorial-topics-label"><%= t('labels.tags') %>:</span>
              <div class="editorial-topic-links">
                <% tags.forEach(function(tag) { %>
                  <a href="/tag/<%= tag.slug %>" class="editorial-topic-link">#<%= tag[`name_${lang}`] %></a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Hairline Previous / Next Dispatch Navigation -->
          <nav class="editorial-prevnext" aria-label="Adjacent dispatches">
            <div class="editorial-prevnext-col">
              <% if (prevArticle) { %>
                <span class="editorial-prevnext-label">&larr; <%= lang === 'km' ? 'អត្ថបទមុន' : 'PREVIOUS DISPATCH' %></span>
                <a href="/article/<%= prevArticle.slug %>" class="editorial-prevnext-title"><%= prevArticle[`title_${lang}`] %></a>
              <% } %>
            </div>
            <div class="editorial-prevnext-col is-right">
              <% if (nextArticle) { %>
                <span class="editorial-prevnext-label"><%= lang === 'km' ? 'អត្ថបទបន្ទាប់' : 'NEXT DISPATCH' %> &rarr;</span>
                <a href="/article/<%= nextArticle.slug %>" class="editorial-prevnext-title"><%= nextArticle[`title_${lang}`] %></a>
              <% } %>
            </div>
          </nav>
        </article>

        <!-- Reader Discussion / Comments (Hairline Section, No Box Card) -->
        <% if (typeof articleBlocks === 'undefined' || !articleBlocks || articleBlocks.some(function(b) { return b.enabled && b.type === 'article_comments'; })) { %>
          <section id="comments" class="editorial-comments-section">
            <div class="editorial-section-rule">
              <h2><%= t('comments.title') %> (<%= comments.length %>)</h2>
            </div>

            <% if (commentSuccess) { %>
              <div class="editorial-notice is-success"><i class="fas fa-check-circle"></i> <%= t('comments.success') %></div>
            <% } else if (commentError) { %>
              <div class="editorial-notice is-error"><i class="fas fa-exclamation-circle"></i> <%= t('comments.error') %></div>
            <% } %>

            <% if (comments && comments.length > 0) { %>
              <div class="editorial-comment-list">
                <% comments.forEach(function(c) { %>
                  <div class="editorial-comment-row">
                    <div class="editorial-comment-head">
                      <strong><%= c.name %></strong>
                      <span>•</span>
                      <time><%= timeAgo(c.created_at) %></time>
                    </div>
                    <p><%= c.content %></p>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="editorial-muted-note"><%= t('comments.no_comments') %></p>
            <% } %>

            <form action="/article/<%= article.slug %>/comment" method="POST" class="editorial-comment-form">
              <h4><%= t('comments.leave') %></h4>
              <div class="editorial-form-row-2">
                <div>
                  <label><%= t('comments.name') %> *</label>
                  <input type="text" name="name" required placeholder="Sok Dara">
                </div>
                <div>
                  <label><%= t('comments.email') %> *</label>
                  <input type="email" name="email" required placeholder="you@example.com">
                </div>
              </div>
              <div class="editorial-form-field">
                <label><%= t('comments.content') %> *</label>
                <textarea name="content" rows="3" required placeholder="<%= t('comments.placeholder') %>"></textarea>
              </div>
              <div class="editorial-form-actions">
                <span class="editorial-muted-note"><%= t('comments.email_note') %></span>
                <button type="submit" class="editorial-submit-btn"><%= t('comments.submit') %></button>
              </div>
            </form>
          </section>
        <% } %>
      </div>

      <!-- RIGHT EDITORIAL RAIL (Hairline Divided, No Box Cards) -->
      <aside class="editorial-right-rail">
        <div class="editorial-rail-section">
          <div class="editorial-wire-header">
            <div class="editorial-wire-title">
              <span class="live-pulse-dot"></span>
              <span><%= t('common.today_live') %></span>
            </div>
            <a href="/today" class="editorial-wire-all-link"><%= t('common.view_all') %> &rarr;</a>
          </div>
          <p class="editorial-muted-note" style="margin-bottom: 12px;">
            <%= lang === 'km' ? 'តាមដានព័ត៌មានថ្មីៗទាន់ហេតុការណ៍ក្នុងថ្ងៃនេះ' : 'Follow real-time updates from our newsroom.' %>
          </p>
          <a href="/today" class="editorial-wire-footer-btn">
            <%= lang === 'km' ? 'ទៅកាន់ទំព័រព័ត៌មានថ្ងៃនេះ' : "Open Today's Live Wire" %> (<%= typeof todayCount !== 'undefined' ? todayCount : 48 %>) &rarr;
          </a>
        </div>

        <div class="editorial-rail-section">
          <h3 class="editorial-rail-heading"><%= lang === 'km' ? 'ព័ត៌មានពេញនិយម' : 'Most Read Today' %></h3>
          <ol class="editorial-ranked-list">
            <% if (typeof trending !== 'undefined' && trending && trending.length > 0) { %>
              <% trending.slice(0, 5).forEach(function(a, idx) { %>
                <li class="editorial-ranked-item">
                  <span class="editorial-rank-num"><%= String(idx + 1).padStart(2, '0') %></span>
                  <div class="editorial-ranked-body">
                    <% if (a.category_name_en) { %>
                      <span class="editorial-kicker"><%= a[`category_name_${lang}`] %></span>
                    <% } %>
                    <h4><a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a></h4>
                    <span class="editorial-byline-sm"><%= timeAgo(a.created_at) %></span>
                  </div>
                </li>
              <% }) %>
            <% } %>
          </ol>
        </div>

        <div class="editorial-rail-section">
          <h3 class="editorial-rail-heading"><%= t('admin.categories') %></h3>
          <ul class="editorial-desk-links">
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(function(c) { %>
                <li>
                  <a href="/category/<%= c.slug %>">
                    <span><%= c[`name_${lang}`] %></span>
                    <span>&rarr;</span>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </div>
      </aside>
    </div>

    <!-- RELATED DISPATCHES (Hairline 4-Column Row) -->
    <% if (articles && articles.length > 0) { %>
      <section class="editorial-related-section">
        <div class="editorial-section-rule">
          <h2><%= lang === 'km' ? 'អត្ថបទពាក់ព័ន្ធ' : 'More Coverage From This Desk' %></h2>
          <a href="/category/<%= article.category_slug %>" class="editorial-section-more"><%= t('common.view_all') %> &rarr;</a>
        </div>
        <div class="editorial-hairline-grid-4">
          <% articles.slice(0, 4).forEach(function(a) { %>
            <article class="editorial-story-unit">
              <a href="/article/<%= a.slug %>" class="editorial-media-link">
                <img src="<%= a.image_url %>" alt="<%= a[`title_${lang}`] %>" loading="lazy">
              </a>
              <div class="editorial-meta-row">
                <span class="editorial-kicker"><%= a[`category_name_${lang}`] %></span>
                <span class="editorial-meta-sep">•</span>
                <time class="editorial-time"><%= timeAgo(a.created_at) %></time>
              </div>
              <h3 class="editorial-story-title">
                <a href="/article/<%= a.slug %>"><%= a[`title_${lang}`] %></a>
              </h3>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
  </div>
</section>

<script>
  window.addEventListener('scroll', function () {
    var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    var scrolled = height > 0 ? (winScroll / height) * 100 : 0;
    var bar = document.getElementById('readingProgress');
    if (bar) bar.style.width = scrolled + '%';
  });

  document.addEventListener('DOMContentLoaded', function () {
    var pageUrl = encodeURIComponent(window.location.href);
    var pageTitle = encodeURIComponent(document.title);
    var shareMap = {
      facebook: 'https://www.facebook.com/sharer/sharer.php?u=' + pageUrl,
      telegram: 'https://t.me/share/url?url=' + pageUrl + '&text=' + pageTitle,
      twitter: 'https://twitter.com/intent/tweet?url=' + pageUrl + '&text=' + pageTitle
    };
    document.querySelectorAll('[data-share]').forEach(function (el) {
      var key = el.getAttribute('data-share');
      if (shareMap[key]) el.setAttribute('href', shareMap[key]);
    });
    document.querySelectorAll('[data-copy-link]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          btn.innerHTML = '<i class="fas fa-check"></i>';
          setTimeout(function () { btn.innerHTML = '<i class="fas fa-link"></i>'; }, 2000);
        });
      });
    });
    var content = document.querySelector('.article-content');
    var fontLevel = 0;
    document.querySelectorAll('[data-font]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!content) return;
        var dir = parseInt(btn.getAttribute('data-font'), 10);
        fontLevel = Math.max(-2, Math.min(3, fontLevel + dir));
        content.style.fontSize = (1.12 + fontLevel * 0.08) + 'rem';
      });
    });
  });
</script>
